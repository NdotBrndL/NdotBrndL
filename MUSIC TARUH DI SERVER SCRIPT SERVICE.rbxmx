				<ProtectedString name="Source"><![CDATA[local print = function() end
local warn = function() end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterPlayer = game:GetService("StarterPlayer")
local StarterGui = game:GetService("StarterGui")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local TestService = game:GetService("TestService")

local BUILD = "2.0.0-clean"

local singleton = ServerScriptService:FindFirstChild("CaaMusicRuntime")
if singleton then
	return
end
singleton = Instance.new("Folder")
singleton.Name = "CaaMusicRuntime"
singleton.Archivable = false
singleton.Parent = ServerScriptService

local function findPackageRoot()
	local cursor = script
	while cursor and cursor ~= game do
		if cursor:FindFirstChild("ReplicatedStorage") and cursor:FindFirstChild("ServerStorage") then
			return cursor
		end
		cursor = cursor.Parent
	end
	return nil
end

local function cloneIfMissing(source, parent, name)
	if not source or not parent then return nil end
	name = name or source.Name
	local existing = parent:FindFirstChild(name)
	if existing then return existing end
	local clone = source:Clone()
	clone.Name = name
	clone.Parent = parent
	return clone
end

local root = findPackageRoot()
local mode = root and "PACKAGE" or "INSTALLED"

if root then
	local serviceMap = {
		ReplicatedStorage = ReplicatedStorage,
		ServerStorage = ServerStorage,
		SoundService = SoundService,
		Workspace = Workspace,
	}
	for sourceName, target in pairs(serviceMap) do
		local sourceFolder = root:FindFirstChild(sourceName)
		if sourceFolder then
			for _, item in ipairs(sourceFolder:GetChildren()) do
				cloneIfMissing(item, target)
			end
		end
	end

	local liveStarterScripts = StarterPlayer:WaitForChild("StarterPlayerScripts")
	local starterScriptsSource = root:FindFirstChild("StarterPlayerScripts")
	if starterScriptsSource then
		for _, item in ipairs(starterScriptsSource:GetChildren()) do
			if item.Name ~= "CaaMusicClient" then
				cloneIfMissing(item, liveStarterScripts)
			end
		end
	end

	local starterGuiSource = root:FindFirstChild("StarterGui")
	if starterGuiSource then
		for _, item in ipairs(starterGuiSource:GetChildren()) do
			cloneIfMissing(item, StarterGui)
		end
	end
end

local liveStarterScripts = StarterPlayer:WaitForChild("StarterPlayerScripts")
local legacyClient = liveStarterScripts:FindFirstChild("CaaMusicClient")
if legacyClient then legacyClient:Destroy() end

local obsoleteRuntime = ReplicatedStorage:FindFirstChild("CaaMusicRuntime")
if obsoleteRuntime then obsoleteRuntime:Destroy() end

local required = {
	ReplicatedStorage:FindFirstChild("CaaMusicRS"),
	ReplicatedStorage:FindFirstChild("TopbarPlus"),
	ServerStorage:FindFirstChild("CaaMusicSS"),
	SoundService:FindFirstChild("CaaMusicSystem"),
	liveStarterScripts:FindFirstChild("CaaMusicTopBar"),
	StarterGui:FindFirstChild("CaaMusicPlayerGui"),
	StarterGui:FindFirstChild("CaaVoteGui"),
}
for _, object in ipairs(required) do
	if not object then
		singleton:Destroy()
		return
	end
end

local clientTemplates = {
	liveStarterScripts:FindFirstChild("CaaMusicTopBar"),
}

local function deployClientScripts(player)
	if not player or player.Parent ~= Players then return end
	local playerScripts = player:FindFirstChild("PlayerScripts") or player:WaitForChild("PlayerScripts", 30)
	if not playerScripts then return end
	for _, template in ipairs(clientTemplates) do
		if template and template:IsA("LocalScript") and not playerScripts:FindFirstChild(template.Name) then
			local clone = template:Clone()
			clone.Parent = playerScripts
		end
	end
end

local guiTemplates = {}
for _, name in ipairs({"CaaMusicPlayerGui", "CaaVoteGui"}) do
	local template = StarterGui:FindFirstChild(name)
	if template and template:IsA("ScreenGui") then
		template.ResetOnSpawn = false
		guiTemplates[name] = template
	end
end

local function dedupeNamedGui(playerGui, name)
	local kept = nil
	for _, child in ipairs(playerGui:GetChildren()) do
		if child.Name == name and child:IsA("ScreenGui") then
			if kept then
				child:Destroy()
			else
				kept = child
			end
		end
	end
	return kept
end

local function deployGui(player)
	if not player or player.Parent ~= Players then return end
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 30)
	if not playerGui then return end
	for name, template in pairs(guiTemplates) do
		local existing = dedupeNamedGui(playerGui, name)
		if existing then
			existing.ResetOnSpawn = false
			existing.Enabled = true
		else
			local clone = template:Clone()
			clone.ResetOnSpawn = false
			clone.Enabled = true
			clone.Parent = playerGui
		end
	end
end

local function preparePlayer(player)
	task.spawn(deployClientScripts, player)
	task.spawn(deployGui, player)
end

local function watchGuiDuplicates(player)
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 30)
	if not playerGui then return end
	playerGui.ChildAdded:Connect(function(child)
		if guiTemplates[child.Name] and child:IsA("ScreenGui") then
			task.defer(function()
				if child.Parent == playerGui then
					dedupeNamedGui(playerGui, child.Name)
				end
			end)
		end
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	preparePlayer(player)
	task.spawn(watchGuiDuplicates, player)
end
Players.PlayerAdded:Connect(function(player)
	preparePlayer(player)
	task.spawn(watchGuiDuplicates, player)
end)

local mainFolder = ServerStorage:FindFirstChild("CaaMusicSS")
local mainModule = mainFolder and mainFolder:FindFirstChild("CaaMusicMain")
if not mainModule or not mainModule:IsA("ModuleScript") then
	singleton:Destroy()
	return
end

local loaded, mainApi = pcall(require, mainModule)
if not loaded or type(mainApi) ~= "table" or type(mainApi.Start) ~= "function" then
	singleton:Destroy()
	return
end

local started, runtimeState = pcall(function()
	return mainApi:Start({mode = mode, build = BUILD})
end)

if not started or type(runtimeState) ~= "table" or runtimeState.active ~= true then
	singleton:Destroy()
	return
end]]></ProtectedString>
