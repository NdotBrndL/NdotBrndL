do
	local okSys, sysLibrary = pcall(function()
		return require(script:WaitForChild("CaaSystemLibrary")).new({
			libraryView = libraryView,
			library = library,
			isCollectionFavorite = isCollectionFavorite,
			state = state,
			fire = fire,
			trackId = trackId,
			trackName = trackName,
			trackCollection = trackCollection,
			trackImage = trackImage,
