						<ProtectedString name="Source"><![CDATA[-- local print = function() end
-- local warn = function() end





local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

-- posisi pointer dalam koordinat panel (diisi Caa3DTilt saat panel dirender di bidang 3D)
local function ptOf(input)
	local f = rawget(_G, "CaaMusicPt")
	if f then
		local ok, v = pcall(f, input)
		if ok and typeof(v) == "Vector2" then return v end
	end
	return Vector2.new(input.Position.X, input.Position.Y)
end

local player = Players.LocalPlayer
local playerGui = player and player:WaitForChild("PlayerGui", 20)
local gui = script.Parent
if not player or not gui:IsA("ScreenGui") then
	return
end

-- ANTI-DUPLICATE: StarterGui otomatis nge-clone GUI ini ke PlayerGui SAAT
-- YANG SAMA kayak CaaMusicRuntime (server) manual nge-clone-nya juga --
-- jadi buat sesaat bisa ada 2 salinan CaaMusicPlayerGui hidup bareng, dan
-- 2-duanya rebutan _G.CaaMusicPlayerToggle. Kalau yang "menang" itu
-- kebetulan yang belakangan di-Destroy sama dedupe server, topbar jadi
-- nunjuk ke GUI yang udah mati -> gui "kadang gak bisa dibuka" tanpa error.
--
-- Solusinya: tunggu sebentar biar semua salinan (auto-clone + manual clone)
-- udah kebentuk semua, lalu VOTE siapa yang menang secara deterministik.
-- Yang kalah langsung nonaktifin diri & Destroy SEBELUM sempat nyentuh _G
-- sama sekali -- jadi cuma SATU instance yang pernah register ke _G.
do
	local HttpService = game:GetService("HttpService")
	if not gui:GetAttribute("CaaGuiId") then
		gui:SetAttribute("CaaGuiId", HttpService:GenerateGUID(false))
	end

	local function isElectionWinner()
		local candidates = {}
		for _, sibling in ipairs(playerGui:GetChildren()) do
			if sibling.Name == gui.Name and sibling:IsA("ScreenGui") then
				table.insert(candidates, sibling)
			end
		end
		if #candidates <= 1 then return true end
		table.sort(candidates, function(a, b)
			local idA = a:GetAttribute("CaaGuiId") or ""
			local idB = b:GetAttribute("CaaGuiId") or ""
			return idA < idB
		end)
		return candidates[1] == gui
	end

	task.wait(0.5) -- biarin semua duplikat kebentuk dulu sebelum voting

	local won = isElectionWinner()
	print("[CaaMusicGUI Election]", gui:GetAttribute("CaaGuiId"), "won =", won)

	if not won then
		gui.Enabled = false
		gui:Destroy()
		return
	end
end

local function child(parent, name)
	local value = parent and parent:FindFirstChild(name)
	if not value then
		error("[CAA MUSIC GUI] Missing UI object: " .. tostring(name), 2)
	end
	return value
end

local main = child(gui, "MainFrame")
local overlay = child(gui, "Overlay")
local header = child(main, "Header")
local tabContainer = child(header, "TabContainer")
local homeTab = child(tabContainer, "HomeTab")
local libraryTab = child(tabContainer, "LibraryTab")
local djTab = child(tabContainer, "DJTab")
local closeButton = child(header, "CloseButton")
local slideIndicator = tabContainer:FindFirstChild("SlideIndicator")
local content = child(main, "Content")
local homeView = child(content, "HomeView")
local libraryView = child(content, "LibraryView")
local djView = child(content, "DJView")
local uiScale = main:FindFirstChildOfClass("UIScale")

local state = {
	packet = {},
	catalog = {},
	collections = {},
	favorites = {},
	selectedCollection = nil,
	localVolume = 1,
	lastVolume = 1,
	muted = false,
	globalMusicVolume = 0.5,
	writingLocalMusicVolume = false,
	isDJ = false,
	drag = nil,
	baseScale = (uiScale and uiScale:GetAttribute("TargetScale")) or 0.69,
	panelOpen = false,
	favoriteBusy = {},
	favoritePending = {},
	suppressQueueUntil = 0,
	suppressCollectionOpenUntil = 0,
	votePacket = nil,
	dismissedVoteId = nil,
	pendingNoticeTrack = nil,
	lastNoticeSignature = nil,
	lastNoticeAt = 0,
	lastNotifiedTrackId = nil,
}

gui.Enabled = true
main.Visible = false
overlay.Visible = false
overlay.Active = false
gui:SetAttribute("PanelOpen", false)

local function setPanelOpen(open)
	open = open == true
	if state.panelOpen == open and main.Visible == open then return open end
	state.panelOpen = open
	gui:SetAttribute("PanelOpen", open)

	if open then
		gui.Enabled = true
		main.Visible = true
		overlay.Visible = true
		main.Active = true
		overlay.Active = true
		if uiScale then
			uiScale.Scale = state.baseScale * 0.96
			TweenService:Create(uiScale, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Scale = state.baseScale,
			}):Play()
		end
		overlay.BackgroundTransparency = 1
		TweenService:Create(overlay, TweenInfo.new(0.14), {BackgroundTransparency = 0.5}):Play()
	else
		main.Active = false
		main.Visible = false
		overlay.Visible = false
		overlay.Active = false
	end
	return open
end

rawset(_G, "CaaMusicPlayerToggle", function(force)
	local open = type(force) == "boolean" and force or not state.panelOpen
	return setPanelOpen(open)
end)
gui:SetAttribute("CaaMusicReady", true)

local rsFolder = ReplicatedStorage:WaitForChild("CaaMusicRS", 20)
if not rsFolder then

	return
end
local remotes = rsFolder:WaitForChild("CaaRemotes", 20)
if not remotes then

	return
end
local commandRemote = remotes:WaitForChild("CaaDJ_Command", 20)
local preloadRemote = remotes:WaitForChild("CaaDJ_Preload", 20)
local requestStateRemote = remotes:WaitForChild("CaaDJ_RequestState", 20)
local stateRemote = remotes:WaitForChild("CaaDJ_State", 20)
local voteRemote = remotes:WaitForChild("CaaDJ_VoteState", 20)
if not (commandRemote and preloadRemote and requestStateRemote and stateRemote and voteRemote) then

	return
end

local musicSound = SoundService:WaitForChild("CaaMusicSystem", 20)
if musicSound then
	state.globalMusicVolume = musicSound.Volume
end



local localVolumeGroup = SoundService:FindFirstChild("CaaMusicClientVolume")
if localVolumeGroup and not localVolumeGroup:IsA("SoundGroup") then
	localVolumeGroup:Destroy()
	localVolumeGroup = nil
end
if not localVolumeGroup then
	localVolumeGroup = Instance.new("SoundGroup")
	localVolumeGroup.Name = "CaaMusicClientVolume"
	localVolumeGroup.Archivable = false
	localVolumeGroup.Volume = 1
	localVolumeGroup.Parent = SoundService
end
if musicSound then musicSound.SoundGroup = localVolumeGroup end

local connections = {}
local function connect(signal, callback)
	local c = signal:Connect(callback)
	table.insert(connections, c)
	return c
end




if musicSound then
	connect(musicSound:GetPropertyChangedSignal("Volume"), function()
		if state.writingLocalMusicVolume then return end

		local incoming = tonumber(musicSound.Volume) or 0
		if state.muted then
			if incoming > 0.0001 then
				state.globalMusicVolume = incoming
			end
			if incoming ~= 0 then
				state.writingLocalMusicVolume = true
				musicSound.Volume = 0
				state.writingLocalMusicVolume = false
			end
		else
			state.globalMusicVolume = incoming
		end
	end)

	connect(musicSound:GetPropertyChangedSignal("SoundGroup"), function()
		if musicSound.SoundGroup == localVolumeGroup then return end
		task.defer(function()
			if musicSound and musicSound.Parent then
				musicSound.SoundGroup = localVolumeGroup
			end
		end)
	end)
end

local IFEACFSEFIEFB = {
	TouchTapSlop = 10,
	TouchTapWindow = 0.48,
	Notice = {
		SidebarWidth = 332,
		SidebarHeight = 430,
		EdgePadding = 18,
		Gap = 10,
		Corner = 22,
		Stroke = 2.2,
		Height = 94,
		HeightLike = 106,
		HeightNowPlaying = 114,
		Cover = 62,
		ProgressHeight = 6,
		ProgressBottom = 12,
		TitleSize = 20,
		MessageSize = 23,
		MessageSizeDefault = 20,
	},
	Hover = {
		LayerTransparency = 0.92,
		ButtonDelta = 0.025,
		PoolTransparency = 0.93,
		TweenIn = 0.18,
		TweenOut = 0.20,
		PressScale = 0.996,
		PressIn = 0.08,
		PressOut = 0.12,
	},
}

local __uiRandom = Random.new(math.floor(os.clock() * 1000000) % 2147483647)
local function randomUiName(prefix, length)
	local chars = table.create(length or 12)
	for index = 1, (length or 12) do
		chars[index] = string.char(__uiRandom:NextInteger(65, 90))
	end
	return tostring(prefix or "") .. table.concat(chars)
end




local transientInputCancelers = {}
local scrollingRecoverySerial = 0
local activeTouches = setmetatable({}, {__mode = "k"})
local multiTouchRecoveryArmed = false

local function registerTransientInputCancel(callback)
	if type(callback) == "function" then
		table.insert(transientInputCancelers, callback)
	end
end

local function cancelTransientInput()
	for _, callback in ipairs(transientInputCancelers) do
		pcall(callback)
	end
	for _, object in ipairs(gui:GetDescendants()) do
		if object:IsA("UIScale") and object.Name == "CaaPressScale" then
			object.Scale = 1
		end
	end
end

local function configureScrollingFrame(object)
	if not object or not object:IsA("ScrollingFrame") then return end
	object.ScrollBarThickness = 0
	object.Active = true
	object.ScrollingEnabled = true
end

local function configureAllScrollingFrames()
	for _, object in ipairs(gui:GetDescendants()) do
		if object:IsA("ScrollingFrame") then
			configureScrollingFrame(object)
		end
	end
end

local function recoverScrollingFrames()
	scrollingRecoverySerial += 1
	local serial = scrollingRecoverySerial
	cancelTransientInput()
	state.suppressCollectionOpenUntil = 0
	state.suppressQueueUntil = 0

	local snapshots = {}
	for _, object in ipairs(gui:GetDescendants()) do
		if object:IsA("ScrollingFrame") then
			snapshots[#snapshots + 1] = {
				object = object,
				canvasPosition = object.CanvasPosition,
			}
			object.ScrollBarThickness = 0
			object.Active = true
			object.ScrollingEnabled = false
		end
	end

	task.defer(function()
		if serial ~= scrollingRecoverySerial then return end
		for _, snapshot in ipairs(snapshots) do
			local object = snapshot.object
			if object and object.Parent then
				object.Active = true
				object.ScrollBarThickness = 0
				object.ScrollingEnabled = true
				object.CanvasPosition = snapshot.canvasPosition
			end
		end
	end)
end

configureAllScrollingFrames()
connect(gui.DescendantAdded, function(object)
	if object:IsA("ScrollingFrame") then
		task.defer(function()
			if object.Parent then configureScrollingFrame(object) end
		end)
	end
end)
connect(UserInputService.WindowFocusReleased, recoverScrollingFrames)
connect(UserInputService.WindowFocused, recoverScrollingFrames)



connect(UserInputService.InputBegan, function(input)
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	activeTouches[input] = true
	local touchCount = 0
	for _ in pairs(activeTouches) do touchCount += 1 end
	if touchCount >= 3 and not multiTouchRecoveryArmed then
		multiTouchRecoveryArmed = true
		cancelTransientInput()
		task.delay(0.12, recoverScrollingFrames)
		task.delay(0.55, function()
			activeTouches = setmetatable({}, {__mode = "k"})
			multiTouchRecoveryArmed = false
			recoverScrollingFrames()
		end)
	end
end)
connect(UserInputService.InputEnded, function(input)
	if input.UserInputType ~= Enum.UserInputType.Touch then return end
	activeTouches[input] = nil
	if multiTouchRecoveryArmed and next(activeTouches) == nil then
		multiTouchRecoveryArmed = false
		task.defer(recoverScrollingFrames)
	end
end)

local function findAncestorScrollingFrame(object)
	local cursor = object and object.Parent
	while cursor and cursor ~= gui do
		if cursor:IsA("ScrollingFrame") then
			return cursor
		end
		cursor = cursor.Parent
	end
	return nil
end

local function bindResponsiveActivate(button, callback)
	if not button or not button:IsA("GuiButton") or type(callback) ~= "function" then return end
	local lastFire = 0
	local activeInput = nil
	local positionConnection = nil
	local stateConnection = nil
	local startPos = nil
	local startCanvas = nil
	local startedAt = 0
	local moved = false
	local scrollFrame = nil

	local function disconnectTouchConnections()
		if positionConnection then
			positionConnection:Disconnect()
			positionConnection = nil
		end
		if stateConnection then
			stateConnection:Disconnect()
			stateConnection = nil
		end
	end

	local function clearTouchState()
		disconnectTouchConnections()
		activeInput = nil
		startPos = nil
		startCanvas = nil
		startedAt = 0
		moved = false
		scrollFrame = nil
	end

	registerTransientInputCancel(clearTouchState)

	local function invoke()
		local now = os.clock()
		if now - lastFire < 0.18 then return end
		lastFire = now
		callback()
	end




	connect(button.Activated, function()
		if UserInputService:GetLastInputType() == Enum.UserInputType.Touch then
			return
		end
		invoke()
	end)

	connect(button.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then return end
		clearTouchState()
		activeInput = input
		startPos = Vector2.new(input.Position.X, input.Position.Y)
		startedAt = os.clock()
		scrollFrame = findAncestorScrollingFrame(button)
		startCanvas = scrollFrame and scrollFrame.CanvasPosition or nil

		positionConnection = input:GetPropertyChangedSignal("Position"):Connect(function()
			if input ~= activeInput or not startPos then return end
			local current = Vector2.new(input.Position.X, input.Position.Y)
			if (current - startPos).Magnitude > IFEACFSEFIEFB.TouchTapSlop then
				moved = true
			end
			if scrollFrame and startCanvas and (scrollFrame.CanvasPosition - startCanvas).Magnitude > 1.25 then
				moved = true
			end
		end)

		stateConnection = input:GetPropertyChangedSignal("UserInputState"):Connect(function()
			if input ~= activeInput then return end
			local inputState = input.UserInputState
			if inputState ~= Enum.UserInputState.End and inputState ~= Enum.UserInputState.Cancel then
				return
			end

			local elapsed = os.clock() - startedAt
			local current = Vector2.new(input.Position.X, input.Position.Y)
			local pointerMoved = startPos and (current - startPos).Magnitude > IFEACFSEFIEFB.TouchTapSlop
			local canvasMoved = scrollFrame and startCanvas and (scrollFrame.CanvasPosition - startCanvas).Magnitude > 1.25
			local shouldInvoke = inputState == Enum.UserInputState.End
				and not moved
				and not pointerMoved
				and not canvasMoved
				and elapsed <= IFEACFSEFIEFB.TouchTapWindow
				and not multiTouchRecoveryArmed

			clearTouchState()
			if shouldInvoke then
				invoke()
			end
		end)
	end)
end

local interactiveBound = setmetatable({}, {__mode = "k"})
local hoverLayerOwners = setmetatable({}, {__mode = "k"})
local activeHoverReset = nil
local lastInputType = UserInputService:GetLastInputType()

local function isMouseLikeInput(inputType)
	return inputType == Enum.UserInputType.MouseMovement
		or inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseWheel
end

local function clearActiveHover()
	local reset = activeHoverReset
	activeHoverReset = nil
	if reset then pcall(reset) end
end

connect(UserInputService.LastInputTypeChanged, function(inputType)
	lastInputType = inputType
	if not isMouseLikeInput(inputType) then
		clearActiveHover()
		cancelTransientInput()
	end
end)

local function findHoverLayer(button)
	local direct = button:FindFirstChild("Hover")
	if direct and direct:IsA("GuiObject") then return direct end
	local cover = button:FindFirstChild("Cover")
	if cover then
		local nested = cover:FindFirstChild("Hover")
		if nested and nested:IsA("GuiObject") then return nested end
	end
	local nested = button:FindFirstChild("Hover", true)
	if nested and nested:IsA("GuiObject") then return nested end
	return nil
end

local function bindInteractive(button)
	if not button or not button:IsA("GuiButton") or interactiveBound[button] then return end
	interactiveBound[button] = true
	button.AutoButtonColor = false

	local hoverLayer = findHoverLayer(button)
	if hoverLayer and not hoverLayerOwners[hoverLayer] then
		hoverLayerOwners[hoverLayer] = button
	end
	local hoverBase = hoverLayer and hoverLayer.BackgroundTransparency or nil
	local buttonBase = button.BackgroundTransparency
	local parentScroll = findAncestorScrollingFrame(button)
	local pressScale = button:FindFirstChild("CaaPressScale")
	if not pressScale then
		pressScale = Instance.new("UIScale")
		pressScale.Name = "CaaPressScale"
		pressScale.Scale = 1
		pressScale.Parent = button
	end

	local hovering = false
	local pressing = false
	local function renderHover()
		if hoverLayer then
			local target = hovering and IFEACFSEFIEFB.Hover.LayerTransparency or (hoverBase or 1)
			TweenService:Create(hoverLayer, TweenInfo.new(hovering and IFEACFSEFIEFB.Hover.TweenIn or IFEACFSEFIEFB.Hover.TweenOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = target,
			}):Play()
		elseif buttonBase < 0.98 then
			local target = hovering and math.max(0, buttonBase - IFEACFSEFIEFB.Hover.ButtonDelta) or buttonBase
			TweenService:Create(button, TweenInfo.new(hovering and IFEACFSEFIEFB.Hover.TweenIn or IFEACFSEFIEFB.Hover.TweenOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = target,
			}):Play()
		elseif button.Name == "PoolRow" then
			local fill = button:FindFirstChild("CaaHoverFill")
			if not fill then
				fill = Instance.new("Frame")
				fill.Name = "CaaHoverFill"
				fill.Size = UDim2.fromScale(1, 1)
				fill.BackgroundColor3 = Color3.fromRGB(51, 51, 51)
				fill.BackgroundTransparency = 1
				fill.BorderSizePixel = 0
				fill.ZIndex = math.max(0, button.ZIndex - 1)
				fill.Parent = button
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(0, 6)
				corner.Parent = fill
			end
			TweenService:Create(fill, TweenInfo.new(hovering and IFEACFSEFIEFB.Hover.TweenIn or IFEACFSEFIEFB.Hover.TweenOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = hovering and IFEACFSEFIEFB.Hover.PoolTransparency or 1,
			}):Play()
		end
	end

	local function resetVisual()
		hovering = false
		pressing = false
		renderHover()
		pressScale.Scale = 1
		if activeHoverReset == resetVisual then
			activeHoverReset = nil
		end
	end
	registerTransientInputCancel(resetVisual)

	connect(button.MouseEnter, function()
		if not isMouseLikeInput(lastInputType) then
			resetVisual()
			return
		end
		if activeHoverReset and activeHoverReset ~= resetVisual then
			clearActiveHover()
		end
		hovering = true
		activeHoverReset = resetVisual
		renderHover()
	end)
	connect(button.MouseLeave, resetVisual)
	connect(button.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonA then
			if input.UserInputType == Enum.UserInputType.Touch then
				clearActiveHover()
				if parentScroll then
					pressScale.Scale = 1
					return
				end
			end
			pressing = true
			TweenService:Create(pressScale, TweenInfo.new(IFEACFSEFIEFB.Hover.PressIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Scale = IFEACFSEFIEFB.Hover.PressScale,
			}):Play()
		end
	end)
	connect(button.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonA then
			pressing = false
			TweenService:Create(pressScale, TweenInfo.new(IFEACFSEFIEFB.Hover.PressOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Scale = 1,
			}):Play()
		end
	end)
end

local function bindHoverSurface(surface)
	if not surface or not surface:IsA("GuiObject") or interactiveBound[surface] then return end
	local hoverLayer = findHoverLayer(surface)
	if not hoverLayer then return end
	local cursor = surface.Parent
	while cursor and cursor ~= gui do
		if cursor:IsA("GuiButton") and findHoverLayer(cursor) == hoverLayer then
			return
		end
		cursor = cursor.Parent
	end
	if hoverLayerOwners[hoverLayer] then return end
	interactiveBound[surface] = true
	hoverLayerOwners[hoverLayer] = surface
	surface.Active = true
	local base = hoverLayer.BackgroundTransparency

	local function resetSurfaceHover()
		TweenService:Create(hoverLayer, TweenInfo.new(IFEACFSEFIEFB.Hover.TweenOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = base,
		}):Play()
		if activeHoverReset == resetSurfaceHover then
			activeHoverReset = nil
		end
	end
	registerTransientInputCancel(resetSurfaceHover)

	connect(surface.MouseEnter, function()
		if not isMouseLikeInput(lastInputType) then
			resetSurfaceHover()
			return
		end
		if activeHoverReset and activeHoverReset ~= resetSurfaceHover then
			clearActiveHover()
		end
		activeHoverReset = resetSurfaceHover
		TweenService:Create(hoverLayer, TweenInfo.new(IFEACFSEFIEFB.Hover.TweenIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = IFEACFSEFIEFB.Hover.LayerTransparency,
		}):Play()
	end)
	connect(surface.MouseLeave, resetSurfaceHover)
end

local function lower(value)
	return string.lower(tostring(value or ""))
end

local function first(value, keys, default)
	if type(value) ~= "table" then return default end
	for _, key in ipairs(keys) do
		if value[key] ~= nil then return value[key] end
	end
	return default
end

local function asset(value)
	if value == nil then return "" end
	local text = tostring(value)
	local id = text:match("(%d+)")
	return id and ("rbxassetid://" .. id) or ""
end

local function trackId(track)
	return tostring(first(track, {"id", "soundId", "SoundId"}, "")):match("(%d+)") or ""
end

local function trackName(track)
	return tostring(first(track, {"name", "title", "SongName"}, "Unknown Track"))
end

local function trackCollection(track)
	local value = first(track, {"collection", "Collection", "col"}, "All Tracks")
	if value == nil or tostring(value) == "" then return "All Tracks" end
	return tostring(value)
end

local function trackImage(track)
	return asset(first(track, {"ImageId", "imageId", "image"}, ""))
end

local function escapeRichText(value)
	local text = tostring(value or "")
	text = text:gsub("&", "&amp;")
	text = text:gsub("<", "&lt;")
	text = text:gsub(">", "&gt;")
	text = text:gsub('"', "&quot;")
	return text
end

local function requesterIsDJ(track)
	return first(track, {"requesterIsDJ", "RequesterIsDJ", "isRequesterDJ", "IsRequesterDJ"}, false) == true
end

local function requesterDisplay(track)
	local name = escapeRichText(first(track, {"requesterName", "requester", "requestedBy"}, "AutoPlay"))
	if requesterIsDJ(track) then
		return '<font color="#E73543">DJ</font>  ' .. name
	end
	return name
end

local function formatTime(seconds)
	seconds = math.max(0, tonumber(seconds) or 0)
	local minutes = math.floor(seconds / 60)
	local secs = math.floor(seconds % 60)
	return string.format("%02d:%02d", minutes, secs)
end

local sfxFolder = rsFolder:FindFirstChild("CaaSFX")
for _, existing in ipairs(gui:GetChildren()) do
	if existing:IsA("GuiObject") and (existing.Name == "CaaNotificationSidebar" or existing:GetAttribute("SSNoticeRoot") == true) then
		existing:Destroy()
	end
end
local notificationRoot = Instance.new("Frame")
notificationRoot.Name = randomUiName("IFE", 14)
notificationRoot:SetAttribute("SSNoticeRoot", true)
notificationRoot.AnchorPoint = Vector2.new(1, 0.5)
notificationRoot.Position = UDim2.new(1, -IFEACFSEFIEFB.Notice.EdgePadding, 0.5, 0)
notificationRoot.Size = UDim2.fromOffset(IFEACFSEFIEFB.Notice.SidebarWidth, IFEACFSEFIEFB.Notice.SidebarHeight)
notificationRoot.BackgroundTransparency = 1
notificationRoot.BorderSizePixel = 0
notificationRoot.ZIndex = 500
notificationRoot.Parent = gui

local notificationScale = Instance.new("UIScale")
notificationScale.Name = "ResponsiveScale"
notificationScale.Scale = 1
notificationScale.Parent = notificationRoot

local notificationLayout = Instance.new("UIListLayout")
notificationLayout.FillDirection = Enum.FillDirection.Vertical
notificationLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
notificationLayout.VerticalAlignment = Enum.VerticalAlignment.Center
notificationLayout.SortOrder = Enum.SortOrder.LayoutOrder
notificationLayout.Padding = UDim.new(0, IFEACFSEFIEFB.Notice.Gap)
notificationLayout.Parent = notificationRoot

local notificationSlots = {}
local noticeOrder = 0

local function playNoticeSFX(kind)
	if not sfxFolder then return end
	local source = sfxFolder:FindFirstChild(kind == "error" and "ErrorSound" or "SuccessSound")
	if not source or not source:IsA("Sound") then return end
	local sound = source:Clone()
	sound.Name = "CaaNoticeSFX"
	sound.Volume = math.clamp(source.Volume, 0, 0.55)
	sound.SoundGroup = localVolumeGroup
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, math.max(2.5, sound.TimeLength + 0.5))
end

local function removeNotificationSlot(slot, immediate)
	local index = table.find(notificationSlots, slot)
	if index then table.remove(notificationSlots, index) end
	if not slot or not slot.Parent then return end
	local body = slot:FindFirstChild("Body")
	if immediate or not body then
		slot:Destroy()
		return
	end
	TweenService:Create(body, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
		Position = UDim2.new(0, 36, 0, 0),
		BackgroundTransparency = 1,
	}):Play()
	task.delay(0.19, function()
		if slot.Parent then slot:Destroy() end
	end)
end

local function notify(kind, title, message, track, duration)
	kind = kind == "error" and "error" or "success"
	title = tostring(title or (kind == "error" and "ERROR" or "SUCCESS"))
	message = tostring(message or "")
	duration = math.clamp(tonumber(duration) or 3.2, 1.5, 7)

	local signature = kind .. "|" .. title .. "|" .. message
	if state.lastNoticeSignature == signature and os.clock() - state.lastNoticeAt < 0.35 then return end
	state.lastNoticeSignature = signature
	state.lastNoticeAt = os.clock()

	while #notificationSlots >= 3 do
		removeNotificationSlot(notificationSlots[1], true)
	end

	noticeOrder += 1
	local accent = kind == "error" and Color3.fromRGB(106, 106, 106) or Color3.fromRGB(238, 238, 238)
	local isNowPlaying = title == "NOW PLAYING"
	local upperTitle = string.upper(title)
	local isLikedNotice = upperTitle:find("LIKED", 1, true) ~= nil
	local height = isNowPlaying and IFEACFSEFIEFB.Notice.HeightNowPlaying or (isLikedNotice and IFEACFSEFIEFB.Notice.HeightLike or IFEACFSEFIEFB.Notice.Height)
	local displayTitle = upperTitle
	if isLikedNotice and not displayTitle:find("...", 1, true) then
		displayTitle = displayTitle .. "..."
	end
	local displayMessage = message
	if isLikedNotice and displayMessage ~= "" and not displayMessage:match("^%s*%-%s") then
		displayMessage = "- " .. displayMessage
	end

	local slot = Instance.new("Frame")
	slot.Name = randomUiName("IFE", 12)
	slot.LayoutOrder = noticeOrder
	slot.Size = UDim2.new(1, 0, 0, height)
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.ZIndex = 500
	slot.Parent = notificationRoot
	table.insert(notificationSlots, slot)

	local body = Instance.new("Frame")
	body.Name = randomUiName("IFE", 12)
	body.Position = UDim2.new(0, 28, 0, 0)
	body.Size = UDim2.new(1, 0, 1, 0)
	body.BackgroundColor3 = Color3.fromRGB(13, 13, 13)
	body.BackgroundTransparency = 0.02
	body.BorderSizePixel = 0
	body.ClipsDescendants = true
	body.ZIndex = 501
	body.Parent = slot

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, IFEACFSEFIEFB.Notice.Corner)
	corner.Parent = body

	local stroke = Instance.new("UIStroke")
	stroke.Color = accent
	stroke.Thickness = IFEACFSEFIEFB.Notice.Stroke
	stroke.Transparency = 0.04
	stroke.Parent = body

	local inner = Instance.new("Frame")
	inner.Name = randomUiName("IFE", 10)
	inner.Position = UDim2.fromOffset(4, 4)
	inner.Size = UDim2.new(1, -8, 1, -8)
	inner.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	inner.BackgroundTransparency = 0.14
	inner.BorderSizePixel = 0
	inner.ClipsDescendants = true
	inner.ZIndex = 501
	inner.Parent = body
	local innerCorner = Instance.new("UICorner")
	innerCorner.CornerRadius = UDim.new(0, math.max(8, IFEACFSEFIEFB.Notice.Corner - 4))
	innerCorner.Parent = inner

	local imageSize = math.min(IFEACFSEFIEFB.Notice.Cover, height - 22)
	local iconFrame = Instance.new("Frame")
	iconFrame.Name = randomUiName("IFE", 10)
	iconFrame.AnchorPoint = Vector2.new(0, 0.5)
	iconFrame.Position = UDim2.new(0, 14, 0.5, 0)
	iconFrame.Size = UDim2.fromOffset(imageSize, imageSize)
	iconFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	iconFrame.BackgroundTransparency = 0.02
	iconFrame.BorderSizePixel = 0
	iconFrame.ClipsDescendants = true
	iconFrame.ZIndex = 502
	iconFrame.Parent = body

	local iconCorner = Instance.new("UICorner")
	iconCorner.CornerRadius = UDim.new(0, 14)
	iconCorner.Parent = iconFrame

	local image = type(track) == "table" and trackImage(track) or ""
	if image ~= "" then
		local cover = Instance.new("ImageLabel")
		cover.Name = randomUiName("IFE", 9)
		cover.Size = UDim2.fromScale(1, 1)
		cover.BackgroundTransparency = 1
		cover.Image = image
		cover.ScaleType = Enum.ScaleType.Crop
		cover.ZIndex = 503
		cover.Parent = iconFrame
	else
		local iconText = Instance.new("TextLabel")
		iconText.Name = randomUiName("IFE", 9)
		iconText.Size = UDim2.fromScale(1, 1)
		iconText.BackgroundTransparency = 1
		iconText.Font = Enum.Font.DenkOne
		iconText.Text = kind == "error" and "!" or "+"
		iconText.TextColor3 = accent
		iconText.TextScaled = true
		iconText.TextSize = 24
		iconText.ZIndex = 503
		iconText.Parent = iconFrame
		local textConstraint = Instance.new("UITextSizeConstraint")
		textConstraint.MinTextSize = 9
		textConstraint.MaxTextSize = 24
		textConstraint.Parent = iconText
	end

	local textX = imageSize + 26
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = randomUiName("IFE", 9)
	titleLabel.Position = UDim2.fromOffset(textX, isNowPlaying and 20 or (isLikedNotice and 18 or 17))
	titleLabel.Size = UDim2.new(1, -(textX + 14), 0, 24)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.DenkOne
	titleLabel.Text = displayTitle
	titleLabel.TextColor3 = accent
	titleLabel.TextSize = IFEACFSEFIEFB.Notice.TitleSize
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextYAlignment = Enum.TextYAlignment.Center
	titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
	titleLabel.ZIndex = 503
	titleLabel.Parent = body

	local messageViewport = Instance.new("Frame")
	messageViewport.Name = randomUiName("IFE", 9)
	messageViewport.AnchorPoint = Vector2.new(0, 0.5)
	messageViewport.Position = UDim2.new(0, textX, 0.5, isNowPlaying and 11 or (isLikedNotice and 12 or 10))
	messageViewport.Size = UDim2.new(1, -(textX + 14), 0, isNowPlaying and 36 or 32)
	messageViewport.BackgroundTransparency = 1
	messageViewport.BorderSizePixel = 0
	messageViewport.ClipsDescendants = true
	messageViewport.ZIndex = 503
	messageViewport.Parent = body

	local messageLabel = Instance.new("TextLabel")
	messageLabel.Name = randomUiName("IFE", 9)
	messageLabel.Position = UDim2.fromOffset(0, 0)
	messageLabel.Size = UDim2.new(0, 0, 1, 0)
	messageLabel.AutomaticSize = Enum.AutomaticSize.X
	messageLabel.BackgroundTransparency = 1
	messageLabel.Font = Enum.Font.DenkOne
	messageLabel.Text = displayMessage
	messageLabel.TextColor3 = Color3.fromRGB(238, 238, 238)
	messageLabel.TextSize = isNowPlaying and IFEACFSEFIEFB.Notice.MessageSize or (isLikedNotice and IFEACFSEFIEFB.Notice.MessageSize or IFEACFSEFIEFB.Notice.MessageSizeDefault)
	messageLabel.TextWrapped = false
	messageLabel.TextTruncate = Enum.TextTruncate.None
	messageLabel.TextXAlignment = Enum.TextXAlignment.Left
	messageLabel.TextYAlignment = Enum.TextYAlignment.Center
	messageLabel.ZIndex = 503
	messageLabel.Parent = messageViewport

	task.defer(function()
		RunService.Heartbeat:Wait()
		if not (messageLabel.Parent and messageViewport.Parent) then return end
		local availableWidth = messageViewport.AbsoluteSize.X
		local requiredWidth = math.ceil(messageLabel.TextBounds.X + 2)
		local viewportHeight = math.max(1, messageViewport.AbsoluteSize.Y)
		messageLabel.AutomaticSize = Enum.AutomaticSize.None
		if availableWidth <= 0 or requiredWidth <= availableWidth + 2 then
			messageLabel.Size = UDim2.fromOffset(math.max(1, availableWidth), viewportHeight)
			return
		end
		messageLabel.Size = UDim2.fromOffset(requiredWidth, viewportHeight)
		local travel = math.ceil(requiredWidth - availableWidth + 18)
		local durationScroll = math.clamp(travel / 34, 2.8, 8)
		TweenService:Create(messageLabel, TweenInfo.new(
			durationScroll,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.InOut,
			-1,
			true,
			0.7
			), {
				Position = UDim2.fromOffset(-travel, 0),
			}):Play()
	end)

	local progress = Instance.new("Frame")
	progress.Name = randomUiName("IFE", 8)
	progress.AnchorPoint = Vector2.new(0, 1)
	progress.Position = UDim2.new(0, textX, 1, -IFEACFSEFIEFB.Notice.ProgressBottom)
	progress.Size = UDim2.new(1, -(textX + 20), 0, IFEACFSEFIEFB.Notice.ProgressHeight)
	progress.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	progress.BackgroundTransparency = 0.12
	progress.BorderSizePixel = 0
	progress.ClipsDescendants = true
	progress.ZIndex = 503
	progress.Parent = body
	local progressCorner = Instance.new("UICorner")
	progressCorner.CornerRadius = UDim.new(1, 0)
	progressCorner.Parent = progress

	local progressFillNotice = Instance.new("Frame")
	progressFillNotice.Name = randomUiName("IFE", 8)
	progressFillNotice.Size = UDim2.fromScale(1, 1)
	progressFillNotice.BackgroundColor3 = accent
	progressFillNotice.BorderSizePixel = 0
	progressFillNotice.ZIndex = 504
	progressFillNotice.Parent = progress
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = progressFillNotice

	playNoticeSFX(kind)
	TweenService:Create(body, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 0, 0, 0),
	}):Play()
	TweenService:Create(progressFillNotice, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 1, 0),
	}):Play()
	task.delay(duration, function()
		removeNotificationSlot(slot, false)
	end)
end

local function fire(action, payload)
	commandRemote:FireServer(action, payload)
end

local closeDebounce = false

local function closePanel()
	if closeDebounce or not state.panelOpen then return end
	closeDebounce = true
	setPanelOpen(false)
	task.delay(0.08, function() closeDebounce = false end)
end


