			</Properties>
			<Item class="Folder" referent="RBXB1987AF23914410EA4621FB334C47D43">
				<Properties>
					<Color3 name="IconTint">
						<R>0</R>
						<G>0</G>
						<B>0</B>
					</Color3>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">CaaMusicSS</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX7C740B40BDBF4778AEDEF39AC1545CD9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Main = { BuildTag = "SS_MAIN_1.9.3" }

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local runtime = nil
local closeHandlerRegistered = false

local function disconnectAll(connections)
	for index = #connections, 1, -1 do
		local connection = connections[index]
		connections[index] = nil
		pcall(function()
			connection:Disconnect()
		end)
	end
end

local function clampNumber(value, minimum, maximum, fallback)
	value = tonumber(value)
	if value == nil or value ~= value then
		return fallback
	end
	return math.clamp(value, minimum, maximum)
end

local function normalizeAssetId(value)
	if value == nil then
		return nil
	end

	local text = tostring(value)
	local id = text:match("rbxassetid://(%d+)") or text:match("^(%d+)$") or text:match("(%d+)")
	if not id or id == "" or id == "0" then
		return nil
	end
	return id
end

local COLLECTION_FAVORITE_PREFIX = "@collection:"

local function collectionFavoriteKey(value)
    local name = tostring(value or ""):match("^%s*(.-)%s*$") or ""
    if name == "" then return nil end
    return COLLECTION_FAVORITE_PREFIX .. string.lower(name)
end

local function normalizedAction(value)
	return string.lower(tostring(value or "")):gsub("[^%w]", "")
end

local function shallowCopy(source)
	local target = {}
	for key, value in pairs(source or {}) do
		target[key] = value
	end
	return target
end

local function getFirst(source, keys)
	if type(source) ~= "table" then
		return nil
	end
	for _, key in ipairs(keys) do
		local value = source[key]
		if value ~= nil then
			return value
		end
	end
	return nil
end

local function safeRequire(moduleScript, fallback)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return fallback
	end
	local ok, result = pcall(function()
        return require(moduleScript)
    end)
	if ok and type(result) == "table" then
		return result
	end

	return fallback
end

local function makePublicTrack(track)
	if type(track) ~= "table" then
		return nil
	end

	local ids = {}
	for _, value in ipairs(track.soundIds or track.SoundIds or {}) do
		local id = normalizeAssetId(value)
		if id then
			table.insert(ids, id)
		end
	end

	local firstId = normalizeAssetId(track.id or track.soundId or track.SoundId or ids[1])
	if not firstId then
		return nil
	end
	if #ids == 0 then
		table.insert(ids, firstId)
	end

	local name = tostring(track.name or track.title or track.SongName or "Unknown Track")
	local imageId = normalizeAssetId(track.imageId or track.ImageId or track.image)
	local speed = clampNumber(track.playbackSpeed or track.PlaybackSpeed, 0.1, 2, 1)
	local requesterName = tostring(track.requesterName or track.requester or track.requestedBy or "AutoPlay")
	local requesterUserId = tonumber(track.requesterUserId or track.userId or track.UserId) or 0
	local requesterIsDJ = track.requesterIsDJ == true or track.RequesterIsDJ == true

	return {
		id = firstId,
		name = name,
		imageId = imageId,
		playbackSpeed = speed,
		soundIds = ids,
		isMultiPart = #ids > 1,
		partCount = #ids,
		requester = requesterName,
		requesterUserId = requesterUserId,
		requesterIsDJ = requesterIsDJ,
		collection = track.collection or track.col,
	}
end

local function buildCatalog(library)
	local result = {}
	local source = library.Catalog
	if type(source) ~= "table" and type(library.flat) == "function" then
		local ok, flat = pcall(function()
            return library.flat(nil)
        end)
		if ok then
			source = flat
		end
	end

	for _, track in ipairs(type(source) == "table" and source or {}) do
		local public = makePublicTrack(track)
		if public then
			public.requester = "AutoPlay"
			public.requestedBy = "AutoPlay"
			public.requesterName = "AutoPlay"
			public.requesterUserId = 0
			table.insert(result, public)
		end
	end
	return result
end

local function trackMatches(track, query)
	query = string.lower(tostring(query or ""))
	if query == "" then
		return false
	end
	return tostring(track.id) == query
		or string.lower(tostring(track.name)):find(query, 1, true) ~= nil
end

local function resolveTrack(state, payload, player)
	local candidate = payload
	if type(payload) == "table" then
		candidate = getFirst(payload, {
			"track", "Track", "song", "Song", "data", "Data", "payload", "Payload",
		}) or payload
	end

	if type(candidate) == "number" then
		candidate = tostring(candidate)
	end

	if type(candidate) == "string" then
		for _, catalogTrack in ipairs(state.catalog) do
			if trackMatches(catalogTrack, candidate) then
				local track = shallowCopy(catalogTrack)
				track.requester = player.DisplayName
				track.requestedBy = player.DisplayName
				track.requesterName = player.DisplayName
				track.requesterUserId = player.UserId
				return track
			end
		end

		local id = normalizeAssetId(candidate)
		if id then
			return makePublicTrack({
				id = id,
				name = "Music " .. id,
				requesterName = player.DisplayName,
				requesterUserId = player.UserId,
			})
		end
		return nil
	end

	if type(candidate) ~= "table" then
		return nil
	end

	local catalogIndex = tonumber(getFirst(candidate, { "index", "Index", "catalogIndex", "CatalogIndex" }))
	if catalogIndex and state.catalog[catalogIndex] then
		local track = shallowCopy(state.catalog[catalogIndex])
		track.requester = player.DisplayName
		track.requestedBy = player.DisplayName
		track.requesterName = player.DisplayName
		track.requesterUserId = player.UserId
		return track
	end

	local query = getFirst(candidate, { "query", "Query", "name", "Name", "title", "Title", "SongName" })
	local rawId = getFirst(candidate, {
		"id", "Id", "soundId", "SoundId", "musicId", "MusicId", "assetId", "AssetId",
	})

	if rawId == nil and type(query) == "string" then
		for _, catalogTrack in ipairs(state.catalog) do
			if trackMatches(catalogTrack, query) then
				local track = shallowCopy(catalogTrack)
				track.requester = player.DisplayName
				track.requestedBy = player.DisplayName
				track.requesterName = player.DisplayName
				track.requesterUserId = player.UserId
				return track
			end
		end
	end

	local ids = getFirst(candidate, { "soundIds", "SoundIds", "parts", "Parts" })
	local public = makePublicTrack({
		id = rawId,
		soundId = rawId,
		soundIds = ids,
		name = query or "Unknown Track",
		imageId = getFirst(candidate, { "imageId", "ImageId", "image", "Image" }),
		playbackSpeed = getFirst(candidate, { "playbackSpeed", "PlaybackSpeed", "speed", "Speed" }),
		requesterName = player.DisplayName,
		requesterUserId = player.UserId,
		collection = getFirst(candidate, { "collection", "Collection", "col" }),
	})
	return public
end

local function queueLimitFor(state, player)
	local access = state:getAccess(player)
	if access.isDJ then
		return 999999
	end

	local gamepass = state.config.Gamepass or {}
	if access.ownsGamepass then
		return math.max(1, tonumber(gamepass.MaxSongQueue) or 10)
	end

	local queueConfig = state.config.Queue or {}
	if access.groupRank > 0 then
		return math.max(1, tonumber(queueConfig.MaxGroupQueues) or 3)
	end

	return math.max(1, tonumber(queueConfig.MaxNonGroupQueues) or 1)
end

local function ensureAudioEffects(state)
	local audio = state.config.Audio or {}
	state.sound.Volume = clampNumber(audio.DefaultVolume, 0, 10, 0.5)

	if audio.EnableEqualizer then
		local effect = state.sound:FindFirstChild("CaaEqualizer")
		if not effect then
			effect = Instance.new("EqualizerSoundEffect")
			effect.Name = "CaaEqualizer"
			effect.Parent = state.sound
		end
		effect.LowGain = clampNumber(audio.EQ_LowGain, -80, 10, 0)
		effect.MidGain = clampNumber(audio.EQ_MidGain, -80, 10, 0)
		effect.HighGain = clampNumber(audio.EQ_HighGain, -80, 10, 0)
	end

	if audio.EnableCompressor then
		local effect = state.sound:FindFirstChild("CaaCompressor")
		if not effect then
			effect = Instance.new("CompressorSoundEffect")
			effect.Name = "CaaCompressor"
			effect.Parent = state.sound
		end
		effect.Attack = clampNumber(audio.Comp_Attack, 0.001, 1, 0.1)
		effect.Release = clampNumber(audio.Comp_Release, 0.01, 1, 0.1)
		effect.Ratio = clampNumber(audio.Comp_Ratio, 1, 50, 4)
		effect.Threshold = clampNumber(audio.Comp_Threshold, -80, 0, -12)
	end

	if audio.EnableReverb then
		local effect = state.sound:FindFirstChild("CaaReverb")
		if not effect then
			effect = Instance.new("ReverbSoundEffect")
			effect.Name = "CaaReverb"
			effect.Parent = state.sound
		end
		effect.DecayTime = clampNumber(audio.Rev_DecayTime, 0.1, 20, 1.2)
		effect.Density = clampNumber(audio.Rev_Density, 0, 1, 0.65)
		effect.WetLevel = clampNumber(audio.Rev_WetLevel, -80, 10, -18)
	end
end

local function newState(context)
	local rsFolder = ReplicatedStorage:FindFirstChild("CaaMusicRS")
	assert(rsFolder, "ReplicatedStorage/CaaMusicRS tidak ditemukan")

	local remotesFolder = rsFolder:FindFirstChild("CaaRemotes")
	assert(remotesFolder, "ReplicatedStorage/CaaMusicRS/CaaRemotes tidak ditemukan")

	local sound = SoundService:FindFirstChild("CaaMusicSystem")
	assert(sound and sound:IsA("Sound"), "SoundService/CaaMusicSystem tidak ditemukan")

	local library = safeRequire(rsFolder:FindFirstChild("CaaDJLibrary"), {})
	local config = safeRequire(rsFolder:FindFirstChild("CaaUserConfig"), {})




    local favoriteStore = DataStoreService:GetDataStore("CenzMusicFavorites_V1")

	local state = {
		active = true,
		context = context or {},
		connections = {},
		remotes = {
			Command = remotesFolder:FindFirstChild("CaaDJ_Command"),
			Preload = remotesFolder:FindFirstChild("CaaDJ_Preload"),
			RequestState = remotesFolder:FindFirstChild("CaaDJ_RequestState"),
			State = remotesFolder:FindFirstChild("CaaDJ_State"),
			VoteState = remotesFolder:FindFirstChild("CaaDJ_VoteState"),
		},
		sound = sound,
		library = library,
		config = config,
		catalog = buildCatalog(library),
		catalogGeneration = 0,
		queue = {},
		queuedByUser = {},
		current = nil,
		currentPart = 0,
		queueLocked = false,
		playToken = 0,
		lastCatalogIndex = 0,
		lastCommandAt = setmetatable({}, { __mode = "k" }),
		accessCache = {},
		vote = nil,
		voteCooldownUntil = 0,
		sessionDJs = {},
		customSongs = {},
		favorites = {},
		favoritesLoaded = {},
		favoriteDirty = {},
		favoriteSaveTokens = {},
        favoriteMutations = {},
        favoriteRetryAt = {},
		favoriteStore = favoriteStore,
		djModeEnabled = ((config.DJ or {}).DJModeEnabled == true),
	}

	for remoteName, remote in pairs(state.remotes) do
		assert(remote and remote:IsA("RemoteEvent"), "RemoteEvent tidak ditemukan: " .. remoteName)
	end

	state.getAccess = function(self, player)
		if not player then
			return { isDJ = false, groupRank = 0, ownsGamepass = false }
		end

		local cached = self.accessCache[player.UserId]
		if cached and os.clock() - cached.checkedAt < 300 then
			return cached
		end

		local dj = self.config.DJ or {}
		local groupId = tonumber((self.config.Group or {}).GroupID) or 0
		local gamepassId = tonumber((self.config.Gamepass or {}).GamepassID) or 0
		local groupRank = 0
		local ownsGamepass = false
		local isDJ = self.sessionDJs[player.UserId] ~= nil

		if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
			isDJ = true
		end
		if game.PrivateServerOwnerId ~= 0 and player.UserId == game.PrivateServerOwnerId then
			isDJ = true
		end

		for _, userId in ipairs(dj.AlwaysDJUserIds or {}) do
			if tonumber(userId) == player.UserId then
				isDJ = true
				break
			end
		end

		if groupId > 0 then
			local ok, rank = pcall(function()
                return player:GetRankInGroup(groupId)
            end)
			if ok then
				groupRank = tonumber(rank) or 0
				local minimum = tonumber(dj.MinimumRank) or tonumber(dj.GroupRoleID) or 255
				if groupRank >= minimum then
					isDJ = true
				end
			end
		end

		if gamepassId > 0 then
			local ok, owns = pcall(function()
                return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
            end)
			if ok then
				ownsGamepass = owns == true
			end
		end

		cached = {
			isDJ = isDJ,
			groupRank = groupRank,
			ownsGamepass = ownsGamepass,
			checkedAt = os.clock(),
		}
		self.accessCache[player.UserId] = cached
		return cached
	end

	state.isDJ = function(self, player)
		return self:getAccess(player).isDJ
	end

	return state
end

local function publicQueue(state)
	local result = {}
	for index, track in ipairs(state.queue) do
		local copyTrack = makePublicTrack(track)
		if copyTrack then
		copyTrack.index = index
		table.insert(result, copyTrack)
		end
	end
	return result
end

local function voteSnapshot(state, player)
    local vote = state.vote
    if not vote then
        return {
            active = false,
            count = 0,
            required = 0,
            remaining = 0,
            hasVoted = false,
        }
    end

    local count = 0
    for userId in pairs(vote.voters) do
        if Players:GetPlayerByUserId(userId) then
            count = count + 1
        end
    end
    local remaining = math.max(0, vote.endsAt - os.clock())
    local hasVoted = player and vote.voters[player.UserId] == true or false
    return {
        active = true,
        id = vote.id,
        count = count,
        required = vote.required,
        remaining = remaining,
        endsAtServer = workspace:GetServerTimeNow() + remaining,
        startedBy = vote.startedBy,
        startedByUserId = vote.startedByUserId,
        hasVoted = hasVoted,
    }
end


local function effectsSnapshot(state)
    local equalizer = state.sound:FindFirstChild("CaaEqualizer")
    local compressor = state.sound:FindFirstChild("CaaCompressor")
    local reverb = state.sound:FindFirstChild("CaaReverb")
    local echoFx = state.sound:FindFirstChild("CaaEcho")
    local flangerFx = state.sound:FindFirstChild("CaaFlanger")
    local tremoloFx = state.sound:FindFirstChild("CaaTremolo")
    local filterFx = state.sound:FindFirstChild("CaaFilter")
    return {
        equalizer = {
            enabled = equalizer and equalizer.Enabled or false,
            lowGain = equalizer and equalizer.LowGain or 0,
            midGain = equalizer and equalizer.MidGain or 0,
            highGain = equalizer and equalizer.HighGain or 0,
        },
        compressor = {
            enabled = compressor and compressor.Enabled or false,
            threshold = compressor and compressor.Threshold or -12,
            ratio = compressor and compressor.Ratio or 4,
            attack = compressor and compressor.Attack or 0.1,
            release = compressor and compressor.Release or 0.1,
        },
        reverb = {
            enabled = reverb and reverb.Enabled or false,
            decayTime = reverb and reverb.DecayTime or 1.2,
            density = reverb and reverb.Density or 0.65,
            wetLevel = reverb and reverb.WetLevel or -18,
        },
        echo = { enabled = echoFx and echoFx.Enabled or false },
        flanger = { enabled = flangerFx and flangerFx.Enabled or false },
        tremolo = { enabled = tremoloFx and tremoloFx.Enabled or false },
        filter = {
            enabled = filterFx and filterFx.Enabled or false,
            cutoff = filterFx and filterFx:GetAttribute("Cutoff") or 0.5,
        },
    }
end

local function sessionDJSnapshot(state)
    local result = {}
    for userId, username in pairs(state.sessionDJs) do
        table.insert(result, {userId = userId, username = username})
    end
    table.sort(result, function(a, b) return tostring(a.username) < tostring(b.username) end)
    return result
end

local function residentDJSnapshot(state)
    local result = {}
    local seen = {}
    local function addResident(userId)
        userId = tonumber(userId)
        if not userId or userId <= 0 or seen[userId] then return end
        seen[userId] = true
        local online = Players:GetPlayerByUserId(userId)
        table.insert(result, {
            userId = userId,
            username = online and online.Name or ("User " .. tostring(userId)),
        })
    end

    local djConfig = (state.config or {}).DJ or {}
    for _, userId in ipairs(djConfig.AlwaysDJUserIds or {}) do
        addResident(userId)
    end
    if game.CreatorType == Enum.CreatorType.User then addResident(game.CreatorId) end
    if game.PrivateServerOwnerId ~= 0 then addResident(game.PrivateServerOwnerId) end

    table.sort(result, function(a, b) return tostring(a.username) < tostring(b.username) end)
    return result
end

local function ensureEffect(state, className, name)
    local effect = state.sound:FindFirstChild(name)
    if not effect then
        effect = Instance.new(className)
        effect.Name = name
        effect.Parent = state.sound
    end
    return effect
end

local sendState

local function favoritesSnapshot(state, player)
    local source = state.favorites[player.UserId] or {}
    local result = {}
    for id, enabled in pairs(source) do
        if enabled == true then result[tostring(id)] = true end
    end
    return result
end

local function normalizeFavoriteSet(source)
    local result = {}
    if type(source) ~= "table" then return result end
    for id, enabled in pairs(source) do
        local normalized = normalizeAssetId(id)
        if normalized and enabled == true then result[normalized] = true end
    end
    return result
end

local FAVORITE_IO_ATTEMPTS = 3
local FAVORITE_SAVE_DELAY = 2

local function cloneFavoriteSet(source)
    local result = {}
    for id, enabled in pairs(source or {}) do
        if enabled == true then result[tostring(id)] = true end
    end
    return result
end

local function writeFavoriteSnapshot(state, userId, snapshot, markDirtyOnFailure)
    if state.favoriteStore == nil then
        if markDirtyOnFailure then state.favoriteDirty[userId] = true end
        return false
    end

    local ok = false
    for attempt = 1, FAVORITE_IO_ATTEMPTS do
        ok = pcall(function()
            state.favoriteStore:UpdateAsync("u_" .. tostring(userId), function()
                return cloneFavoriteSet(snapshot)
            end)
        end)
        if ok then break end
        if attempt < FAVORITE_IO_ATTEMPTS then task.wait(0.65 * attempt) end
    end

    if ok then
        state.favoriteDirty[userId] = nil
    elseif markDirtyOnFailure then
        state.favoriteDirty[userId] = true
    end
    return ok
end

local function loadFavorites(state, player)
    if not player or not player.Parent then return end
    local userId = player.UserId
    local loadState = state.favoritesLoaded[userId]
    if loadState == true or loadState == "loading" then return end
    if loadState == "failed" and os.clock() < (state.favoriteRetryAt[userId] or 0) then return end

    state.favoritesLoaded[userId] = "loading"
    local ok, stored = false, nil
    for attempt = 1, FAVORITE_IO_ATTEMPTS do
        ok, stored = pcall(function()
            return state.favoriteStore:GetAsync("u_" .. tostring(userId))
        end)
        if ok then break end
        if attempt < FAVORITE_IO_ATTEMPTS then task.wait(0.65 * attempt) end
    end
    if not player.Parent then return end

    if not ok then

        state.favoritesLoaded[userId] = "failed"
        state.favoriteRetryAt[userId] = os.clock() + 15
        sendState(state, player, true, nil)
        return
    end

    local merged = normalizeFavoriteSet(stored)
    for id, enabled in pairs(state.favoriteMutations[userId] or {}) do
        merged[id] = enabled == true and true or nil
    end
    state.favoriteMutations[userId] = nil
    state.favorites[userId] = merged
    state.favoritesLoaded[userId] = true
    state.favoriteRetryAt[userId] = nil
    sendState(state, player, true, nil)

    if state.favoriteDirty[userId] then
        local token = (state.favoriteSaveTokens[userId] or 0) + 1
        state.favoriteSaveTokens[userId] = token
        task.delay(0.2, function()
            if state.active and state.favoriteSaveTokens[userId] == token then
                writeFavoriteSnapshot(state, userId, cloneFavoriteSet(state.favorites[userId]), true)
            end
        end)
    end
end

local function scheduleFavoriteSave(state, userId)
    state.favoriteDirty[userId] = true
    if state.favoriteStore == nil or state.favoritesLoaded[userId] ~= true then
        return
    end

    local token = (state.favoriteSaveTokens[userId] or 0) + 1
    state.favoriteSaveTokens[userId] = token
    task.delay(FAVORITE_SAVE_DELAY, function()
        if not state.active
            or state.favoriteSaveTokens[userId] ~= token
            or not state.favoriteDirty[userId]
            or state.favoritesLoaded[userId] ~= true
        then
            return
        end
        writeFavoriteSnapshot(state, userId, cloneFavoriteSet(state.favorites[userId]), true)
    end)
end

local function recordFavoriteMutation(state, userId, id, enabled)
    if state.favoritesLoaded[userId] == true then return end
    local mutations = state.favoriteMutations[userId]
    if not mutations then
        mutations = {}
        state.favoriteMutations[userId] = mutations
    end
    mutations[id] = enabled == true
end

local function setFavorite(state, player, payload)
    local rawId = type(payload) == "table" and getFirst(payload, {"id", "Id", "soundId", "SoundId"}) or payload
    local id = normalizeAssetId(rawId)
    if not id then return end
    local set = state.favorites[player.UserId]
    if not set then
        set = {}
        state.favorites[player.UserId] = set
    end
    local requested = type(payload) == "table" and getFirst(payload, {"enabled", "Enabled", "value", "Value"}) or nil
    local enabled
    if requested == nil then
        enabled = not (set[id] == true)
    else
        enabled = requested == true or requested == 1 or tostring(requested):lower() == "true"
    end
    set[id] = enabled and true or nil
    recordFavoriteMutation(state, player.UserId, id, enabled)
    scheduleFavoriteSave(state, player.UserId)
    sendState(state, player, true, nil)

    if state.favoritesLoaded[player.UserId] == "failed" then
        task.spawn(loadFavorites, state, player)
    end
end

local function toggleCollectionFavorite(state, player, payload)
    local collection = type(payload) == "table" and getFirst(payload, {"collection", "Collection", "name", "Name"}) or payload
    local key = collectionFavoriteKey(collection)
    if not key then return end

    local set = state.favorites[player.UserId]
    if not set then
        set = {}
        state.favorites[player.UserId] = set
    end

    local requested = type(payload) == "table" and getFirst(payload, {"enabled", "Enabled", "value", "Value"}) or nil
    local enabled
    if requested == nil then
        enabled = not (set[key] == true)
    else
        enabled = requested == true or requested == 1 or tostring(requested):lower() == "true"
    end

    set[key] = enabled and true or nil
    recordFavoriteMutation(state, player.UserId, key, enabled)
    scheduleFavoriteSave(state, player.UserId)
    sendState(state, player, true, nil)

    if state.favoritesLoaded[player.UserId] == "failed" then
        task.spawn(loadFavorites, state, player)
    end
end

local function makeStatePacket(state, player, includeCatalog, notice)
	local current = makePublicTrack(state.current)
	if current then
		current.currentPart = state.currentPart
	end

	local queue = publicQueue(state)
	local vote = voteSnapshot(state, player)
	local playing = state.sound.Playing
	local paused = current ~= nil and not playing
	local duration = tonumber(state.sound.TimeLength) or 0
	local position = tonumber(state.sound.TimePosition) or 0
	local isDJ = state:isDJ(player)
	local queueLimit = queueLimitFor(state, player)
	local effects = effectsSnapshot(state)
	local sessionDJs = sessionDJSnapshot(state)
	local residentDJs = residentDJSnapshot(state)
	local favorites = favoritesSnapshot(state, player)

	local packet = {
		type = "state",
		serverTime = workspace:GetServerTimeNow(),
		current = current,
		queue = queue,
		playing = playing,
		paused = paused,
		timePosition = position,
		duration = duration,
		volume = state.sound.Volume,
		playbackSpeed = state.sound.PlaybackSpeed,
		queueLocked = state.queueLocked,
		isDJ = isDJ,
		queueLimit = queueLimit,
		vote = vote,
		autoPlayEnabled = (state.config.Queue or {}).AutoPlayEnabled ~= false,
		djModeEnabled = state.djModeEnabled,
		effects = effects,
		sessionDJs = sessionDJs,
		residentDJs = residentDJs,
		customSongs = state.customSongs,
		favorites = favorites,
	}

	if includeCatalog then
		packet.collections = state.library.Collections or {}
	end

	if notice then
		packet.notice = notice
	end
	return packet
end

sendState = function(state, player, includeCatalog, notice)
	if player and player.Parent then
		state.remotes.State:FireClient(player, makeStatePacket(state, player, includeCatalog, notice))
	end
end

local CATALOG_CHUNK_SIZE = 150

local function sendCatalogChunked(state, player)
	if not player or not player.Parent then return end
	local catalog = state.catalog
	local totalChunks = math.max(1, math.ceil(#catalog / CATALOG_CHUNK_SIZE))
	local collections = state.library.Collections or {}
	local generation = state.catalogGeneration or 0
	for chunkIndex = 1, totalChunks do
		local startIdx = (chunkIndex - 1) * CATALOG_CHUNK_SIZE + 1
		local endIdx = math.min(startIdx + CATALOG_CHUNK_SIZE - 1, #catalog)
		local chunk = table.create(endIdx - startIdx + 1)
		for i = startIdx, endIdx do
			table.insert(chunk, catalog[i])
		end
		state.remotes.Preload:FireClient(player, {
			generation = generation,
			chunkIndex = chunkIndex,
			totalChunks = totalChunks,
			tracks = chunk,
			collections = chunkIndex == 1 and collections or nil,
		})
	end
end

local catalogBroadcastToken = 0
local function broadcastCatalogDebounced(state)
	state.catalogGeneration = (state.catalogGeneration or 0) + 1
	catalogBroadcastToken += 1
	local token = catalogBroadcastToken
	task.delay(1, function()
		if not state.active or token ~= catalogBroadcastToken then return end
		for _, target in ipairs(Players:GetPlayers()) do
			sendState(state, target, true, nil)
			sendCatalogChunked(state, target)
		end
	end)
end
local function broadcastState(state, includeCatalog)
	for _, player in ipairs(Players:GetPlayers()) do
		sendState(state, player, includeCatalog, nil)
	end
end

local function sendNotice(state, player, kind, message)
	local notice = {
		kind = kind,
		message = message,
	}
	sendState(state, player, false, notice)
end

local function broadcastVote(state)
	for _, player in ipairs(Players:GetPlayers()) do
		state.remotes.VoteState:FireClient(player, voteSnapshot(state, player))
	end
end

local function clearVote(state)
	state.vote = nil
	broadcastVote(state)
end

local function decrementQueuedOwner(state, track)
	local userId = tonumber(track and track.requesterUserId) or 0
	if userId <= 0 then
		return
	end
	local current = tonumber(state.queuedByUser[userId]) or 0
	if current <= 1 then
		state.queuedByUser[userId] = nil
	else
		state.queuedByUser[userId] = current - 1
	end
end

local startNext

local function playCurrentPart(state)
	local current = state.current
	if not current then
		return
	end

	local soundIds = current.soundIds or current.SoundIds or {}
	local id = normalizeAssetId(soundIds[state.currentPart] or current.id)
	if not id then
		state.current = nil
		state.currentPart = 0
		task.defer(function()
        startNext(state)
    end)
		return
	end

	state.playToken = state.playToken + 1
	local token = state.playToken
	state.sound:Stop()
	state.sound.SoundId = "rbxassetid://" .. id
	state.sound.TimePosition = 0
	state.sound.PlaybackSpeed = clampNumber(current.playbackSpeed, 0.1, 2, 1)
	state.sound:Play()
	clearVote(state)
	broadcastState(state, false)

	task.delay(20, function()
		if not state.active or token ~= state.playToken or state.current ~= current then
			return
		end
		if (tonumber(state.sound.TimeLength) or 0) <= 0 then
			-- Retry sekali dulu sebelum nyerah, siapa tau cuma lag loading sesaat
			state.sound:Play()
			task.delay(15, function()
				if not state.active or token ~= state.playToken or state.current ~= current then
					return
				end
				if (tonumber(state.sound.TimeLength) or 0) <= 0 then
					state.playToken = state.playToken + 1
					state.sound:Stop()
					state.current = nil
					state.currentPart = 0
					startNext(state)
				end
			end)
		end
	end)
end

local function takeAutoplayTrack(state)
	if #state.catalog == 0 then
		return nil
	end

	local index
	if #state.catalog == 1 then
		index = 1
	else
		repeat
			index = math.random(1, #state.catalog)
		until index ~= state.lastCatalogIndex
	end
	state.lastCatalogIndex = index
	local track = shallowCopy(state.catalog[index])
	track.requester = "AutoPlay"
	track.requestedBy = "AutoPlay"
	track.requesterName = "AutoPlay"
	track.requesterUserId = 0
	track.requesterIsDJ = false
	track.RequesterIsDJ = false
	return track
end

startNext = function(state)
	if not state.active or state.current then
		return
	end

	local nextTrack = table.remove(state.queue, 1)
	if nextTrack then
		decrementQueuedOwner(state, nextTrack)
	elseif (state.config.Queue or {}).AutoPlayEnabled ~= false then
		nextTrack = takeAutoplayTrack(state)
	end

	if not nextTrack then
		state.sound:Stop()
		state.sound.SoundId = ""
		broadcastState(state, false)
		return
	end

	state.current = nextTrack
	state.currentPart = 1
	playCurrentPart(state)
end

local function skipCurrent(state)
	state.playToken = state.playToken + 1
	state.sound:Stop()
	state.current = nil
	state.currentPart = 0
	clearVote(state)
	startNext(state)
end

local function addQueue(state, player, payload)
	if state.queueLocked and not state:isDJ(player) then
		sendNotice(state, player, "error", "Queue sedang dikunci DJ")
		return
	end

	local djConfig = state.config.DJ or {}
	if state.djModeEnabled and not state:isDJ(player) then
		sendNotice(state, player, "error", "DJ mode sedang aktif")
		return
	end

	local track = resolveTrack(state, payload, player)
	if track then
		local requesterIsDJ = state:isDJ(player)
		track.requesterIsDJ = requesterIsDJ
		track.RequesterIsDJ = requesterIsDJ
	end
	if not track then
		sendNotice(state, player, "error", "Sound ID atau track tidak valid")
		return
	end

	local userCount = tonumber(state.queuedByUser[player.UserId]) or 0
	local limit = queueLimitFor(state, player)
	if userCount >= limit then
		sendNotice(state, player, "error", "Batas queue Anda sudah tercapai")
		return
	end

	state.queuedByUser[player.UserId] = userCount + 1
	table.insert(state.queue, track)
	sendNotice(state, player, "success", "Track ditambahkan ke queue")
	broadcastState(state, false)
	startNext(state)
end

local function removeQueue(state, player, payload)
	local index = tonumber(type(payload) == "table" and getFirst(payload, { "index", "Index", "queueIndex", "QueueIndex" }) or payload)
	if not index or not state.queue[index] then
		return
	end

	local track = state.queue[index]
	if not state:isDJ(player) and tonumber(track.requesterUserId) ~= player.UserId then
		sendNotice(state, player, "error", "Anda tidak dapat menghapus queue pemain lain")
		return
	end

	table.remove(state.queue, index)
	decrementQueuedOwner(state, track)
	broadcastState(state, false)
end

local function activeVoterCount()
	return math.max(1, #Players:GetPlayers())
end

local function requiredVotes(state)
	local voting = state.config.Voting or {}
	local percentage = clampNumber(voting.RequiredPercentage, 1, 100, 50)
	local minimum = math.max(1, tonumber(voting.MinVotesRequired) or 1)
	local maximum = math.max(minimum, tonumber(voting.MaxVotesRequired) or 15)
	return math.clamp(math.ceil(activeVoterCount() * percentage / 100), minimum, maximum)
end

local function castVote(state, player)
	if not state.current then
		return
	end

	local voting = state.config.Voting or {}
	local who = string.lower(tostring(voting.WhoCanStartVote or "everyone"))
	if not state.vote and who == "dj" and not state:isDJ(player) then
		sendNotice(state, player, "error", "Hanya DJ yang dapat memulai vote")
		return
	end

	if not state.vote then
		if os.clock() < state.voteCooldownUntil and not state:isDJ(player) then
			sendNotice(state, player, "error", "Vote skip masih cooldown")
			return
		end
		state.vote = {
			id = tostring(player.UserId) .. "-" .. tostring(math.floor(os.clock() * 1000)),
			voters = {},
			required = requiredVotes(state),
			startedBy = player.DisplayName,
			startedByUserId = player.UserId,
			endsAt = os.clock() + math.max(5, tonumber(voting.VoteTimer) or 15),
		}
	end

	state.vote.voters[player.UserId] = true
	broadcastVote(state)

	local count = 0
	for userId in pairs(state.vote.voters) do
		if Players:GetPlayerByUserId(userId) then
			count = count + 1
		end
	end

	if count >= state.vote.required then
		state.voteCooldownUntil = os.clock() + math.max(0, tonumber(voting.SkipVoteCooldown) or 30)
		skipCurrent(state)
	end
end

local function parseCommand(first, second, third)
	if type(first) == "table" then
		local action = getFirst(first, { "action", "Action", "command", "Command", "cmd", "Cmd", "type", "Type" })
		local payload = getFirst(first, { "payload", "Payload", "data", "Data", "value", "Value", "track", "Track" }) or first
		return normalizedAction(action), payload, second
	end
	return normalizedAction(first), second, third
end

local function requireDJ(state, player)
	if state:isDJ(player) then
		return true
	end
	sendNotice(state, player, "error", "Akses DJ diperlukan")
	return false
end

local function handleCommand(state, player, first, second, third)
	if not player or not player.Parent then
		return
	end

	local now = os.clock()
	local last = state.lastCommandAt[player] or 0
	if now - last < 0.08 then
		return
	end
	state.lastCommandAt[player] = now

	local action, payload, extra = parseCommand(first, second, third)
	if action == "" then
		return
	end

	if action == "requeststate" or action == "getstate" or action == "sync" or action == "refresh" then
        if state.favoritesLoaded[player.UserId] ~= true then
            task.spawn(loadFavorites, state, player)
        end
		sendState(state, player, true, nil)
		sendCatalogChunked(state, player)
		return
	end

	if action == "togglefavorite" or action == "setfavorite" or action == "favorite" then
        setFavorite(state, player, payload)
        return
    end

    if action == "togglecollectionfavorite" or action == "favoritecollection" then
        toggleCollectionFavorite(state, player, payload)
        return
    end

	if action == "queue" or action == "enqueue" or action == "addqueue" or action == "queueadd" or action == "addtoqueue" or action == "addsong" or action == "requestsong" or action == "requesttrack" or action == "songrequest" or action == "playtrack" then
		addQueue(state, player, payload)
		return
	end

	if action == "play" then
		if payload ~= nil then
			addQueue(state, player, payload)
		elseif requireDJ(state, player) then
			state.sound:Resume()
			broadcastState(state, false)
		end
		return
	end

	if action == "removequeue" or action == "removefromqueue" or action == "queueremove" or action == "deletequeue" or action == "dequeue" or action == "remove" then
		removeQueue(state, player, payload)
		return
	end

	if action == "voteskip" or action == "vote" or action == "startvote" then
		castVote(state, player)
		return
	end

	if action == "skip" or action == "forceskip" or action == "next" then
		if requireDJ(state, player) then
			skipCurrent(state)
		end
		return
	end

	if action == "seek" or action == "setposition" or action == "settime" then
		if requireDJ(state, player) and state.current then
			local value = type(payload) == "table" and getFirst(payload, { "position", "Position", "time", "Time", "value", "Value" }) or payload
			value = value or extra
			local length = tonumber(state.sound.TimeLength) or 0
			local maxPosition = length > 0 and math.max(0, length - 0.3) or 36000
			state.sound.TimePosition = clampNumber(value, 0, maxPosition, state.sound.TimePosition)
			broadcastState(state, false)
		end
		return
	end

	if action == "playagain" or action == "restart" or action == "replay" then
		if requireDJ(state, player) and state.current then
			state.sound.TimePosition = 0
			if not state.sound.Playing then
				state.sound:Resume()
			end
			broadcastState(state, false)
		end
		return
	end

	if action == "playnow" or action == "queuenext" then
		if requireDJ(state, player) then
			local track = resolveTrack(state, payload, player)
			if not track then
				sendNotice(state, player, "error", "Sound ID atau track tidak valid")
				return
			end
			track.requesterIsDJ = true
			track.RequesterIsDJ = true
			table.insert(state.queue, 1, track)
			if action == "playnow" then
				skipCurrent(state)
			else
				broadcastState(state, false)
				startNext(state)
			end
			sendNotice(state, player, "success", action == "playnow" and "Memutar lagu sekarang" or "Lagu dijadikan berikutnya")
		end
		return
	end

	if action == "pause" then
		if requireDJ(state, player) then
			state.sound:Pause()
			broadcastState(state, false)
		end
		return
	end

	if action == "resume" then
		if requireDJ(state, player) then
			state.sound:Resume()
			broadcastState(state, false)
		end
		return
	end

	if action == "togglepause" or action == "toggleplayback" or action == "playpause" or action == "toggleplay" then
		if requireDJ(state, player) then
			if state.sound.Playing then
				state.sound:Pause()
			else
				state.sound:Resume()
			end
			broadcastState(state, false)
		end
		return
	end

	if action == "clearqueue" or action == "queueclear" or action == "clear" then
		if requireDJ(state, player) then
			state.queue = {}
			state.queuedByUser = {}
			broadcastState(state, false)
		end
		return
	end

	if action == "lockqueue" or action == "queuelock" or action == "togglequeuelock" or action == "togglelock" then
		if requireDJ(state, player) then
			local value = type(payload) == "table" and getFirst(payload, { "locked", "Locked", "value", "Value", "enabled", "Enabled" }) or payload
			if value == nil then
				state.queueLocked = not state.queueLocked
			else
				state.queueLocked = value == true or value == 1 or tostring(value):lower() == "true" or tostring(value):lower() == "lock"
			end
			broadcastState(state, false)
		end
		return
	end

	if action == "unlockqueue" or action == "queueunlock" then
		if requireDJ(state, player) then
			state.queueLocked = false
			broadcastState(state, false)
		end
		return
	end

	if action == "setvolume" or action == "setglobalvolume" or action == "globalvolume" or action == "volume" then
		if requireDJ(state, player) then
			local value = type(payload) == "table" and getFirst(payload, { "volume", "Volume", "value", "Value" }) or payload
			value = value or extra
			state.sound.Volume = clampNumber(value, 0, 10, state.sound.Volume)
			broadcastState(state, false)
		end
		return
	end

	if action == "setspeed" or action == "setplaybackspeed" or action == "playbackspeed" or action == "speed" then
		if requireDJ(state, player) then
			local value = type(payload) == "table" and getFirst(payload, { "speed", "Speed", "playbackSpeed", "PlaybackSpeed", "value", "Value" }) or payload
			value = value or extra
			state.sound.PlaybackSpeed = clampNumber(value, 0.1, 2, state.sound.PlaybackSpeed)
			if state.current then
				state.current.playbackSpeed = state.sound.PlaybackSpeed
				state.current.PlaybackSpeed = state.sound.PlaybackSpeed
			end
			broadcastState(state, false)
		end
		return
	end


	if action == "toggledjmode" or action == "setdjmode" or action == "djmode" then
		if requireDJ(state, player) then
			local value = type(payload) == "table" and getFirst(payload, {"enabled", "Enabled", "value", "Value"}) or payload
			if value == nil then state.djModeEnabled = not state.djModeEnabled
			else state.djModeEnabled = value == true or value == 1 or tostring(value):lower() == "true" end
			broadcastState(state, false)
			sendNotice(state, player, "success", state.djModeEnabled and "DJ mode enabled" or "DJ mode disabled")
		end
		return
	end

	if action == "addlibrary" or action == "addtolibrary" or action == "addcatalog" then
		if requireDJ(state, player) then
			local track = resolveTrack(state, payload, player)
			if not track then sendNotice(state, player, "error", "Track data is invalid"); return end
			for _, existing in ipairs(state.catalog) do
				if tostring(existing.id) == tostring(track.id) then
					sendNotice(state, player, "error", "Track already exists in library")
					return
				end
			end
			track.requester = "AutoPlay"
			track.requestedBy = "AutoPlay"
			track.requesterName = "AutoPlay"
			track.requesterUserId = 0
			track.requesterIsDJ = false
			track.RequesterIsDJ = false
			table.insert(state.catalog, track)
			table.insert(state.customSongs, makePublicTrack(track))
			broadcastCatalogDebounced(state)
			sendNotice(state, player, "success", "Track added to session library")
		end
		return
	end

	if action == "removelibrary" or action == "removefromlibrary" or action == "removecustomsong" or action == "deletelibrarytrack" then
		if requireDJ(state, player) then
			local rawId = type(payload) == "table" and getFirst(payload, {"id", "Id", "soundId", "SoundId"}) or payload
			local targetId = normalizeAssetId(rawId)
			if not targetId then
				sendNotice(state, player, "error", "Track ID is invalid")
				return
			end

			local found = false
			for index = #state.customSongs, 1, -1 do
				local customId = normalizeAssetId(getFirst(state.customSongs[index], {"id", "Id", "soundId", "SoundId"}))
				if customId == targetId then
					table.remove(state.customSongs, index)
					found = true
				end
			end
			if not found then
				sendNotice(state, player, "error", "Track is not a custom session song")
				return
			end

			for index = #state.catalog, 1, -1 do
				local catalogId = normalizeAssetId(getFirst(state.catalog[index], {"id", "Id", "soundId", "SoundId"}))
				if catalogId == targetId then
					table.remove(state.catalog, index)
				end
			end

			for index = #state.queue, 1, -1 do
				local queued = state.queue[index]
				local queuedId = normalizeAssetId(getFirst(queued, {"id", "Id", "soundId", "SoundId"}))
				if queuedId == targetId then
					table.remove(state.queue, index)
					decrementQueuedOwner(state, queued)
				end
			end

			local currentId = state.current and normalizeAssetId(getFirst(state.current, {"id", "Id", "soundId", "SoundId"})) or nil
			if currentId == targetId then
				skipCurrent(state)
			end

			broadcastCatalogDebounced(state)
			sendNotice(state, player, "success", "Track removed from session library")
		end
		return
	end

	if action == "adddj" then
		if requireDJ(state, player) then
			local username = type(payload) == "table" and getFirst(payload, {"username", "Username", "name", "Name"}) or payload
			username = tostring(username or ""):gsub("%s+", "")
			if username == "" then sendNotice(state, player, "error", "Username is required"); return end
			local ok, userId = pcall(function()
            return Players:GetUserIdFromNameAsync(username)
        end)
			if not ok or not userId then sendNotice(state, player, "error", "Username not found"); return end

			for _, resident in ipairs(residentDJSnapshot(state)) do
				if tonumber(resident.userId) == tonumber(userId) then
					sendNotice(state, player, "error", username .. " is already a resident DJ")
					return
				end
			end
			if state.sessionDJs[userId] then
				sendNotice(state, player, "error", username .. " is already a session DJ")
				return
			end

			state.sessionDJs[userId] = username
			state.accessCache[userId] = nil
			broadcastState(state, false)
			sendNotice(state, player, "success", username .. " added as session DJ")
		end
		return
	end

	if action == "removedj" or action == "revokedj" or action == "deletedj" then
		if requireDJ(state, player) then
			local userId = type(payload) == "table" and tonumber(getFirst(payload, {"userId", "UserId", "id", "Id"})) or tonumber(payload)
			local username = type(payload) == "table" and tostring(getFirst(payload, {"username", "Username", "name", "Name"}) or "") or ""

			if not userId and username ~= "" then
				for sessionUserId, sessionUsername in pairs(state.sessionDJs) do
					if string.lower(tostring(sessionUsername)) == string.lower(username) then
						userId = tonumber(sessionUserId)
						break
					end
				end
			end

			if not userId or not state.sessionDJs[userId] then
				sendNotice(state, player, "error", "Only session DJs can be removed")
				return
			end

			local removedName = state.sessionDJs[userId]
			state.sessionDJs[userId] = nil
			state.accessCache[userId] = nil
			broadcastState(state, false)
			sendNotice(state, player, "success", tostring(removedName) .. " removed from session DJs")
		end
		return
	end

	if action == "seteffect" then
		if requireDJ(state, player) and type(payload) == "table" then
			local effectName = normalizedAction(getFirst(payload, {"effect", "Effect", "name", "Name"}))
			if effectName == "equalizer" or effectName == "eq" then
				local effect = ensureEffect(state, "EqualizerSoundEffect", "CaaEqualizer")
				if payload.enabled ~= nil then effect.Enabled = payload.enabled == true end
				if payload.lowGain ~= nil then effect.LowGain = clampNumber(payload.lowGain, -80, 10, effect.LowGain) end
				if payload.midGain ~= nil then effect.MidGain = clampNumber(payload.midGain, -80, 10, effect.MidGain) end
				if payload.highGain ~= nil then effect.HighGain = clampNumber(payload.highGain, -80, 10, effect.HighGain) end
			elseif effectName == "compressor" then
				local effect = ensureEffect(state, "CompressorSoundEffect", "CaaCompressor")
				if payload.enabled ~= nil then effect.Enabled = payload.enabled == true end
				if payload.threshold ~= nil then effect.Threshold = clampNumber(payload.threshold, -80, 0, effect.Threshold) end
				if payload.ratio ~= nil then effect.Ratio = clampNumber(payload.ratio, 1, 50, effect.Ratio) end
				if payload.attack ~= nil then effect.Attack = clampNumber(payload.attack, 0.001, 1, effect.Attack) end
				if payload.release ~= nil then effect.Release = clampNumber(payload.release, 0.01, 1, effect.Release) end
			elseif effectName == "reverb" then
				local effect = ensureEffect(state, "ReverbSoundEffect", "CaaReverb")
				if payload.enabled ~= nil then effect.Enabled = payload.enabled == true end
				if payload.decayTime ~= nil then effect.DecayTime = clampNumber(payload.decayTime, 0.1, 20, effect.DecayTime) end
				if payload.density ~= nil then effect.Density = clampNumber(payload.density, 0, 1, effect.Density) end
				if payload.wetLevel ~= nil then effect.WetLevel = clampNumber(payload.wetLevel, -80, 10, effect.WetLevel) end
			elseif effectName == "echo" then
				local created = state.sound:FindFirstChild("CaaEcho") == nil
				local effect = ensureEffect(state, "EchoSoundEffect", "CaaEcho")
				if created then
					effect.Delay = 0.35
					effect.Feedback = 0.45
					effect.DryLevel = 0
					effect.WetLevel = -6
				end
				if payload.enabled ~= nil then effect.Enabled = payload.enabled == true end
			elseif effectName == "flanger" or effectName == "flange" then
				local created = state.sound:FindFirstChild("CaaFlanger") == nil
				local effect = ensureEffect(state, "FlangeSoundEffect", "CaaFlanger")
				if created then
					effect.Depth = 0.6
					effect.Mix = 0.6
					effect.Rate = 0.4
				end
				if payload.enabled ~= nil then effect.Enabled = payload.enabled == true end
			elseif effectName == "tremolo" then
				local created = state.sound:FindFirstChild("CaaTremolo") == nil
				local effect = ensureEffect(state, "TremoloSoundEffect", "CaaTremolo")
				if created then
					effect.Depth = 0.8
					effect.Duty = 0.5
					effect.Frequency = 6
				end
				if payload.enabled ~= nil then effect.Enabled = payload.enabled == true end
			elseif effectName == "filter" then
				local effect = ensureEffect(state, "EqualizerSoundEffect", "CaaFilter")
				if payload.enabled ~= nil then effect.Enabled = payload.enabled == true end
				if payload.cutoff ~= nil then
					local cutoff = clampNumber(payload.cutoff, 0, 1, 0.5)
					effect:SetAttribute("Cutoff", cutoff)
					local amount = math.abs(cutoff - 0.5) * 2
					if cutoff < 0.5 then
						effect.LowGain = 0
						effect.MidGain = -amount * 28
						effect.HighGain = -amount * 70
					else
						effect.LowGain = -amount * 70
						effect.MidGain = -amount * 28
						effect.HighGain = 0
					end
				end
			end
			broadcastState(state, false)
		end
		return
	end

	if action == "reseteffects" then
		if requireDJ(state, player) then
			local audio = state.config.Audio or {}
			local eq = ensureEffect(state, "EqualizerSoundEffect", "CaaEqualizer")
			eq.Enabled = audio.EnableEqualizer == true
			eq.LowGain = clampNumber(audio.EQ_LowGain, -80, 10, 0)
			eq.MidGain = clampNumber(audio.EQ_MidGain, -80, 10, 0)
			eq.HighGain = clampNumber(audio.EQ_HighGain, -80, 10, 0)
			local comp = ensureEffect(state, "CompressorSoundEffect", "CaaCompressor")
			comp.Enabled = audio.EnableCompressor == true
			comp.Threshold = clampNumber(audio.Comp_Threshold, -80, 0, -12)
			comp.Ratio = clampNumber(audio.Comp_Ratio, 1, 50, 4)
			comp.Attack = clampNumber(audio.Comp_Attack, 0.001, 1, 0.1)
			comp.Release = clampNumber(audio.Comp_Release, 0.01, 1, 0.1)
			local rev = ensureEffect(state, "ReverbSoundEffect", "CaaReverb")
			rev.Enabled = audio.EnableReverb == true
			rev.DecayTime = clampNumber(audio.Rev_DecayTime, 0.1, 20, 1.2)
			rev.Density = clampNumber(audio.Rev_Density, 0, 1, 0.65)
			rev.WetLevel = clampNumber(audio.Rev_WetLevel, -80, 10, -18)
			for _, fxName in ipairs({ "CaaEcho", "CaaFlanger", "CaaTremolo", "CaaFilter" }) do
				local fx = state.sound:FindFirstChild(fxName)
				if fx then fx.Enabled = false end
			end
			broadcastState(state, false)
		end
		return
	end

	if action == "resyncsound" or action == "reloadsound" then
		if state.current then
			local keepId = state.sound.SoundId
			local keepPosition = state.sound.TimePosition
			local wasPlaying = state.sound.Playing
			state.sound.SoundId = ""
			task.wait()
			state.sound.SoundId = keepId
			state.sound.TimePosition = keepPosition
			if wasPlaying then
				state.sound:Play()
			end
			broadcastState(state, false)
		elseif not state.queue[1] and (state.config.Queue or {}).AutoPlayEnabled ~= false then
			startNext(state)
			sendState(state, player, false, nil)
		end
		return
	end

	if action == "reset" or action == "resetall" or action == "resetdj" then
		if requireDJ(state, player) then
			state.queueLocked = false
			state.queue = {}
			state.queuedByUser = {}
			state.sound.PlaybackSpeed = 1
			clearVote(state)
			broadcastState(state, false)
		end
		return
	end
end

Main.Stop = function(self)
	if not runtime then
		return
	end
	runtime.active = false
	runtime.playToken = runtime.playToken + 1
	disconnectAll(runtime.connections)
	runtime = nil
end

Main.Start = function(self, context)
	if runtime and runtime.active then
		return runtime
	end
	local state = newState(context)
	runtime = state
	ensureAudioEffects(state)

    if not closeHandlerRegistered then
        closeHandlerRegistered = true
        game:BindToClose(function()
            local closingState = runtime
            if not closingState then return end
            closingState.active = false
            local jobs = 0
            for userId, favorites in pairs(closingState.favorites) do
                if closingState.favoritesLoaded[userId] == true and closingState.favoriteDirty[userId] then
                    jobs += 1
                    local snapshot = cloneFavoriteSet(favorites)
                    task.spawn(function()
                        writeFavoriteSnapshot(closingState, userId, snapshot, false)
                        jobs -= 1
                    end)
                end
            end
            local deadline = os.clock() + 8
            while jobs > 0 and os.clock() < deadline do task.wait(0.05) end
        end)
    end

	table.insert(state.connections, state.remotes.Command.OnServerEvent:Connect(function(player, first, second, third)
		handleCommand(state, player, first, second, third)
	end))

	table.insert(state.connections, state.remotes.RequestState.OnServerEvent:Connect(function(player)
        if state.favoritesLoaded[player.UserId] ~= true then
            task.spawn(loadFavorites, state, player)
        end
		sendState(state, player, true, nil)
		sendCatalogChunked(state, player)
	end))

    local function preparePlayer(player)
        task.spawn(function()
            loadFavorites(state, player)
        end)
    end
    for _, player in ipairs(Players:GetPlayers()) do preparePlayer(player) end
    table.insert(state.connections, Players.PlayerAdded:Connect(preparePlayer))

	table.insert(state.connections, state.sound.Ended:Connect(function()
		if not state.active or not state.current then
			return
		end

		local soundIds = state.current.soundIds or state.current.SoundIds or {}
		if state.currentPart < #soundIds then
			state.currentPart = state.currentPart + 1
			playCurrentPart(state)
		else
			state.current = nil
			state.currentPart = 0
			startNext(state)
		end
	end))


	table.insert(state.connections, Players.PlayerRemoving:Connect(function(player)
		state.lastCommandAt[player] = nil
		state.accessCache[player.UserId] = nil
        local userId = player.UserId
        local snapshot = cloneFavoriteSet(state.favorites[userId])
        local loaded = state.favoritesLoaded[userId] == true
        state.favoriteSaveTokens[userId] = (state.favoriteSaveTokens[userId] or 0) + 1
        if loaded and state.favoriteDirty[userId] then


            writeFavoriteSnapshot(state, userId, snapshot, false)
        end
        state.favorites[userId] = nil
        state.favoritesLoaded[userId] = nil
        state.favoriteDirty[userId] = nil
        state.favoriteSaveTokens[userId] = nil
        state.favoriteMutations[userId] = nil
        state.favoriteRetryAt[userId] = nil
        state.sessionDJs[userId] = nil
        state.queuedByUser[userId] = nil
		if state.vote then
			state.vote.voters[player.UserId] = nil
			broadcastVote(state)
		end
	end))

	task.spawn(function()
		local broadcastCounter = 0
		while state.active do
			task.wait(1)
			if not state.active then
				break
			end

			if state.vote and os.clock() >= state.vote.endsAt then
				clearVote(state)
			end

			if state.current then
				-- Client udah interpolate posisi lagu sendiri pakai serverTime,
				-- jadi gak perlu broadcast full state tiap detik ke semua orang.
				-- Broadcast rutin cukup tiap 5 detik; perubahan beneran (skip,
				-- queue, vote, dj mode, dll) tetap instan lewat broadcastState
				-- yang dipanggil langsung di fungsi masing-masing.
				broadcastCounter += 1
				if broadcastCounter >= 5 then
					broadcastCounter = 0
					broadcastState(state, false)
				end
			elseif #state.queue > 0 or (state.config.Queue or {}).AutoPlayEnabled ~= false then
				startNext(state)
			end
		end
	end)


	task.defer(function()
		broadcastState(state, true)
		for _, player in ipairs(Players:GetPlayers()) do
			sendCatalogChunked(state, player)
		end
		startNext(state)
	end)


	return state
end

return Main]]></ProtectedString>
