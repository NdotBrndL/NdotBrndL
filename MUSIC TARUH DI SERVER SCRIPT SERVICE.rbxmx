local function updateScale()
	local camera = workspace.CurrentCamera
	if not camera or not uiScale then return end
	local viewport = camera.ViewportSize
	-- UKURAN PANEL (kecilkan angka = UI makin kecil)
	local PANEL_W_FRACTION = 0.5   -- panel maksimal 50% lebar layar
	local PANEL_H_FRACTION = 0.62  -- panel maksimal 62% tinggi layar
	local DESKTOP_MAX_SCALE = 0.65 -- skala maksimal di PC (sebelumnya 1.0)
	local MOBILE_SCALE_MULT = 0.8  -- pengali skala maksimal di HP (sebelumnya 1.0)
	local fitX = math.max(0.1, viewport.X * PANEL_W_FRACTION / 950)
	local fitY = math.max(0.1, viewport.Y * PANEL_H_FRACTION / 560)
	local isDesktopInput = UserInputService.KeyboardEnabled and UserInputService.MouseEnabled
	local targetScale = uiScale and uiScale:GetAttribute("TargetScale") or 0.69
	local maxScale = isDesktopInput and DESKTOP_MAX_SCALE or targetScale * MOBILE_SCALE_MULT
	local minScale = isDesktopInput and 0.4 or 0.25
	state.baseScale = math.clamp(math.min(maxScale, fitX, fitY), minScale, maxScale)
	if state.panelOpen then uiScale.Scale = state.baseScale end
	if notificationScale then
		local noticeScale = math.min(viewport.X / 1920, viewport.Y / 1080)
		notificationScale.Scale = math.clamp(noticeScale, 0.42, 1)
		notificationRoot.Position = UDim2.new(1, -math.max(8, math.floor(viewport.X * 0.008)), 0.5, 0)
	end
end
updateScale()
if workspace.CurrentCamera then
	connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), updateScale)
end
connect(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
	updateScale()
end)




do
	local dragging = false
	local activeInput
	local activeStateConnection
	local dragStart
	local startPosition

	local function cancelDrag()
		dragging = false
		activeInput = nil
		dragStart = nil
		startPosition = nil
		if activeStateConnection then
			activeStateConnection:Disconnect()
			activeStateConnection = nil
		end
	end
	registerTransientInputCancel(cancelDrag)

	local dragSurface = header:FindFirstChild("Title") or header
	dragSurface.Active = true
	connect(dragSurface.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		cancelDrag()
		dragging = true
		activeInput = input
		dragStart = ptOf(input)
		startPosition = main.Position
		activeStateConnection = input.Changed:Connect(function()
			local inputState = input.UserInputState
			if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
				cancelDrag()
			end
		end)
	end)
	connect(UserInputService.InputChanged, function(input)
		if not dragging or not activeInput or not dragStart or not startPosition then return end
		local matchesMouse = activeInput.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseMovement
		local matchesTouch = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput
		if matchesMouse or matchesTouch then
			local delta = ptOf(input) - dragStart
			main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
		end
	end)
	connect(UserInputService.InputEnded, function(input)
		if input == activeInput
			or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseButton1) then
			cancelDrag()
		end
	end)
end

-- ═══ DESAIN ULANG HEADER ═══
-- Emblem not di kotak perak, judul dua baris + equalizer mini hidup, tab bergaya "rail" dengan garis
-- penanda geser (bukan pil), tombol tutup kotak bergaris. Palet tetap hitam / abu / perak.
local HEADER_SILVER = Color3.fromRGB(226, 226, 226)
do
	local function addCorner(parent, radius)
		local c = parent:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, radius)
		c.Parent = parent
		return c
	end
	local function addStroke(parent, color, transparency, thickness)
		local st = parent:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
		st.Color = color
		st.Transparency = transparency
		st.Thickness = thickness or 1
		st.Parent = parent
		return st
	end

	-- latar header: gambar gelombang lama disembunyikan, diganti kilau gradasi halus + garis aksen bawah
	local headerBg = header:FindFirstChild("HeaderBg")
	if headerBg then headerBg.Visible = false end
	header.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
	header.BackgroundTransparency = 0.18
	local sheen = header:FindFirstChild("CaaHeaderSheen") or Instance.new("UIGradient")
	sheen.Name = "CaaHeaderSheen"
	sheen.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(200, 200, 200)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 140, 140)),
	})
	sheen.Parent = header

	local accent = Instance.new("Frame")
	accent.Name = "CaaHeaderAccent"
	accent.BackgroundColor3 = HEADER_SILVER
	accent.BorderSizePixel = 0
	accent.AnchorPoint = Vector2.new(0.5, 1)
	accent.Position = UDim2.new(0.5, 0, 1, 0)
	accent.Size = UDim2.new(1, -36, 0, 1)
	accent.ZIndex = 3
	local accentGrad = Instance.new("UIGradient")
	accentGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.55),
		NumberSequenceKeypoint.new(0.5, 0.82),
		NumberSequenceKeypoint.new(0.8, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	accentGrad.Parent = accent
	accent.Parent = header

	-- emblem not
	local headerTitle = header:FindFirstChild("Title")
	local musicIcon = headerTitle and headerTitle:FindFirstChild("MusicIcon")
	local emblem = Instance.new("Frame")
	emblem.Name = "CaaEmblem"
	emblem.AnchorPoint = Vector2.new(0, 0.5)
	emblem.Position = UDim2.new(0, 14, 0.5, 0)
	emblem.Size = UDim2.fromOffset(34, 34)
	emblem.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	emblem.BorderSizePixel = 0
	emblem.ZIndex = 5
	addCorner(emblem, 10)
	addStroke(emblem, HEADER_SILVER, 0.5, 1)
	local emblemGrad = Instance.new("UIGradient")
	emblemGrad.Rotation = 55
	emblemGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 70, 70)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 18, 18)),
	})
	emblemGrad.Parent = emblem
	emblem.Parent = header
	if musicIcon then
		musicIcon.Parent = emblem
		musicIcon.AnchorPoint = Vector2.new(0.5, 0.5)
		musicIcon.Position = UDim2.fromScale(0.5, 0.5)
		musicIcon.Size = UDim2.fromScale(1, 1)
		musicIcon.TextSize = 22
		musicIcon.TextXAlignment = Enum.TextXAlignment.Center
		musicIcon.TextYAlignment = Enum.TextYAlignment.Center
		musicIcon.TextColor3 = Color3.fromRGB(245, 245, 245)
		musicIcon.ZIndex = 6
	end

	-- judul + subjudul + equalizer mini
	if headerTitle then
		headerTitle.Position = UDim2.fromOffset(60, 7)
		headerTitle.Size = UDim2.fromOffset(190, 24)
		headerTitle.TextSize = 19
		headerTitle.TextXAlignment = Enum.TextXAlignment.Left
		headerTitle.TextYAlignment = Enum.TextYAlignment.Center
	end
	local eq = Instance.new("Frame")
	eq.Name = "CaaHeaderEq"
	eq.BackgroundTransparency = 1
	eq.Position = UDim2.fromOffset(61, 32)
	eq.Size = UDim2.fromOffset(25, 12)
	eq.ZIndex = 5
	eq.Parent = header
	local eqBars = {}
	for i = 1, 5 do
		local bar = Instance.new("Frame")
		bar.Name = "Bar" .. i
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.Position = UDim2.new(0, (i - 1) * 5, 1, 0)
		bar.Size = UDim2.fromOffset(3, 4)
		bar.BackgroundColor3 = HEADER_SILVER
		bar.BackgroundTransparency = 0.15
		bar.BorderSizePixel = 0
		bar.ZIndex = 5
		addCorner(bar, 1)
		bar.Parent = eq
		eqBars[i] = bar
	end
	local sub = Instance.new("TextLabel")
	sub.Name = "CaaHeaderSub"
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.DenkOne
	sub.Text = "CAA  ·  AUDIO PLAYER"
	sub.TextSize = 9
	sub.TextColor3 = Color3.fromRGB(150, 150, 150)
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.TextYAlignment = Enum.TextYAlignment.Center
	sub.Position = UDim2.fromOffset(93, 32)
	sub.Size = UDim2.fromOffset(160, 12)
	sub.ZIndex = 5
	sub.Parent = header
	local eqClock, eqAccum = 0, 0
	connect(RunService.Heartbeat, function(dt)
		eqAccum += dt
		if eqAccum < 1 / 30 then return end
		eqClock += eqAccum
		eqAccum = 0
		if not eq.Visible or not main.Visible then return end
		for i, bar in ipairs(eqBars) do
			local v = 0.5 + 0.5 * math.sin(eqClock * (3.1 + i * 0.9) + i * 1.7)
			local v2 = 0.5 + 0.5 * math.sin(eqClock * (1.3 + i * 0.4) + i * 0.6)
			local h = 3 + math.floor((v * 0.65 + v2 * 0.35) * 9 + 0.5)
			bar.Size = UDim2.fromOffset(3, h)
		end
	end)

	-- tab: rail (tanpa pil/kotak), penanda geser berupa kolom cahaya + garis bawah
	tabContainer.Position = UDim2.new(0.5, -110, 0.5, -17)
	tabContainer.Size = UDim2.fromOffset(220, 34)
	tabContainer.BackgroundTransparency = 1
	local tabStroke = tabContainer:FindFirstChildOfClass("UIStroke")
	if tabStroke then tabStroke:Destroy() end
	local rail = Instance.new("Frame")
	rail.Name = "CaaTabRail"
	rail.BackgroundColor3 = HEADER_SILVER
	rail.BackgroundTransparency = 0.86
	rail.BorderSizePixel = 0
	rail.AnchorPoint = Vector2.new(0, 1)
	rail.Position = UDim2.new(0, 0, 1, 0)
	rail.Size = UDim2.new(1, 0, 0, 1)
	rail.ZIndex = 1
	rail.Parent = tabContainer
	for _, tab in ipairs({homeTab, libraryTab, djTab}) do
		tab.Text = string.upper(tab.Text)
		tab.TextSize = 12
	end
	if slideIndicator then
		for _, d in ipairs(slideIndicator:GetChildren()) do
			if d:IsA("UIStroke") or d:IsA("UIGradient") then d:Destroy() end
		end
		slideIndicator.BackgroundColor3 = HEADER_SILVER
		slideIndicator.BackgroundTransparency = 0
		slideIndicator.BorderSizePixel = 0
		addCorner(slideIndicator, 4)
		local glow = Instance.new("UIGradient")
		glow.Rotation = 90
		glow.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.78),
		})
		glow.Parent = slideIndicator
		local line = Instance.new("Frame")
		line.Name = "Line"
		line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		line.BorderSizePixel = 0
		line.AnchorPoint = Vector2.new(0.5, 1)
		line.Position = UDim2.new(0.5, 0, 1, 0)
		line.Size = UDim2.new(1, -24, 0, 2)
		line.ZIndex = slideIndicator.ZIndex + 1
		addCorner(line, 1)
		line.Parent = slideIndicator
	end

	-- tombol tutup: kotak bergaris
	closeButton.AnchorPoint = Vector2.new(0, 0)
	closeButton.Position = UDim2.new(1, -50, 0.5, -17)
	closeButton.Size = UDim2.fromOffset(34, 34)
	closeButton.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
	closeButton.BackgroundTransparency = 0.1
	addCorner(closeButton, 10)
	addStroke(closeButton, HEADER_SILVER, 0.62, 1)
	local closeIcon = closeButton:FindFirstChild("Icon")
	if closeIcon then closeIcon.Size = UDim2.fromOffset(14, 14) end
end

local currentTab = "Home"
local function layoutTabs()
	if state.isDJ then
		homeTab.Position = UDim2.fromScale(0, 0)
		homeTab.Size = UDim2.fromScale(1 / 3, 1)
		libraryTab.Position = UDim2.fromScale(1 / 3, 0)
		libraryTab.Size = UDim2.fromScale(1 / 3, 1)
		djTab.Position = UDim2.fromScale(2 / 3, 0)
		djTab.Size = UDim2.fromScale(1 / 3, 1)
		djTab.Visible = true
	else
		homeTab.Position = UDim2.fromScale(0, 0)
		homeTab.Size = UDim2.fromScale(0.5, 1)
		libraryTab.Position = UDim2.fromScale(0.5, 0)
		libraryTab.Size = UDim2.fromScale(0.5, 1)
		djTab.Visible = false
	end
end

local function showTab(name)
	if name == "DJ" and not state.isDJ then name = "Home" end
	currentTab = name
	layoutTabs()
	homeView.Visible = name == "Home"
	libraryView.Visible = name == "Library"
	djView.Visible = name == "DJ"
	local TAB_ON, TAB_OFF = Color3.fromRGB(255, 255, 255), Color3.fromRGB(165, 165, 165)
	homeTab.TextColor3 = name == "Home" and TAB_ON or TAB_OFF
	libraryTab.TextColor3 = name == "Library" and TAB_ON or TAB_OFF
	djTab.TextColor3 = name == "DJ" and TAB_ON or TAB_OFF
	homeTab.TextTransparency = 0
	libraryTab.TextTransparency = 0
	djTab.TextTransparency = 0
	if slideIndicator then
		local target = name == "Home" and homeTab or (name == "Library" and libraryTab or djTab)
		TweenService:Create(slideIndicator, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Position = UDim2.new(target.Position.X.Scale, target.Position.X.Offset, 0, 0),
			Size = UDim2.new(target.Size.X.Scale, target.Size.X.Offset, 1, 0),
		}):Play()
	end
end
bindResponsiveActivate(homeTab, function() showTab("Home") end)
bindResponsiveActivate(libraryTab, function() showTab("Library") end)
bindResponsiveActivate(djTab, function() if state.isDJ then showTab("DJ") end end)
showTab("Home")


