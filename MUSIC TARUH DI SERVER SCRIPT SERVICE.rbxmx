				<Properties>
					<ProtectedString name="Source"><![CDATA[local print = function() end
local warn = function() end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
if not player then
    return
end

local playerGui = player:WaitForChild("PlayerGui", 30)
local topbarFolder = ReplicatedStorage:WaitForChild("TopbarPlus", 30)
local iconModule = topbarFolder and topbarFolder:WaitForChild("Icon", 20)
if not playerGui or not iconModule then
    return
end

local ok, Icon = pcall(require, iconModule)
if not ok or type(Icon) ~= "table" then
    return
end

local old = rawget(_G, "CaaMusicTopbarIcon")
if old then
    pcall(function()
        old:destroy()
    end)
end

local icon = Icon.new()
    :setLabel("")
    :setImage("rbxassetid://476273349")
    :setImageScale(0.5)
rawset(_G, "CaaMusicTopbarIcon", icon)

local target = playerGui:FindFirstChild("CaaMusicPlayerGui") or playerGui:WaitForChild("CaaMusicPlayerGui", 30)
if not target then
	pcall(function()
		icon:destroy()
	end)
	return
end

-- Forward-declare dulu, karena rebindTarget di bawah ini butuh manggil
-- syncIconFromPanel walau fungsinya baru "diisi" belakangan di bawah.
local syncIconFromPanel

-- SELF-HEAL: kalau target ini ternyata GUI yang kalah election (dari fix di
-- CaaMusicClient) dan ke-Destroy, re-fetch instance yang beneran hidup
-- biar topbar gak nyangkut ke referensi mati selamanya.
local function rebindTarget(newTarget)
	target = newTarget
	target:GetAttributeChangedSignal("PanelOpen"):Connect(syncIconFromPanel)
	task.spawn(syncIconFromPanel)
end

target.AncestryChanged:Connect(function(_, parent)
	if parent then return end
	task.spawn(function()
		-- Wait briefly for the election winner to settle, then rebind.
		task.wait(0.6)
		local fresh = playerGui:FindFirstChild("CaaMusicPlayerGui")
		if not fresh then
			fresh = playerGui:WaitForChild("CaaMusicPlayerGui", 10)
		end
		if fresh and fresh ~= target then
			rebindTarget(fresh)
		end
	end)
end)

local syncing = false
local clickDebounce = false

local function setOpen(open)
	-- If target was destroyed, try to find a live one before doing anything.
	if not target or not target.Parent then
		local fresh = playerGui:FindFirstChild("CaaMusicPlayerGui")
		if fresh then
			rebindTarget(fresh)
		end
	end
	local toggle = rawget(_G, "CaaMusicPlayerToggle")
	if type(toggle) ~= "function" then
		if target and target.Parent and target:GetAttribute("CaaMusicReady") ~= true then
			local readySignal = target:GetAttributeChangedSignal("CaaMusicReady")
			local timedOut = false
			task.delay(3, function() timedOut = true end)
			while target and target.Parent and target:GetAttribute("CaaMusicReady") ~= true and not timedOut do
				readySignal:Wait()
			end
		end
		toggle = rawget(_G, "CaaMusicPlayerToggle")
	end
    local usedToggle = false
    if type(toggle) == "function" then
        local ok, err = pcall(toggle, open)
        if ok then
            usedToggle = true
        end
    end
    if not usedToggle then
        target.Enabled = true
        local main = target:FindFirstChild("MainFrame")
        local overlay = target:FindFirstChild("Overlay")
        if main then
            main.Visible = open
            main.Active = open
        end
        if overlay then
            overlay.Visible = open
            overlay.Active = open
        end
        target:SetAttribute("PanelOpen", open)
    end
end

icon.selected:Connect(function()
    if not syncing and not clickDebounce then
        clickDebounce = true
        setOpen(true)
        task.delay(0.1, function() clickDebounce = false end)
    end
end)
icon.deselected:Connect(function()
    if not syncing and not clickDebounce then
        clickDebounce = true
        setOpen(false)
        task.delay(0.1, function() clickDebounce = false end)
    end
end)

syncIconFromPanel = function()
	local open = target:GetAttribute("PanelOpen") == true
    syncing = true
    if open then
        pcall(function()
            icon:select()
        end)
    else
        pcall(function()
            icon:deselect()
        end)	
    end
    syncing = false
end

target:GetAttributeChangedSignal("PanelOpen"):Connect(syncIconFromPanel)
syncIconFromPanel()
]]></ProtectedString>
