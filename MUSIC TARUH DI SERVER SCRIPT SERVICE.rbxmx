}








local function extractId(str)
	if str == nil or str == "" then return "" end
	local id = tostring(str):match("rbxassetid://(%d+)")
	if id then return id end
	id = tostring(str):match("^(%d+)$")
	if id then return id end
	return ""
end
local function isValidImageId(imageId)
	if imageId == nil or imageId == "" then return false end
	local id = extractId(imageId)
	return id ~= "" and id ~= "0"
end
function M.getSoundIds(track)
	if track.SoundIds and type(track.SoundIds) == "table" then
		local ids = {}
		for _, soundId in ipairs(track.SoundIds) do
			local id = extractId(soundId)
			if id ~= "" then
				table.insert(ids, id)
			end
		end
		return ids
	elseif track.SoundId then
		local id = extractId(track.SoundId)
		if id ~= "" then
			return { id }
		end
	end
	return {}
end
function M.isMultiPart(track)
	return track.SoundIds and type(track.SoundIds) == "table" and #track.SoundIds > 1
end
function M.getFirstSoundId(track)
	local ids = M.getSoundIds(track)
	return ids[1] or ""
end
function M.flat(filterCollectionName)
	local list = {}
	for _, col in ipairs(M.Collections) do
		if (not filterCollectionName) or (col.name == filterCollectionName) then
			for _, t in ipairs(col.tracks or {}) do
				local soundIds = M.getSoundIds(t)
				local imageId = extractId(t.ImageId)
				local firstId = soundIds[1] or ""
				if firstId ~= "" then
					table.insert(list, {
						name = t.SongName or "Unknown Track",
						id = firstId,
						soundIds = soundIds,
						isMultiPart = #soundIds > 1,
						partCount = #soundIds,
						col = col.name,
						imageId = isValidImageId(t.ImageId) and imageId or nil,
						playbackSpeed = t.PlaybackSpeed or 1.0
					})
				end
			end
		end
	end
	return list
end
function M.formatTime(secs)
	secs = math.max(0, math.floor(secs or 0))
	local m = math.floor(secs/60)
	local s = secs % 60
	return string.format("%02d:%02d", m, s)
end
M.Catalog = M.flat(nil)
return M]]></ProtectedString>
