local COLLECTION_FAVORITE_PREFIX = "@collection:"

local function collectionFavoriteKey(value)
	local name = tostring(value or ""):match("^%s*(.-)%s*$") or ""
	if name == "" then return nil end
	return COLLECTION_FAVORITE_PREFIX .. lower(name)
end

local function isFavorite(track)
	local id = trackId(track)
	return id ~= "" and state.favorites[id] == true
end

local function isCollectionFavorite(name)
	local key = collectionFavoriteKey(name)
	return key ~= nil and state.favorites[key] == true
end

local HEART_OUTLINE = "rbxassetid://74169319275784"
local HEART_FILLED = "rbxassetid://13321877099"
local TRASH_ICON = "rbxassetid://14002617467"



local function ensureInsetGlyph(imageTarget, glyphName)
	if not imageTarget or not (imageTarget:IsA("ImageButton") or imageTarget:IsA("ImageLabel")) then return nil end
	local glyph = imageTarget:FindFirstChild(glyphName)
	if not glyph then
		glyph = Instance.new("ImageLabel")
		glyph.Name = glyphName
		glyph.AnchorPoint = Vector2.new(0.5, 0.5)
		glyph.Position = UDim2.fromScale(0.5, 0.5)
		glyph.Size = UDim2.fromScale(1, 1)
		glyph.BackgroundTransparency = 1
		glyph.BorderSizePixel = 0
		glyph.ScaleType = Enum.ScaleType.Fit
		glyph.Active = false
		glyph.Selectable = false
		glyph.ZIndex = imageTarget.ZIndex + 1
		glyph.Parent = imageTarget
	end
	imageTarget.ImageTransparency = 1
	return glyph
end

local function applyFavoriteVisual(button, active)
	if not button then return end
	local nestedIcon = button:FindFirstChild("Icon", true)
	local imageTarget = nestedIcon and (nestedIcon:IsA("ImageLabel") or nestedIcon:IsA("ImageButton")) and nestedIcon
		or ((button:IsA("ImageButton") or button:IsA("ImageLabel")) and button or nil)
	local label = button:FindFirstChild("Label", true)
	local color = active and Color3.fromRGB(213, 213, 213) or Color3.fromRGB(238, 238, 238)

	if imageTarget then
		local glyph = ensureInsetGlyph(imageTarget, "CaaFavoriteGlyph")
		if glyph then
			glyph.Image = active and HEART_FILLED or HEART_OUTLINE
			glyph.ImageColor3 = color
			glyph.ImageTransparency = active and 0 or 0.12
			glyph.Size = active and UDim2.fromScale(0.74, 0.74) or UDim2.fromScale(1, 1)
		end
	end
	if label and label:IsA("TextLabel") then
		label.Text = active and "Liked" or "Like"
		label.TextColor3 = color
	end
	button:SetAttribute("Liked", active == true)
end

local function configureTrashButton(button)
	if not button or not (button:IsA("ImageButton") or button:IsA("ImageLabel")) then return end
	button.Image = TRASH_ICON
	local glyph = ensureInsetGlyph(button, "CaaTrashGlyph")
	if not glyph then return end
	glyph.Image = TRASH_ICON
	glyph.ImageColor3 = Color3.fromRGB(106, 106, 106)
	glyph.ImageTransparency = 0
	glyph.Size = UDim2.fromScale(0.72, 0.72)
end

local function refreshFavoriteViews()
	applyFavoriteVisual(nowLike, currentTrack and isFavorite(currentTrack) or false)
	if renderQueue then
		renderQueue(first(state.packet, {"queue", "Queue"}, {}))
	end
	if updateCollectionCards then updateCollectionCards() end
	if renderTracks and trackContainer and trackContainer.Visible then renderTracks() end
	if renderCustomSongs then renderCustomSongs(state.packet) end
end

local function toggleFavorite(track)
	local id = trackId(track)
	if id == "" or state.favoriteBusy[id] then return end

	local enabled = not (state.favorites[id] == true)
	state.favoriteBusy[id] = true
	state.favoritePending[id] = {value = enabled, expiresAt = os.clock() + 3}
	state.favorites[id] = enabled or nil
	refreshFavoriteViews()
	notify(enabled and "success" or "error", enabled and "ADDED TO LIKED" or "REMOVED FROM LIKED", trackName(track), track, 3.2)
	fire("togglefavorite", {id = id, enabled = enabled})

	task.delay(0.25, function()
		state.favoriteBusy[id] = nil
	end)
end
bindResponsiveActivate(nowLike, function() if currentTrack then toggleFavorite(currentTrack) end end)
state.CaaDoReload = function()
	notify("success", "RELOADING", "Re-syncing the music state", nil, 2.6)
	requestStateRemote:FireServer()
	if musicSound then
		local keepId = musicSound.SoundId
		local keepPosition = musicSound.TimePosition
		local wasPlaying = musicSound.Playing
		musicSound.SoundId = ""
		task.wait()
		musicSound.SoundId = keepId
		musicSound.TimePosition = keepPosition
		if wasPlaying then
			musicSound:Play()
		end
	end
end
bindResponsiveActivate(reloadButton, state.CaaDoReload)

-- Cleanup all connections when the GUI is unparented or script is destroyed
connect(gui.AncestryChanged, function(_, parent)
	if not parent then
		for i = #connections, 1, -1 do
			connections[i]:Disconnect()
			connections[i] = nil
		end
	end
end)

script.Destroying:Connect(function()
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	connections = {}
end)
state.CaaDoSkip = function() if state.isDJ then fire("skip") else fire("voteskip") end end
bindResponsiveActivate(skipButton, state.CaaDoSkip)

local function setLocalVolume(value, keepLastVolume)
	value = math.clamp(tonumber(value) or 1, 0, 1)
	state.localVolume = value
	state.muted = value <= 0.0001
	if value > 0 and keepLastVolume ~= true then
		state.lastVolume = value
	end

	volumeValue.Text = state.muted and "MUTED" or string.format("%d%%", math.floor(value * 100 + 0.5))
	local fill = localSliderBg:FindFirstChild("SliderFill")
	local knob = localSliderBg:FindFirstChild("SliderKnob")
	if fill then fill.Size = UDim2.new(value, 0, 1, 0) end
	if knob then
		knob.Position = UDim2.new(value, -math.floor(knob.Size.X.Offset / 2), knob.Position.Y.Scale, knob.Position.Y.Offset)
	end


	if localVolumeGroup then
		localVolumeGroup.Volume = state.muted and 0 or value
	end



	if musicSound then
		if musicSound.SoundGroup ~= localVolumeGroup then
			musicSound.SoundGroup = localVolumeGroup
		end

		state.writingLocalMusicVolume = true
		if state.muted then
			local current = tonumber(musicSound.Volume) or 0
			if current > 0.0001 then
				state.globalMusicVolume = current
			end
			musicSound.Volume = 0
		else
			local packetVolume = tonumber(first(state.packet, {"volume", "Volume"}, nil))
			local restoreVolume = packetVolume or state.globalMusicVolume or 0.5
			state.globalMusicVolume = math.clamp(restoreVolume, 0, 10)
			musicSound.Volume = state.globalMusicVolume
		end
		state.writingLocalMusicVolume = false
	end
end

local volumeToggleLockedUntil = 0
bindResponsiveActivate(volumeIconButton, function()
	local now = os.clock()
	if now < volumeToggleLockedUntil then return end
	volumeToggleLockedUntil = now + 0.28

	if state.muted or state.localVolume <= 0.0001 then
		setLocalVolume(math.clamp(state.lastVolume > 0 and state.lastVolume or 1, 0.05, 1))
	else
		state.lastVolume = math.clamp(state.localVolume, 0.05, 1)
		setLocalVolume(0, true)
	end
end)

local function bindSlider(bg, minValue, maxValue, onChange, onCommit)
	local hit = bg:FindFirstChild("SliderButton")
	if not hit then return end
	local dragging = false
	local activeInput
	local activeStateConnection
	local lastValue = minValue
	local lastRatio = 0

	local function cancelSlider(commit)
		local shouldCommit = dragging and commit == true
		dragging = false
		activeInput = nil
		if activeStateConnection then
			activeStateConnection:Disconnect()
			activeStateConnection = nil
		end
		if shouldCommit and onCommit then onCommit(lastValue, lastRatio) end
	end
	registerTransientInputCancel(function() cancelSlider(false) end)

	local function fromX(x)
		local width = math.max(1, bg.AbsoluteSize.X)
		local ratio = math.clamp((x - bg.AbsolutePosition.X) / width, 0, 1)
		local value = minValue + (maxValue - minValue) * ratio
		lastValue, lastRatio = value, ratio
		onChange(value, ratio)
	end
	connect(hit.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		cancelSlider(false)
		dragging = true
		activeInput = input
		fromX(ptOf(input).X)
		activeStateConnection = input.Changed:Connect(function()
			local inputState = input.UserInputState
			if inputState == Enum.UserInputState.End then
				cancelSlider(true)
			elseif inputState == Enum.UserInputState.Cancel then
				cancelSlider(false)
			end
		end)
	end)
	connect(UserInputService.InputChanged, function(input)
		if not dragging or not activeInput then return end
		local matchesMouse = activeInput.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseMovement
		local matchesTouch = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput
		if matchesMouse or matchesTouch then fromX(ptOf(input).X) end
	end)
	connect(UserInputService.InputEnded, function(input)
		if input == activeInput
			or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseButton1) then
			cancelSlider(true)
		end
	end)
end
bindSlider(localSliderBg, 0, 1, function(value) setLocalVolume(value) end)
setLocalVolume(1)

local queueRows = {}
for _, item in ipairs(queueScroll:GetChildren()) do
	if item:IsA("Frame") and item.Name:match("^QueueItem") then table.insert(queueRows, item) end
end
table.sort(queueRows, function(a, b)
	return (tonumber(a.Name:match("%d+")) or 0) < (tonumber(b.Name:match("%d+")) or 0)
end)
local queueTemplate = queueRows[1]
local boundQueueRows = setmetatable({}, {__mode = "k"})

local function bindQueueRow(row)
	if boundQueueRows[row] then return end
	boundQueueRows[row] = true
	local remove = row:FindFirstChild("RemoveButton")
	if remove then
		configureTrashButton(remove)
		bindResponsiveActivate(remove, function()
			if not state.isDJ then return end
			local trackIndex = row:GetAttribute("TrackIndex")
			if not trackIndex then return end
			local now = os.clock()
			local busyUntil = tonumber(row:GetAttribute("RemoveBusyUntil")) or 0
			if now < busyUntil then return end
			row:SetAttribute("RemoveBusyUntil", now + 0.45)
			fire("removequeue", {index = trackIndex})
		end)
	end

	local like = row:FindFirstChild("LikeButton")
	if like then
		connect(like.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				state.suppressQueueUntil = os.clock() + 0.35
			end
		end)
		bindResponsiveActivate(like, function()
			local packetQueue = first(state.packet, {"queue", "Queue"}, {})
			local trackIndex = row:GetAttribute("TrackIndex")
			local track = trackIndex and packetQueue[trackIndex]
			if track then
				toggleFavorite(track)
				applyFavoriteVisual(like, isFavorite(track))
			end
		end)
	end
end

for _, row in ipairs(queueRows) do
	bindQueueRow(row)
end

local function ensureQueueRows(requiredCount)
	requiredCount = math.max(0, math.floor(tonumber(requiredCount) or 0))
	if not queueTemplate then return end
	while #queueRows < requiredCount do
		local index = #queueRows + 1
		local row = queueTemplate:Clone()
		row.Name = "QueueItem" .. tostring(index)
		row.LayoutOrder = index
		row.Visible = false
		row:SetAttribute("TrackIndex", nil)
		row.Parent = queueScroll
		queueRows[index] = row
		bindQueueRow(row)
	end
end

renderQueue = function(queue)
	queue = type(queue) == "table" and queue or {}
	if state.CaaHomeSystem then
		local okHome, errHome = pcall(state.CaaHomeSystem.Update, currentTrack, queue)
		if not okHome then warn("[CaaMusic] Update Beranda gagal:", errHome) end
	end
	if state.CaaDualDeck then
		local okDeck, errDeck = pcall(state.CaaDualDeck.Update, currentTrack, queue)
		if not okDeck then warn("[CaaMusic] Update Dual Deck gagal:", errDeck) end
	end
	ensureQueueRows(#queue)
	queueCountBadge.Text = tostring(#queue)
	queueScroll.Visible = #queue > 0
	if queueEmptyState then queueEmptyState.Visible = #queue == 0 end
	for index, row in ipairs(queueRows) do
		local track = queue[index]
		row.Visible = track ~= nil
		if track then
			row.LayoutOrder = index
			row:SetAttribute("TrackIndex", index)
			local number = row:FindFirstChild("Number")
			local nameLabel = row:FindFirstChild("TrackName")
			local collectionLabel = row:FindFirstChild("PlaylistLine")
			local requester = row:FindFirstChild("QueuerName")
			local thumb = row:FindFirstChild("Thumb")
			local remove = row:FindFirstChild("RemoveButton")
			local like = row:FindFirstChild("LikeButton")
			if number then number.Text = tostring(index) end
			if nameLabel then nameLabel.Text = trackName(track) end
			if collectionLabel then collectionLabel.Text = "Playlist " .. trackCollection(track) end
			if requester then
				requester.RichText = true
				requester.Text = requesterDisplay(track)
			end
			if remove then
				remove.Visible = state.isDJ
				remove.Active = state.isDJ
				pcall(function() remove.Interactable = state.isDJ end)
			end
			if thumb then
				local cover = thumb:FindFirstChild("TrackImage") or thumb:FindFirstChild("CoverImage")
				local default = thumb:FindFirstChild("DefaultImage")
				local image = trackImage(track)
				if cover then cover.Image = image; cover.Visible = image ~= "" end
				if default then default.Visible = image == "" end
			end
			applyFavoriteVisual(like, isFavorite(track))
		else
			row:SetAttribute("TrackIndex", nil)
			row:SetAttribute("RemoveBusyUntil", nil)
			local remove = row:FindFirstChild("RemoveButton")
			if remove then remove.Visible = false end
		end
	end
end


