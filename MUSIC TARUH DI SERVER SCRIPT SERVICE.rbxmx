					<Item class="ModuleScript" referent="RBXA5742C9F95D647B99196AB4CC3B3922B">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Module = {}

function Module.new(ctx)
	local trackContainer = ctx.trackContainer
	local trackScroll = ctx.trackScroll
	local playlistBanner = ctx.playlistBanner
	local state = ctx.state
	local lower = ctx.lower
	local bindResponsiveActivate = ctx.bindResponsiveActivate
	local openCollection = ctx.openCollection
	local asset = ctx.asset
	local trackCollection = ctx.trackCollection
	local trackImage = ctx.trackImage
	local getCollectionTemplate = ctx.getCollectionTemplate
	local getCollectionCellSize = ctx.getCollectionCellSize

	local HEADER_HEIGHT = 26
	local SECTION_GAP = 18
	local GRID_PADDING = 12
	local DEFAULT_CELL = UDim2.fromOffset(150, 190)

	local trackColumnHeader = trackContainer:FindFirstChild("TrackListColHeader")

	-- NOTE: bar & songsHeader sekarang di-parent ke trackScroll (bukan trackContainer)
	-- supaya ikut discroll bareng track rows.
	local bar = Instance.new("Frame")
	bar.Name = "SearchCollectionsBar"
	bar.BackgroundTransparency = 1
	bar.BorderSizePixel = 0
	bar.Position = UDim2.fromOffset(0, 0)
	bar.Size = UDim2.new(1, 0, 0, 0)
	bar.ClipsDescendants = false
	bar.Visible = false
	bar.Parent = trackScroll

	local collectionsHeader = Instance.new("TextLabel")
	collectionsHeader.Name = "CollectionsHeader"
	collectionsHeader.Size = UDim2.new(1, 0, 0, HEADER_HEIGHT)
	collectionsHeader.BackgroundTransparency = 1
	collectionsHeader.Font = Enum.Font.DenkOne
	collectionsHeader.Text = "COLLECTIONS"
	collectionsHeader.TextColor3 = Color3.fromRGB(154, 154, 154)
	collectionsHeader.TextSize = 13
	collectionsHeader.TextXAlignment = Enum.TextXAlignment.Left
	collectionsHeader.TextYAlignment = Enum.TextYAlignment.Center
	collectionsHeader.Parent = bar

	local grid = Instance.new("Frame")
	grid.Name = "Grid"
	grid.Position = UDim2.fromOffset(0, HEADER_HEIGHT)
	grid.Size = UDim2.new(1, 0, 0, 0)
	grid.BackgroundTransparency = 1
	grid.Parent = bar

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.CellPadding = UDim2.fromOffset(GRID_PADDING, GRID_PADDING)
	gridLayout.CellSize = DEFAULT_CELL
	gridLayout.Parent = grid

	local songsHeader = Instance.new("TextLabel")
	songsHeader.Name = "SongsHeader"
	songsHeader.BackgroundTransparency = 1
	songsHeader.Font = Enum.Font.DenkOne
	songsHeader.Text = "SONGS"
	songsHeader.TextColor3 = Color3.fromRGB(154, 154, 154)
	songsHeader.TextSize = 13
	songsHeader.TextXAlignment = Enum.TextXAlignment.Left
	songsHeader.TextYAlignment = Enum.TextYAlignment.Center
	songsHeader.Size = UDim2.new(1, 0, 0, HEADER_HEIGHT)
	songsHeader.Visible = false
	songsHeader.Parent = trackScroll

	local cards = {}
	local tracksOffset = 0

	local function clearCards()
		for _, card in ipairs(cards) do
			card:Destroy()
		end
		table.clear(cards)
	end

	local function syncCellSize()
		local template = getCollectionTemplate and getCollectionTemplate()
		if template and template.AbsoluteSize.X > 0 and template.AbsoluteSize.Y > 0 then
			gridLayout.CellSize = UDim2.fromOffset(template.AbsoluteSize.X, template.AbsoluteSize.Y + 6)
			return
		end
		local cellSize = getCollectionCellSize and getCollectionCellSize()
		if cellSize and cellSize.X.Offset > 0 and cellSize.Y.Offset > 0 then
			gridLayout.CellSize = UDim2.fromOffset(cellSize.X.Offset, cellSize.Y.Offset + 6)
		else
			gridLayout.CellSize = DEFAULT_CELL
		end
	end

	local function layoutHeights(rows)
		local cellHeight = gridLayout.CellSize.Y.Offset
		local gridHeight = rows > 0 and (rows * cellHeight + math.max(0, rows - 1) * GRID_PADDING) or 0
		grid.Size = UDim2.new(1, 0, 0, gridHeight)
		local totalBarHeight = rows > 0 and (HEADER_HEIGHT + gridHeight) or 0
		bar.Size = UDim2.new(1, 0, 0, totalBarHeight)
	end

	-- setVisible sekarang cuma menghitung offset yang dipakai track rows,
	-- bukan menggeser/mengecilkan trackScroll lagi.
	local function setVisible(visible)
		bar.Visible = visible
		songsHeader.Visible = visible
		if trackColumnHeader then trackColumnHeader.Visible = not visible end

		if visible then
			local barHeight = bar.Size.Y.Offset
			local offsetY = barHeight > 0 and (barHeight + SECTION_GAP) or 0
			songsHeader.Position = UDim2.fromOffset(0, offsetY)
			tracksOffset = offsetY + HEADER_HEIGHT + 4
		else
			tracksOffset = 0
		end
	end

	local function countForCollection(name)
		local count = 0
		for _, track in ipairs(state.catalog) do
			if lower(trackCollection(track)) == lower(name) then
				count += 1
			end
		end
		return count
	end

	local function imageForCollection(name)
		for _, track in ipairs(state.catalog) do
			if lower(trackCollection(track)) == lower(name) then
				local image = trackImage(track)
				if image ~= "" then return image end
			end
		end
		return ""
	end

	local function makeFallbackCard()
		local card = Instance.new("TextButton")
		card.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		card.BackgroundTransparency = 0.05
		card.Text = ""
		card.AutoButtonColor = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = card

		local cover = Instance.new("Frame")
		cover.Name = "Cover"
		cover.Position = UDim2.fromOffset(8, 8)
		cover.Size = UDim2.new(1, -16, 1, -52)
		cover.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		cover.BorderSizePixel = 0
		cover.Parent = card
		local coverCorner = Instance.new("UICorner")
		coverCorner.CornerRadius = UDim.new(0, 8)
		coverCorner.Parent = cover

		local coverImage = Instance.new("ImageLabel")
		coverImage.Name = "CoverImage"
		coverImage.Size = UDim2.fromScale(1, 1)
		coverImage.BackgroundTransparency = 1
		coverImage.ScaleType = Enum.ScaleType.Crop
		coverImage.Visible = false
		coverImage.Parent = cover
		local coverImageCorner = Instance.new("UICorner")
		coverImageCorner.CornerRadius = UDim.new(0, 8)
		coverImageCorner.Parent = coverImage

		local defaultImage = Instance.new("TextLabel")
		defaultImage.Name = "DefaultImage"
		defaultImage.Size = UDim2.fromScale(1, 1)
		defaultImage.BackgroundTransparency = 1
		defaultImage.Font = Enum.Font.DenkOne
		defaultImage.Text = "M"
		defaultImage.TextColor3 = Color3.fromRGB(238, 238, 238)
		defaultImage.TextScaled = true
		defaultImage.Parent = cover

		local cardName = Instance.new("TextLabel")
		cardName.Name = "CardName"
		cardName.Position = UDim2.new(0, 8, 1, -40)
		cardName.Size = UDim2.new(1, -16, 0, 20)
		cardName.BackgroundTransparency = 1
		cardName.Font = Enum.Font.DenkOne
		cardName.TextColor3 = Color3.fromRGB(238, 238, 238)
		cardName.TextSize = 13
		cardName.TextTruncate = Enum.TextTruncate.AtEnd
		cardName.TextXAlignment = Enum.TextXAlignment.Left
		cardName.Parent = card

		local cardCount = Instance.new("TextLabel")
		cardCount.Name = "CardCount"
		cardCount.Position = UDim2.new(0, 8, 1, -20)
		cardCount.Size = UDim2.new(1, -16, 0, 16)
		cardCount.BackgroundTransparency = 1
		cardCount.Font = Enum.Font.DenkOne
		cardCount.TextColor3 = Color3.fromRGB(154, 154, 154)
		cardCount.TextSize = 11
		cardCount.TextXAlignment = Enum.TextXAlignment.Left
		cardCount.Parent = card

		return card
	end

	local function update(query)
		clearCards()
		if query == "" or playlistBanner.Visible then
			setVisible(false)
			return
		end

		local seen = {}
		local matches = {}
		for _, collection in ipairs(state.collections) do
			local name = tostring(collection.name or collection.Name or ""):match("^%s*(.-)%s*$") or ""
			local key = lower(name)
			if name ~= "" and not seen[key] and key:find(query, 1, true) then
				seen[key] = true
				local explicitImage = asset and asset(collection.image or collection.Image) or ""
				table.insert(matches, {
					name = name,
					image = explicitImage ~= "" and explicitImage or imageForCollection(name),
					count = countForCollection(name),
				})
			end
		end

		if #matches == 0 then
			setVisible(false)
			return
		end

		syncCellSize()
		local template = getCollectionTemplate and getCollectionTemplate()
		local cellWidth = gridLayout.CellSize.X.Offset
		local availableWidth = trackScroll.AbsoluteSize.X > 0 and trackScroll.AbsoluteSize.X or 600
		local columns = math.max(1, math.floor((availableWidth + GRID_PADDING) / (cellWidth + GRID_PADDING)))

		for index, match in ipairs(matches) do
			local card
			if template then
				card = template:Clone()
				card:SetAttribute("CaaBound", nil)
				local like = card:FindFirstChild("AlbumLike")
				if like then like.Visible = false end
			else
				card = makeFallbackCard()
			end
			card.Name = "SearchCollectionCard"
			card.Visible = true
			card.LayoutOrder = index
			card:SetAttribute("CollectionName", match.name)
			card.Parent = grid

			local cardName = card:FindFirstChild("CardName")
			local cardCount = card:FindFirstChild("CardCount")
			local coverFrame = card:FindFirstChild("Cover")
			local cover = coverFrame and coverFrame:FindFirstChild("CoverImage")
			local default = coverFrame and coverFrame:FindFirstChild("DefaultImage")
			if cardName then cardName.Text = match.name end
			if cardCount then cardCount.Text = tostring(match.count) .. " songs" end
			if cover then cover.Image = match.image; cover.Visible = match.image ~= "" end
			if default then default.Visible = match.image == "" end

			bindResponsiveActivate(card, function() openCollection(match.name) end)
			table.insert(cards, card)
		end

		local rows = math.ceil(#matches / columns)
		layoutHeights(rows)
		setVisible(true)
	end

	return {
		Update = update,
		SetVisible = setVisible,
		GetTracksOffset = function() return tracksOffset end,
	}
end

return Module]]></ProtectedString>
							<string name="ScriptGuid">{2D91C64B-9592-4728-93ED-11269352FCF0}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">CaaMusicSearchBar</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX42E143BA632E4EE3A9F11A6525042839">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")

local Module = {}

function Module.new(ctx)
	local trackId = ctx.trackId
	local child = ctx.child
	local connect = ctx.connect
	local fire = ctx.fire
	local state = ctx.state
	local lower = ctx.lower
	local first = ctx.first
	local asset = ctx.asset
	local trackName = ctx.trackName
	local trackCollection = ctx.trackCollection
	local trackImage = ctx.trackImage
	local bindResponsiveActivate = ctx.bindResponsiveActivate
	local applyFavoriteVisual = ctx.applyFavoriteVisual
	local isFavorite = ctx.isFavorite
	local toggleFavorite = ctx.toggleFavorite
	local collectionFavoriteKey = ctx.collectionFavoriteKey
	local isCollectionFavorite = ctx.isCollectionFavorite
	local notify = ctx.notify
	local clearActiveHover = ctx.clearActiveHover
	local cancelTransientInput = ctx.cancelTransientInput
	local configureScrollingFrame = ctx.configureScrollingFrame
	local refreshFavoriteViews = ctx.refreshFavoriteViews
	local libraryView = ctx.libraryView
	local SearchBarModule = ctx.SearchBarModule

	local libraryPanel = child(libraryView, "LibraryPanel")
	local libBack = child(libraryPanel, "LibBack")
	local libHeader = child(libraryPanel, "LibHeader")
	local libSubtitle = child(libraryPanel, "LibSubtitle")
	local libDivider = child(libraryPanel, "LibDivider")
	local searchBar = child(libraryPanel, "SearchBar")
	local searchClear = child(libraryPanel, "SearchClear")
	local playlistBanner = child(libraryPanel, "PlaylistBanner")
	local bannerTitle = child(playlistBanner, "BannerTitle")
	local bannerEyebrow = child(playlistBanner, "BannerEyebrow")
	local bannerImage = child(playlistBanner, "BannerImage")
	-- ═══ IKON BANNER (vektor, bukan teks) ═══
	--   All Tracks  = ikon not musik (♫)
	--   Liked Songs = ikon bintang (★)
	-- Keduanya digambar dari raster mini ber-anti-alias dan dinormalisasi ke kotak yang SAMA (BOX px),
	-- jadi ukuran visualnya persis sama. (Ikon lama berupa TextLabel dengan teks rusak oleh encoding.)
	local bannerFavHeart, bannerNote
	do
		for _, oldName in ipairs({"BannerFavHeart", "BannerNote"}) do
			local old = bannerImage:FindFirstChild(oldName)
			if old then old:Destroy() end
		end

		local GRID = 40     -- kotak ikon (px) dan resolusi raster
		local BOX = 36      -- sisi terpanjang ikon, SAMA untuk bintang dan not
		local SS = 4        -- supersampling per sel (anti-alias)
		local ICON_COLOR = Color3.fromRGB(165, 165, 165)

		local function polyInside(poly, x, y)
			local inside = false
			local n = #poly
			local j = n
			for i = 1, n do
				local xi, yi = poly[i][1], poly[i][2]
				local xj, yj = poly[j][1], poly[j][2]
				if (yi > y) ~= (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi then
					inside = not inside
				end
				j = i
			end
			return inside
		end

		local function ellipseInside(cx, cy, rx, ry, rot, x, y)
			local dx, dy = x - cx, y - cy
			local c, sn = math.cos(rot), math.sin(rot)
			local u = dx * c + dy * sn
			local v = -dx * sn + dy * c
			return (u / rx) ^ 2 + (v / ry) ^ 2 <= 1
		end

		local function buildIcon(name, inside, minX, minY, maxX, maxY)
			local holder = Instance.new("Frame")
			holder.Name = name
			holder.AnchorPoint = Vector2.new(0.5, 0.5)
			holder.Position = UDim2.fromScale(0.5, 0.5)
			holder.Size = UDim2.fromOffset(GRID, GRID)
			holder.BackgroundTransparency = 1
			holder.BorderSizePixel = 0
			holder.Active = false
			holder.Visible = false
			holder.ZIndex = bannerImage.ZIndex + 1

			local w, h = maxX - minX, maxY - minY
			local k = BOX / math.max(w, h)
			local ox = (GRID - w * k) / 2 - minX * k
			local oy = (GRID - h * k) / 2 - minY * k

			local cov = {}
			for gy = 0, GRID - 1 do
				local row = {}
				for gx = 0, GRID - 1 do
					local hit = 0
					for sy = 0, SS - 1 do
						for sx = 0, SS - 1 do
							local px = (gx + (sx + 0.5) / SS - ox) / k
							local py = (gy + (sy + 0.5) / SS - oy) / k
							if inside(px, py) then hit += 1 end
						end
					end
					row[gx] = hit / (SS * SS)
				end
				cov[gy] = row
			end

			local function addRect(x0, y0, x1, y1, transparency)
				local f = Instance.new("Frame")
				f.BackgroundColor3 = ICON_COLOR
				f.BackgroundTransparency = transparency
				f.BorderSizePixel = 0
				f.Active = false
				f.Position = UDim2.fromScale(x0 / GRID, y0 / GRID)
				f.Size = UDim2.fromScale((x1 - x0 + 1) / GRID, (y1 - y0 + 1) / GRID)
				f.ZIndex = holder.ZIndex
				f.Parent = holder
				return f
			end

			local prevRuns = {}
			for gy = 0, GRID - 1 do
				local curRuns = {}
				local row = cov[gy]
				local gx = 0
				while gx < GRID do
					local c = row[gx]
					if c >= 0.999 then
						local x1 = gx
						while x1 + 1 < GRID and row[x1 + 1] >= 0.999 do x1 += 1 end
						local key = gx .. ":" .. x1
						local run = prevRuns[key]
						if run then
							run.y1 = gy
							run.frame.Size = UDim2.fromScale((x1 - gx + 1) / GRID, (gy - run.y0 + 1) / GRID)
						else
							run = {y0 = gy, y1 = gy, frame = addRect(gx, gy, x1, gy, 0)}
						end
						curRuns[key] = run
						gx = x1 + 1
					else
						if c > 0.02 then addRect(gx, gy, gx, gy, 1 - c) end
						gx += 1
					end
				end
				prevRuns = curRuns
			end

			holder.Parent = bannerImage
			return holder
		end

		-- bintang 5 sudut
		local starPoly = {}
		for i = 0, 9 do
			local ang = math.rad(-90 + i * 36)
			local r = (i % 2 == 0) and 1 or 0.42
			starPoly[#starPoly + 1] = {math.cos(ang) * r, math.sin(ang) * r}
		end
		bannerFavHeart = buildIcon("BannerFavHeart", function(x, y)
			return polyInside(starPoly, x, y)
		end, -0.951, -1, 0.951, 0.809)

		-- not musik berbalok (♫)
		local noteRot = math.rad(-22)
		local beamPoly = {{14.2, 7.5}, {36.2, 3.2}, {36.2, 10}, {14.2, 14.3}}
		bannerNote = buildIcon("BannerNote", function(x, y)
			if ellipseInside(10, 31, 6.4, 4.7, noteRot, x, y) then return true end
			if ellipseInside(29, 27, 6.4, 4.7, noteRot, x, y) then return true end
			if x >= 14.2 and x <= 17.2 and y >= 7.5 and y <= 31 then return true end
			if x >= 33.2 and x <= 36.2 and y >= 3.5 and y <= 27 then return true end
			return polyInside(beamPoly, x, y)
		end, 3.8, 3.2, 36.2, 36.0)
	end
	local bannerSub = child(playlistBanner, "BannerSub")
	local detailSearch = child(playlistBanner, "DetailSearch")
	local detailSearchClear = child(playlistBanner, "DetailSearchClear")
	local cardsContainer = child(libraryPanel, "CardsContainer")
	local collectionsScroll = child(cardsContainer, "CollectionsScroll")
	collectionsScroll.Active = true
	collectionsScroll.ScrollingEnabled = true
	collectionsScroll.ScrollingDirection = Enum.ScrollingDirection.Y
	collectionsScroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable

	local trackContainer = child(libraryPanel, "TrackScrollContainer")
	local trackScroll = child(trackContainer, "TrackListScroll")
	trackScroll.Active = true
	trackScroll.ScrollingEnabled = true
	trackScroll.ScrollingDirection = Enum.ScrollingDirection.Y
	trackScroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
	trackScroll.AutomaticCanvasSize = Enum.AutomaticSize.None
	trackScroll.CanvasSize = UDim2.fromOffset(0, 0)
	local staleTrackLayout = trackScroll:FindFirstChild("TrackListLayout") or trackScroll:FindFirstChildOfClass("UIListLayout")
	if staleTrackLayout then staleTrackLayout:Destroy() end
	trackScroll.ScrollBarThickness = 0

	local openCollectionName
	local collectionTemplate

	local shortcutSection, collectionSection, shortcutGrid, sourceCollectionGrid

	local searchBarModule = SearchBarModule.new({
		trackContainer = trackContainer,
		trackScroll = trackScroll,
		playlistBanner = playlistBanner,
		state = state,
		lower = lower,
		bindResponsiveActivate = bindResponsiveActivate,
		asset = asset,
		trackCollection = trackCollection,
		trackImage = trackImage,
		openCollection = function(name)
			if openCollectionName then openCollectionName(name) end
		end,
		getCollectionTemplate = function()
			return collectionTemplate
		end,
		getCollectionCellSize = function()
			local layout = sourceCollectionGrid and sourceCollectionGrid:FindFirstChildOfClass("UIGridLayout")
			return layout and layout.CellSize
		end,	})
	local updateSearchCollectionsBar = searchBarModule.Update
	local setSearchCollectionsBarVisible = searchBarModule.SetVisible
	local getSearchTracksOffset = searchBarModule.GetTracksOffset

	do
		local lastCollectionCanvas = collectionsScroll.CanvasPosition
		connect(collectionsScroll:GetPropertyChangedSignal("CanvasPosition"), function()
			local current = collectionsScroll.CanvasPosition
			if (current - lastCollectionCanvas).Magnitude > 1.25 then
				state.suppressCollectionOpenUntil = os.clock() + 0.32
				clearActiveHover()
				cancelTransientInput()
			end
			lastCollectionCanvas = current
		end)

		local lastTrackCanvas = trackScroll.CanvasPosition
		connect(trackScroll:GetPropertyChangedSignal("CanvasPosition"), function()
			local current = trackScroll.CanvasPosition
			if (current - lastTrackCanvas).Magnitude > 1.25 then
				local nowClock = os.clock()
				-- selama masih dalam masa suppress, tidak perlu memanggil ulang tiap frame (berat)
				if (state.suppressQueueUntil or 0) - nowClock < 0.2 then
					state.suppressQueueUntil = nowClock + 0.32
					clearActiveHover()
					cancelTransientInput()
				end
			end
			lastTrackCanvas = current
		end)
	end

	local trackColumnHeader = trackContainer:FindFirstChild("TrackListColHeader")
	if trackColumnHeader then
		local colFav = trackColumnHeader:FindFirstChild("ColFav")
		if colFav then
			colFav.AnchorPoint = Vector2.new(1, 0)
			colFav.Position = UDim2.new(1, -10, 0, 0)
			colFav.Size = UDim2.new(0, 72, 1, 0)
			colFav.TextXAlignment = Enum.TextXAlignment.Right
		end
	end

	local trackRows = {}
	for _, item in ipairs(trackScroll:GetChildren()) do
		if item:IsA("TextButton") and item.Name == "PoolRow" then table.insert(trackRows, item) end
	end
	table.sort(trackRows, function(a, b)
		local an = tonumber((a:FindFirstChild("RowNum") and a.RowNum.Text) or "0") or 0
		local bn = tonumber((b:FindFirstChild("RowNum") and b.RowNum.Text) or "0") or 0
		return an < bn
	end)
	local trackTemplate = trackRows[1]
	local filteredTracks = {}
	local wheelDirty = true
	local boundTrackRows = setmetatable({}, {__mode = "k"})

	-- CHANGED: now offsets by getSearchTracksOffset() so rows sit below the
	-- collections bar when it's visible, and shift back up when it's hidden.
	local function configureTrackRow(row, index)
		row.LayoutOrder = index
		-- anchor tengah supaya efek roda (mengecil/menyempit) tetap simetris di posisi barisnya
		local baseY = getSearchTracksOffset() + (index - 1) * 58
		row.AnchorPoint = Vector2.new(0.5, 0.5)
		row.Size = UDim2.new(1, -12, 0, 58)
		row.Position = UDim2.new(0.5, 0, 0, baseY + 29)
	end

	local function bindTrackRow(row)
		if boundTrackRows[row] then return end
		boundTrackRows[row] = true
		local favorite = row:FindFirstChild("FavoriteButton")
		if favorite then
			favorite.AnchorPoint = Vector2.new(1, 0.5)
			favorite.Position = UDim2.new(1, -10, 0.5, 0)
			connect(favorite.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					state.suppressQueueUntil = os.clock() + 0.35
				end
			end)
			bindResponsiveActivate(favorite, function()
				state.suppressQueueUntil = os.clock() + 0.35
				local index = row:GetAttribute("CatalogIndex")
				local track = index and filteredTracks[index]
				if track then toggleFavorite(track) end
			end)
		end
		bindResponsiveActivate(row, function()
			if os.clock() < state.suppressQueueUntil then return end
			local index = row:GetAttribute("CatalogIndex")
			local track = index and filteredTracks[index]
			if track then
				state.pendingNoticeTrack = track
				fire("queue", track)
			end
		end)
	end

	for index, row in ipairs(trackRows) do
		configureTrackRow(row, index)
		bindTrackRow(row)
	end

	local function ensureTrackRows(requiredCount)
		requiredCount = math.max(0, math.floor(tonumber(requiredCount) or 0))
		if not trackTemplate then return end
		while #trackRows < requiredCount do
			local index = #trackRows + 1
			local row = trackTemplate:Clone()
			row.Name = "PoolRow"
			row.Visible = false
			row:SetAttribute("CatalogIndex", nil)
			configureTrackRow(row, index)
			row.Parent = trackScroll
			trackRows[index] = row
			bindTrackRow(row)
		end
	end

	local function filteredCatalog()
		local result = {}
		local query = lower(playlistBanner.Visible and detailSearch.Text or searchBar.Text)
		for _, track in ipairs(state.catalog) do
			local collection = trackCollection(track)
			local passCollection = state.selectedCollection == nil
				or state.selectedCollection == "__ALL__"
				or (state.selectedCollection == "__FAVORITES__" and isFavorite(track))
				or lower(collection) == lower(state.selectedCollection)
			local passQuery = query == "" or lower(trackName(track)):find(query, 1, true) or lower(collection):find(query, 1, true) or trackId(track):find(query, 1, true)
			if passCollection and passQuery then table.insert(result, track) end
		end
		return result
	end

	local renderTracks
	renderTracks = function()
		filteredTracks = filteredCatalog()
		ensureTrackRows(#filteredTracks)
		for index, row in ipairs(trackRows) do
			local track = filteredTracks[index]
			row.Visible = track ~= nil
			configureTrackRow(row, index)
			if track then
				row:SetAttribute("CatalogIndex", index)
				local rowNum = row:FindFirstChild("RowNum")
				local poster = row:FindFirstChild("PosterName")
				local col = row:FindFirstChild("PosterCol")
				local thumb = row:FindFirstChild("Thumb")
				local favorite = row:FindFirstChild("FavoriteButton")
				if rowNum then rowNum.Text = tostring(index) end
				if poster then poster.Text = trackName(track) end
				if col then col.Text = trackCollection(track) end
				if thumb then
					local cover = thumb:FindFirstChild("CoverImage")
					local default = thumb:FindFirstChild("DefaultImage")
					local image = trackImage(track)
					if cover then cover.Image = image; cover.Visible = image ~= "" end
					if default then default.Visible = image == "" end
				end
				applyFavoriteVisual(favorite, isFavorite(track))
			else
				row:SetAttribute("CatalogIndex", nil)
				local rowNum = row:FindFirstChild("RowNum")
				local poster = row:FindFirstChild("PosterName")
				local col = row:FindFirstChild("PosterCol")
				if rowNum then rowNum.Text = "" end
				if poster then poster.Text = "" end
				if col then col.Text = "" end
			end
		end
		-- CHANGED: canvas height now includes the offset reserved for the
		-- collections bar + songs header when the search bar is showing them.
		trackScroll.CanvasSize = UDim2.fromOffset(0, getSearchTracksOffset() + #filteredTracks * 58)
		wheelDirty = true
	end

	-- ═══ EFEK RODA (drum) saat list lagu di-scroll ═══
	-- Baris di dekat tepi atas/bawah menyempit, mengecil, dan memudar seperti roda yang berputar.
	-- Baris paling atas/bawah list tetap normal saat berada di ujung scroll.
	local WHEEL_H = 58
	local wheelBase = setmetatable({}, {__mode = "k"})

	local function wheelTargets(row)
		local list = wheelBase[row]
		if list then return list end
		list = {}
		local function add(inst, prop)
			local attr = "WBase_" .. prop
			local base = inst:GetAttribute(attr)
			if base == nil then
				base = inst[prop]
				inst:SetAttribute(attr, base)
			end
			list[#list + 1] = {inst, prop, base}
		end
		for _, d in ipairs(row:GetDescendants()) do
			if d:IsA("GuiObject") and d.Name ~= "CaaHoverFill"
				and d.Name ~= "CaaFavoriteGlyph" and d.Name ~= "CaaTrashGlyph" then
				if d:IsA("TextLabel") or d:IsA("TextButton") then add(d, "TextTransparency") end
				if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Name ~= "FavoriteButton" then
					add(d, "ImageTransparency")
				end
				if d.BackgroundTransparency < 1 then add(d, "BackgroundTransparency") end
			end
		end
		wheelBase[row] = list
		return list
	end

	local function wheelGlyphs(row, alpha)
		local fav = row:FindFirstChild("FavoriteButton")
		local glyph = fav and fav:FindFirstChild("CaaFavoriteGlyph")
		if glyph then
			local base = (fav:GetAttribute("Liked") == true) and 0 or 0.12
			glyph.ImageTransparency = 1 - (1 - base) * alpha
		end
		local rem = row:FindFirstChild("RemoveButton")
		local trash = rem and rem:FindFirstChild("CaaTrashGlyph")
		if trash then trash.ImageTransparency = 1 - alpha end
	end

	-- ═══ SCROLL MULUS (daftar lagu) ═══
	-- Roda mouse: loncatan scroll bawaan Roblox ditangkap lalu diganti luncuran halus (easing eksponensial,
	-- tidak bergantung FPS). Sentuh/geser (HP) tetap memakai scroll + inertia bawaan, dan membatalkan luncuran.
	local UserInputService = game:GetService("UserInputService")
	local SMOOTH_SPEED = 12   -- makin besar = makin cepat menyusul tujuan
	local WHEEL_MULT = 1.4    -- 1 putaran roda = jarak bawaan x nilai ini
	local smoothTarget = nil  -- tujuan luncuran (nil = tidak sedang meluncur)
	local smoothLast = 0      -- posisi Y terakhir yang kita set / amati
	local wheelPulse = 0      -- >0 = baru ada input roda mouse

	connect(UserInputService.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			wheelPulse = 2
		end
	end)

	local function smoothScrollStep(dt)
		if not trackContainer.Visible then
			smoothTarget = nil
			wheelPulse = 0
			smoothLast = trackScroll.CanvasPosition.Y
			return
		end
		local cur = trackScroll.CanvasPosition
		local delta = cur.Y - smoothLast
		if wheelPulse > 0 then
			wheelPulse -= 1
			if math.abs(delta) > 0.01 then
				-- loncatan bawaan dari roda mouse: batalkan, jadikan tambahan tujuan luncuran
				local base = smoothTarget or smoothLast
				smoothTarget = math.max(0, base + delta * WHEEL_MULT)
				trackScroll.CanvasPosition = Vector2.new(cur.X, smoothLast)
				cur = trackScroll.CanvasPosition
				delta = 0
				wheelPulse = 0
			end
		elseif smoothTarget and math.abs(delta) > 0.5 then
			-- posisi digeser pihak lain (sentuh / drag / kode lain): hentikan luncuran
			smoothTarget = nil
		end

		if smoothTarget then
			local diff = smoothTarget - cur.Y
			local nextY
			if math.abs(diff) < 0.4 then
				nextY = smoothTarget
				smoothTarget = nil
			else
				nextY = cur.Y + diff * (1 - math.exp(-SMOOTH_SPEED * dt))
			end
			trackScroll.CanvasPosition = Vector2.new(cur.X, nextY)
			local actual = trackScroll.CanvasPosition.Y
			if smoothTarget and math.abs(actual - nextY) > 0.5 then
				smoothTarget = nil -- sudah mentok di ujung list
			end
			smoothLast = actual
		else
			smoothLast = trackScroll.CanvasPosition.Y
		end
	end

	local wheelCache = setmetatable({}, {__mode = "k"})
	local lastWheelKey = ""
	local function updateWheel(dt)
		dt = math.clamp(tonumber(dt) or (1 / 60), 1 / 240, 0.1)
		smoothScrollStep(dt)
		if not (libraryView.Visible and trackContainer.Visible) then return end
		local count = #filteredTracks
		if count < 2 then return end
		local r1, r2 = trackRows[1], trackRows[2]
		if not (r1 and r2 and r1.Visible and r2.Visible) then return end
		-- semua dihitung dalam piksel absolut di layar (tidak bergantung UIScale / satuan CanvasPosition)
		local winH = trackScroll.AbsoluteWindowSize.Y
		if winH < 10 then return end
		local winTop = trackScroll.AbsolutePosition.Y
		local c1 = r1.AbsolutePosition.Y + r1.AbsoluteSize.Y / 2
		local c2 = r2.AbsolutePosition.Y + r2.AbsoluteSize.Y / 2
		local pitch = c2 - c1 -- jarak antar pusat baris (pusat baris tidak bergeser oleh efek)
		if pitch < 1 then return end
		local key = string.format("%.1f|%.1f|%.2f|%d", c1, winTop, winH, count)
		if key == lastWheelKey and not wheelDirty then return end
		lastWheelKey = key
		if wheelDirty then table.clear(wheelCache) end
		wheelDirty = false

		local half = winH / 2
		local mid = winTop + half
		-- seberapa jauh list sudah di-scroll dari ujung atas / bawah (di ujung, baris tetap normal)
		local scrolledTop = winTop - (c1 - pitch / 2)
		local scrolledBottom = (c1 + (count - 0.5) * pitch) - (winTop + winH)
		local eTop = math.clamp(scrolledTop / (pitch * 1.5), 0, 1)
		local eBot = math.clamp(scrolledBottom / (pitch * 1.5), 0, 1)
		local i0 = math.max(1, math.floor((winTop - c1) / pitch) + 1 - 2)
		local i1 = math.min(count, math.ceil((winTop + winH - c1) / pitch) + 1 + 2)
		for i = i0, i1 do
			local row = trackRows[i]
			if row and row.Visible then
				local t = (c1 + (i - 1) * pitch - mid) / half
				local a = math.min(1.15, math.abs(t))
				local e = (t < 0) and eTop or eBot
				-- f dibulatkan ke 1/32: baris hanya ditulis ulang bila langkahnya berubah (jauh lebih ringan)
				local f = math.floor(a * a * e * 32 + 0.5) / 32
				if wheelCache[row] ~= f then
					wheelCache[row] = f
					local alpha = 1 - 0.85 * math.min(1, f * 1.1)
					row.Size = UDim2.new(1, -12 - 90 * f, 0, WHEEL_H * (1 - 0.20 * f))
					for _, entry in ipairs(wheelTargets(row)) do
						entry[1][entry[2]] = 1 - (1 - entry[3]) * alpha
					end
					wheelGlyphs(row, alpha)
				end
			end
		end
	end
	connect(RunService.RenderStepped, updateWheel)

	local visibleFavoriteCount

	local function showCollection(collection)
		state.selectedCollection = collection
		cardsContainer.Visible = false
		trackContainer.Visible = true
		playlistBanner.Visible = true
		libBack.Visible = true
		libHeader.Visible = false
		libSubtitle.Visible = false
		libDivider.Visible = false
		searchBar.Visible = false
		searchClear.Visible = false
		local title = collection == "__ALL__" and "All Tracks" or (collection == "__FAVORITES__" and "Liked Songs" or collection)
		bannerEyebrow.Text = "PLAYLIST"
		bannerTitle.Text = tostring(title)
		local count = 0
		if collection == "__FAVORITES__" then
			count = visibleFavoriteCount()
		else
			for _, track in ipairs(state.catalog) do
				if collection == "__ALL__" or trackCollection(track) == collection then
					count += 1
				end
			end
		end
		bannerSub.Text = tostring(count) .. " songs"
		local image = ""
		for _, col in ipairs(state.collections) do
			if tostring(col.name or col.Name or "") == tostring(collection) then image = asset(col.image or col.Image); break end
		end
		bannerImage.Image = image
		bannerImage.Visible = true
		if bannerFavHeart then bannerFavHeart.Visible = collection == "__FAVORITES__" and image == "" end
		if bannerNote then bannerNote.Visible = collection ~= "__FAVORITES__" and image == "" end
		detailSearch.Text = ""
		setSearchCollectionsBarVisible(false)
		trackScroll.CanvasPosition = Vector2.zero
		renderTracks()
	end

	local function countLibraryCollections()
		local seen = {}
		local count = 0
		for _, collection in ipairs(state.collections) do
			local name = tostring(collection.name or collection.Name or ""):match("^%s*(.-)%s*$") or ""
			local key = lower(name)
			if key ~= "" and not seen[key] then
				seen[key] = true
				count += 1
			end
		end
		return count
	end

	local function updateLibrarySummary()
		libSubtitle.Text = string.format("%d collections  ·  %d songs", countLibraryCollections(), #state.catalog)
	end

	local function showCollections()
		state.selectedCollection = nil
		cardsContainer.Visible = true
		trackContainer.Visible = false
		playlistBanner.Visible = false
		libBack.Visible = false
		libHeader.Visible = true
		libSubtitle.Visible = true
		libDivider.Visible = true
		searchBar.Visible = true
		searchClear.Visible = searchBar.Text ~= ""
		libHeader.Text = "YOUR LIBRARY"
		updateLibrarySummary()
		collectionsScroll.CanvasPosition = Vector2.zero
		configureScrollingFrame(collectionsScroll)
		task.defer(function()
			if collectionsScroll.Parent and collectionsScroll.Visible then
				configureScrollingFrame(collectionsScroll)
			end
		end)
	end
	bindResponsiveActivate(libBack, showCollections)
	bindResponsiveActivate(searchClear, function() searchBar.Text = "" end)
	bindResponsiveActivate(detailSearchClear, function() detailSearch.Text = "" end)
	connect(searchBar:GetPropertyChangedSignal("Text"), function()
		searchClear.Visible = searchBar.Text ~= ""
		if searchBar.Text ~= "" then
			state.selectedCollection = "__ALL__"
			cardsContainer.Visible = false
			trackContainer.Visible = true
			playlistBanner.Visible = false
			libBack.Visible = false
			libHeader.Visible = true
			libSubtitle.Visible = true
			libDivider.Visible = true
			updateSearchCollectionsBar(lower(searchBar.Text))
			renderTracks()
		elseif not playlistBanner.Visible then
			setSearchCollectionsBarVisible(false)
			showCollections()
		end
	end)
	connect(detailSearch:GetPropertyChangedSignal("Text"), function()
		detailSearchClear.Visible = detailSearch.Text ~= ""
		renderTracks()
	end)

	shortcutSection = collectionsScroll:FindFirstChild("SHORTCUTSSection")
	collectionSection = collectionsScroll:FindFirstChild("COLLECTIONSSection")
	shortcutGrid = shortcutSection and shortcutSection:FindFirstChild("Grid")
	sourceCollectionGrid = collectionSection and collectionSection:FindFirstChild("Grid")

	local function restoreCollectionLayout()
		collectionsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		collectionsScroll.CanvasSize = UDim2.fromOffset(0, 0)
		collectionsScroll.ScrollingDirection = Enum.ScrollingDirection.Y
		collectionsScroll.ScrollBarThickness = 0
		collectionsScroll.Active = true
		collectionsScroll.ScrollingEnabled = true

		for _, object in ipairs({shortcutSection, shortcutGrid, collectionSection, sourceCollectionGrid}) do
			if object and object:IsA("GuiObject") then
				object.AutomaticSize = Enum.AutomaticSize.Y
				object.Size = UDim2.new(1, 0, 0, 0)
			end
		end
	end
	restoreCollectionLayout()

	do
		local shortcutLayout = shortcutGrid and shortcutGrid:FindFirstChildOfClass("UIGridLayout")
		local collectionLayout = sourceCollectionGrid and sourceCollectionGrid:FindFirstChildOfClass("UIGridLayout")
		if shortcutLayout and collectionLayout then
			shortcutLayout.CellSize = collectionLayout.CellSize
			shortcutLayout.CellPadding = collectionLayout.CellPadding
			shortcutLayout.FillDirection = collectionLayout.FillDirection
			shortcutLayout.FillDirectionMaxCells = collectionLayout.FillDirectionMaxCells
			shortcutLayout.HorizontalAlignment = collectionLayout.HorizontalAlignment
			shortcutLayout.VerticalAlignment = collectionLayout.VerticalAlignment
			shortcutLayout.SortOrder = Enum.SortOrder.LayoutOrder
		end
	end

	local lastCollectionOpenAt = 0
	openCollectionName = function(name)
		local now = os.clock()
		if now < state.suppressCollectionOpenUntil or now - lastCollectionOpenAt < 0.22 then return end
		if type(name) ~= "string" or name == "" then return end
		lastCollectionOpenAt = now
		state.suppressQueueUntil = math.max(tonumber(state.suppressQueueUntil) or 0, now + 0.40)
		cancelTransientInput()
		showCollection(name)
	end

	local collectionOpenSurfaces = setmetatable({}, {__mode = "k"})
	local function bindCollectionOpenSurface(card, resolveName)
		if not card or not card:IsA("GuiButton") or collectionOpenSurfaces[card] then return end
		collectionOpenSurfaces[card] = true

		card.Active = true
		card.Selectable = false
		card.AutoButtonColor = false
		connect(card.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				clearActiveHover()
			end
		end)
		pcall(function() card.Interactable = true end)

		for _, object in ipairs(card:GetChildren()) do
			if object.Name == "CaaCollectionOpenSurface"
				or (object:IsA("GuiButton") and object:GetAttribute("SSCollectionSurface") == true) then
				object:Destroy()
			end
		end

		local like = card:FindFirstChild("AlbumLike")
		for _, object in ipairs(card:GetDescendants()) do
			local insideLike = like and (object == like or object:IsDescendantOf(like))
			if object:IsA("GuiObject") and not insideLike and not object:IsA("GuiButton") then
				object.Active = false
				object.Selectable = false
			end
		end

		bindResponsiveActivate(card, function()
			local name = type(resolveName) == "function" and resolveName() or resolveName
			openCollectionName(name)
		end)
	end

	if shortcutSection and shortcutSection:FindFirstChild("Grid") then
		local grid = shortcutSection.Grid
		local favoritesCard = grid:FindFirstChild("Card___FAVORITES__")
		local allCard = grid:FindFirstChild("Card___ALL__")
		if favoritesCard then
			bindCollectionOpenSurface(favoritesCard, "__FAVORITES__")
		end
		if allCard then
			bindCollectionOpenSurface(allCard, "__ALL__")
		end
	end
	local collectionCards = {}
	local collectionGrid = sourceCollectionGrid
	collectionTemplate = nil
	local boundCollectionCards = setmetatable({}, {__mode = "k"})
	local function bindCollectionCard(card)
		if boundCollectionCards[card] then return end
		boundCollectionCards[card] = true
		bindCollectionOpenSurface(card, function()
			return card:GetAttribute("CollectionName")
		end)
		local like = card:FindFirstChild("AlbumLike")
		if like then
			connect(like.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					state.suppressCollectionOpenUntil = os.clock() + 0.40
				end
			end)
			bindResponsiveActivate(like, function()
				state.suppressCollectionOpenUntil = os.clock() + 0.40
				state.suppressQueueUntil = os.clock() + 0.20
				local name = card:GetAttribute("CollectionName")
				local key = collectionFavoriteKey(name)
				if type(name) == "string" and name ~= "" and key then
					local target = not isCollectionFavorite(name)
					local representativeTrack = nil
					for _, track in ipairs(state.catalog) do
						if lower(trackCollection(track)) == lower(name) then
							representativeTrack = track
							break
						end
					end

					state.favorites[key] = target or nil
					state.favoritePending[key] = {value = target, expiresAt = os.clock() + 3}
					refreshFavoriteViews()
					notify(
						target and "success" or "error",
						target and "ADDED TO SHORTCUTS" or "REMOVED FROM SHORTCUTS",
						name,
						representativeTrack,
						3.2
					)
					fire("togglecollectionfavorite", {collection = name, enabled = target})
				end
			end)
		end
	end

	if collectionGrid then
		for _, card in ipairs(collectionGrid:GetChildren()) do
			if card:IsA("TextButton") then table.insert(collectionCards, card) end
		end
		table.sort(collectionCards, function(a, b)
			if a.LayoutOrder == b.LayoutOrder then return a.Name < b.Name end
			return a.LayoutOrder < b.LayoutOrder
		end)
		collectionTemplate = collectionCards[1]
		for _, card in ipairs(collectionCards) do
			bindCollectionCard(card)
		end
	end

	local function ensureCollectionCards(requiredCount)
		requiredCount = math.max(0, math.floor(tonumber(requiredCount) or 0))
		if not collectionGrid or not collectionTemplate then return end
		while #collectionCards < requiredCount do
			local index = #collectionCards + 1
			local card = collectionTemplate:Clone()
			card.Name = "Card_Collection_" .. tostring(index)
			card.LayoutOrder = index
			card.Visible = false
			card:SetAttribute("CollectionName", nil)
			card.Parent = collectionGrid
			collectionCards[index] = card
			bindCollectionCard(card)
		end
	end

	showCollections()

	visibleFavoriteCount = function()
		local count = 0
		for _, track in ipairs(state.catalog) do
			if isFavorite(track) then count += 1 end
		end
		return count
	end

	local updateCollectionCards
	updateCollectionCards = function()
		ensureCollectionCards(#state.collections)
		local counts = {}
		local images = {}
		for _, track in ipairs(state.catalog) do
			local col = trackCollection(track)
			counts[col] = (counts[col] or 0) + 1
			if images[col] == nil then images[col] = trackImage(track) end
		end
		for _, collection in ipairs(state.collections) do
			local name = tostring(collection.name or collection.Name or "")
			local image = asset(collection.image or collection.Image)
			if name ~= "" and image ~= "" then images[name] = image end
		end

		if shortcutSection and shortcutSection:FindFirstChild("Grid") then
			local fav = shortcutSection.Grid:FindFirstChild("Card___FAVORITES__")
			local all = shortcutSection.Grid:FindFirstChild("Card___ALL__")
			if fav and fav:FindFirstChild("CardCount") then
				fav.CardCount.Text = tostring(visibleFavoriteCount()) .. " songs"
			end
			if all and all:FindFirstChild("CardCount") then all.CardCount.Text = tostring(#state.catalog) .. " songs" end
		end

		local nextShortcutOrder = 2
		local nextCollectionOrder = 0

		for index, card in ipairs(collectionCards or {}) do
			local collection = state.collections[index]
			if collection then
				local name = tostring(collection.name or collection.Name or ("Playlist " .. index))
				local pinnedToShortcuts = isCollectionFavorite(name)

				if shortcutGrid and sourceCollectionGrid then
					if pinnedToShortcuts then
						if card.Parent ~= shortcutGrid then card.Parent = shortcutGrid end
						card.LayoutOrder = nextShortcutOrder
						nextShortcutOrder += 1
					else
						if card.Parent ~= sourceCollectionGrid then card.Parent = sourceCollectionGrid end
						card.LayoutOrder = nextCollectionOrder
						nextCollectionOrder += 1
					end
				end

				card.Visible = true
				card:SetAttribute("CollectionName", name)
				local cardName = card:FindFirstChild("CardName")
				local cardCount = card:FindFirstChild("CardCount")
				local coverFrame = card:FindFirstChild("Cover")
				local cover = coverFrame and coverFrame:FindFirstChild("CoverImage")
				local default = coverFrame and coverFrame:FindFirstChild("DefaultImage")
				local image = images[name] or ""
				if cardName then cardName.Text = name end
				if cardCount then cardCount.Text = tostring(counts[name] or #(collection.tracks or {})) .. " songs" end
				if cover then cover.Image = image; cover.Visible = image ~= "" end
				if default then default.Visible = image == "" end
				applyFavoriteVisual(card:FindFirstChild("AlbumLike"), pinnedToShortcuts)
			else
				card.Visible = false
				card:SetAttribute("CollectionName", nil)
			end
		end

		if shortcutSection then shortcutSection.Visible = true end
		if collectionSection then collectionSection.Visible = nextCollectionOrder > 0 end
		restoreCollectionLayout()
		task.defer(function()
			if collectionsScroll.Parent then
				restoreCollectionLayout()
			end
		end)
	end

	-- dipakai carousel playlist (CaaSystemLibrary): buka halaman playlist & pin/unpin playlist ke shortcut
	local function openCollectionFromCarousel(name)
		if type(name) ~= "string" or name == "" then return end
		state.suppressQueueUntil = math.max(tonumber(state.suppressQueueUntil) or 0, os.clock() + 0.40)
		cancelTransientInput()
		showCollection(name)
	end

	local function toggleCollectionPin(name)
		local key = collectionFavoriteKey(name)
		if type(name) ~= "string" or name == "" or not key then return end
		local target = not isCollectionFavorite(name)
		local representativeTrack = nil
		for _, track in ipairs(state.catalog) do
			if lower(trackCollection(track)) == lower(name) then
				representativeTrack = track
				break
			end
		end
		state.favorites[key] = target or nil
		state.favoritePending[key] = {value = target, expiresAt = os.clock() + 3}
		refreshFavoriteViews()
		notify(
			target and "success" or "error",
			target and "ADDED TO SHORTCUTS" or "REMOVED FROM SHORTCUTS",
			name,
			representativeTrack,
			3.2
		)
		fire("togglecollectionfavorite", {collection = name, enabled = target})
	end

	return {
		OpenCollection = openCollectionFromCarousel,
		TogglePin = toggleCollectionPin,
		TrackContainer = trackContainer,
		RenderTracks = renderTracks,
		UpdateCollectionCards = updateCollectionCards,
		UpdateLibrarySummary = updateLibrarySummary,
		ShowCollections = showCollections,
	}
end

return Module]]></ProtectedString>
							<string name="ScriptGuid">{96617DB9-EB02-46D1-B59F-C93258EE3CBE}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">CaaMusicLibraryController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXBD2A3087F73A4BD08318DBAA51AD9335">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- CaaSystemLibrary
-- Library: carousel (coverflow) kartu PLAYLIST di dalam panel "YOUR LIBRARY".
--   * Kartu di carousel = playlist (collection). Klik kartu tengah / tombol SELECT = buka daftar lagu playlist itu
--     (halaman playlist milik CaaMusicLibraryController: banner, search, kolom # / TITLE / COLLECTION / LIKED).
--   * Tombol panah / geser / klik kartu samping = pindah playlist. ADD FAVORITE = pin playlist ke shortcut.
-- Search bar di atas tetap milik panel lama (mencari lagu dari semua playlist).

local RunService       = game:GetService("RunService")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Module = {}

-- ═══════════ PALET ═══════════
local SILVER_HI = Color3.fromRGB(238, 238, 238)
local SILVER_LO = Color3.fromRGB(124, 124, 124)
local TEXT_DIM  = Color3.fromRGB(154, 154, 154)
local TEXT_DARK = Color3.fromRGB(15, 15, 15)
local GOLD      = Color3.fromRGB(213, 213, 213)
local CARD_BG   = Color3.fromRGB(13, 13, 13)
local DARK_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(32, 32, 32)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(11, 11, 11)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(23, 23, 23)),
})
local SILVER_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(228, 228, 228)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(154, 154, 154)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(208, 208, 208)),
})
local FONT = Enum.Font.DenkOne

-- ═══════════ UKURAN ═══════════
local SLOTS      = 2      -- jumlah kartu di kiri/kanan kartu tengah
local SCALE_STEP = 0.12
local DIM_STEP   = 0.2
local ARROW_PAD  = 56
local HEAD_H     = 58     -- ruang atas untuk nama playlist + jumlah lagu
local FOOT_H     = 56     -- ruang bawah untuk tombol

-- ═══════════ HELPER UI ═══════════
local function create(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then inst[k] = v end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end

local function corner(parent, r)
	return create("UICorner", {CornerRadius = UDim.new(0, r), Parent = parent})
end

local function blackGradient(parent, rotation)
	return create("UIGradient", {Color = DARK_SEQ, Rotation = rotation or 45, Parent = parent})
end

local function silverStroke(parent, thickness, transparency)
	local s = create("UIStroke", {
		Color = Color3.new(1, 1, 1),
		Thickness = math.max(1, (thickness or 1.5) * 0.7),
		Transparency = 0.2 + (transparency or 0) * 0.8,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
	create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, SILVER_HI),
			ColorSequenceKeypoint.new(0.5, SILVER_LO),
			ColorSequenceKeypoint.new(1, SILVER_HI),
		}),
		Rotation = 45,
		Parent = s,
	})
	return s
end

local function label(parent, props)
	local base = {
		BackgroundTransparency = 1, Font = FONT, TextSize = 14,
		TextColor3 = SILVER_HI, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = parent,
	}
	for k, v in pairs(props) do base[k] = v end
	return create("TextLabel", base)
end

-- Return: tombol, gradient, stroke, label teks
local function makeButton(parent, text, size, props)
	local textSize = (props and props.TextSize) or 14
	local btn = create("TextButton", {
		Size = size, BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false, Text = "", Parent = parent,
	})
	if props then
		for k, v in pairs(props) do
			if k ~= "TextSize" then btn[k] = v end
		end
	end
	corner(btn, 10)
	local grad = blackGradient(btn, 90)
	local st = silverStroke(btn, 1.1, 0.35)
	local sc = create("UIScale", {Scale = 1, Parent = btn})
	local txt = label(btn, {
		Name = "Txt", Size = UDim2.fromScale(1, 1), Text = text or "",
		TextSize = textSize, TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
	})
	btn.MouseEnter:Connect(function()
		TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Scale = 1.03}):Play()
		TweenService:Create(st, TweenInfo.new(0.15), {Transparency = 0.05}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(sc, TweenInfo.new(0.12), {Scale = 1}):Play()
		TweenService:Create(st, TweenInfo.new(0.15), {Transparency = 0.48}):Play()
	end)
	return btn, grad, st, txt
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- posisi pointer dalam koordinat panel (diisi Caa3DTilt saat panel dirender di bidang 3D)
local function ptOf(input)
	local f = rawget(_G, "CaaMusicPt")
	if f then
		local ok, v = pcall(f, input)
		if ok and typeof(v) == "Vector2" then return v end
	end
	return Vector2.new(input.Position.X, input.Position.Y)
end

-- ═══════════ MODUL ═══════════
function Module.new(ctx)
	local libraryView          = ctx.libraryView
	local state                = ctx.state
	local trackCollection      = ctx.trackCollection
	local trackImage           = ctx.trackImage
	local asset                = ctx.asset
	local lower                = ctx.lower
	local isFavorite           = ctx.isFavorite
	local isCollectionFavorite = ctx.isCollectionFavorite
	local bind                 = ctx.bindResponsiveActivate
	local library              = ctx.library

	-- pakai panel Library (header, search, halaman playlist); grid kartu lama disembunyikan
	local panel = libraryView:WaitForChild("LibraryPanel")
	panel.Visible = true
	local cardsContainer = panel:WaitForChild("CardsContainer")
	local oldScroll = cardsContainer:FindFirstChild("CollectionsScroll")
	if oldScroll then oldScroll.Visible = false end
	local stale = cardsContainer:FindFirstChild("SystemLibrary")
	if stale then stale:Destroy() end

	local items = {}
	local cPos, cTarget = 1, 1
	local swipeX, swipedAt = nil, 0

	local root = create("Frame", {
		Name = "SystemLibrary", BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = cardsContainer,
	})

	local fName = label(root, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(1, -140, 0, 26), Text = "", TextSize = 21,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local fSub = label(root, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 34),
		Size = UDim2.new(1, -140, 0, 18), Text = "", TextSize = 14, TextColor3 = TEXT_DIM,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	local bStage = create("Frame", {
		Position = UDim2.fromOffset(0, HEAD_H), Size = UDim2.new(1, 0, 1, -(HEAD_H + FOOT_H)),
		BackgroundTransparency = 1, ClipsDescendants = true, Parent = root,
	})

	-- kartu playlist (coverflow)
	local pool = {}
	for k = -SLOTS, SLOTS do
		local card = create("TextButton", {
			Name = "Card", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = CARD_BG,
			AutoButtonColor = false, Text = "", Visible = false, BorderSizePixel = 0, Parent = bStage,
		})
		corner(card, 14)
		local st = silverStroke(card, 1.4, 0.3)

		local img = create("ImageLabel", {
			Name = "Cover", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(22, 22, 22),
			BorderSizePixel = 0, Image = "", ScaleType = Enum.ScaleType.Crop, Parent = card,
		})
		corner(img, 14)

		local glyph = label(card, {
			Name = "Glyph", Size = UDim2.fromScale(1, 1), Text = "", TextSize = 64, TextColor3 = TEXT_DIM,
			TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.None, ZIndex = 2,
		})

		local dim = create("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3, Parent = card,
		})
		corner(dim, 14)

		local badge = label(card, {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8),
			Size = UDim2.fromOffset(28, 22), Text = "", TextXAlignment = Enum.TextXAlignment.Right,
			TextSize = 18, ZIndex = 6, TextColor3 = GOLD,
		})
		table.insert(pool, {k = k, card = card, stroke = st, img = img, glyph = glyph, dim = dim, badge = badge, idx = nil})
	end

	local arrowL = makeButton(bStage, "◀", UDim2.fromOffset(36, 36), {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), TextSize = 15, ZIndex = 40,
	})
	local arrowR = makeButton(bStage, "▶", UDim2.fromOffset(36, 36), {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), TextSize = 15, ZIndex = 40,
	})

	local actRow = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -40, 0, 40), BackgroundTransparency = 1, Parent = root,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = actRow,
	})
	local selBtn, selGrad, _, selTxt = makeButton(actRow, "SELECT", UDim2.fromOffset(190, 38), {LayoutOrder = 1, TextSize = 15})
	selGrad.Color = SILVER_SEQ
	selTxt.TextColor3 = TEXT_DARK
	-- tombol ADD/REMOVE FAVORITE dihapus; SELECT dibuat selebar kartu tengah (lihat renderCoverflow)

	-- ═══════════ DATA ═══════════
	local function buildItems()
		local list = {
			{key = "__FAVORITES__", name = "Liked Songs", glyph = "★", image = "", special = true, count = 0},
			{key = "__ALL__", name = "All Tracks", glyph = "♪", image = "", special = true, count = 0},
		}
		local byName = {}
		for _, col in ipairs(state.collections or {}) do
			local name = tostring(col.name or col.Name or "")
			if name ~= "" and not byName[lower(name)] then
				local it = {
					key = name, name = name, glyph = "♪", image = asset(col.image or col.Image),
					special = false, count = 0,
				}
				byName[lower(name)] = it
				table.insert(list, it)
			end
		end
		local favCount = 0
		local fallbackImg, favImg = "", ""
		for _, track in ipairs(state.catalog or {}) do
			local img = trackImage(track)
			local fav = isFavorite(track)
			if fav then favCount += 1 end
			if img ~= "" then
				if fallbackImg == "" then fallbackImg = img end
				if fav and favImg == "" then favImg = img end
			end
			local it = byName[lower(trackCollection(track))]
			if it then
				it.count += 1
				if it.image == "" then it.image = img end
			end
		end
		list[1].count = favCount
		list[2].count = #(state.catalog or {})
		-- card tanpa gambar memakai gambar lagu lain (bukan ikon polos)
		list[1].image = (favImg ~= "") and favImg or fallbackImg
		list[2].image = fallbackImg
		for _, it in ipairs(list) do
			if it.image == "" then it.image = fallbackImg end
		end
		return list
	end

	local function updateFooter()
		local sel = items[cTarget]
		local has = sel ~= nil
		fName.Visible, fSub.Visible, actRow.Visible = has, has, has
		if not has then return end
		fName.Text = string.upper(sel.name)
		fSub.Text = tostring(sel.count) .. (sel.count == 1 and " song" or " songs")
	end

	local function rebuild(keepSelection)
		local prevKey = nil
		if keepSelection and items[cTarget] then prevKey = items[cTarget].key end
		items = buildItems()
		for _, s in ipairs(pool) do s.idx = nil end
		local newIdx = (#items >= 3) and 3 or 1 -- awal: playlist pertama
		if prevKey then
			for i, it in ipairs(items) do
				if it.key == prevKey then newIdx = i break end
			end
		end
		cTarget = math.clamp(newIdx, 1, math.max(1, #items))
		cPos = cTarget
		updateFooter()
	end

	local function goTo(i)
		if #items == 0 then return end
		cTarget = math.clamp(i, 1, #items)
		updateFooter()
	end

	local function openSelected()
		local sel = items[cTarget]
		if sel and library and library.OpenCollection then
			library.OpenCollection(sel.key)
		end
	end

	-- ═══════════ AKSI ═══════════
	bind(arrowL, function() goTo(cTarget - 1) end)
	bind(arrowR, function() goTo(cTarget + 1) end)
	bind(selBtn, openSelected)

	for _, slot in ipairs(pool) do
		slot.card.InputBegan:Connect(function(input)
			if isPointer(input) then swipeX = ptOf(input).X end
		end)
		bind(slot.card, function()
			if tick() - swipedAt < 0.25 then return end
			if slot.idx and slot.idx ~= cTarget then
				goTo(slot.idx)
			else
				openSelected()
			end
		end)
	end
	bStage.InputBegan:Connect(function(input)
		if isPointer(input) then swipeX = ptOf(input).X end
	end)
	local inputConn = UserInputService.InputEnded:Connect(function(input)
		if isPointer(input) and swipeX then
			local dx = ptOf(input).X - swipeX
			swipeX = nil
			if math.abs(dx) > math.max(35, bStage.AbsoluteSize.X * 0.05) then
				swipedAt = tick()
				goTo(cTarget + (dx < 0 and 1 or -1))
			end
		end
	end)

	-- ═══════════ RENDER COVERFLOW ═══════════
	local lastSelScale = -1
	local function renderCoverflow()
		local sz = bStage.AbsoluteSize
		if sz.X < 10 or sz.Y < 10 then return end

		local cardS = math.max(60, (sz.Y - 12) * 0.9)
		-- SELECT presisi selebar kartu tengah (kartu tengah selalu di tengah stage, lebarnya = cardS)
		local rowW = actRow.AbsoluteSize.X
		if rowW > 10 then
			local wScale = math.min(1, cardS / rowW)
			if math.abs(wScale - lastSelScale) > 0.0005 then
				lastSelScale = wScale
				selBtn.Size = UDim2.new(wScale, 0, 0, 38)
			end
		end
		local minScale = 1 - SCALE_STEP * SLOTS
		local maxOff = math.max(cardS * 0.5, sz.X / 2 - ARROW_PAD - (cardS * minScale) / 2)
		local firstOff = math.min(cardS * 0.85, maxOff)

		local base = math.floor(cPos + 0.5)
		for _, s in ipairs(pool) do
			local idx = base + s.k
			local item = items[idx]
			local d = idx - cPos
			local ad = math.abs(d)
			if not item or ad > SLOTS + 0.01 then
				s.card.Visible = false
				s.idx = nil
			else
				local capped = math.min(ad, SLOTS)
				local size = cardS * (1 - SCALE_STEP * capped)
				local off = (d < 0 and -1 or 1) * firstOff * capped

				s.card.Visible = true
				-- ukuran berbasis proporsi stage (bukan offset), supaya tidak ikut digandakan oleh UIScale panel
				s.card.Size = UDim2.fromScale(size / sz.X, size / sz.Y)
				s.card.Position = UDim2.new(0.5 + off / sz.X, 0, 0.5, 0)
				s.card.ZIndex = 20 - math.floor(ad + 0.5)
				s.dim.BackgroundTransparency = 1 - math.min(0.75, capped * DIM_STEP)
				if s.idx ~= idx then
					s.idx = idx
					s.img.Image = item.image
					s.glyph.Text = item.image == "" and item.glyph or ""
				end
				local pinned = item.key == "__FAVORITES__" or ((not item.special) and isCollectionFavorite(item.name))
				s.badge.Text = pinned and "★" or ""
				s.stroke.Transparency = (ad < 0.5) and 0.02 or 0.5
			end
		end
	end

	local conn = RunService.RenderStepped:Connect(function(dt)
		if not (libraryView.Visible and state.panelOpen and cardsContainer.Visible) then return end
		if cPos ~= cTarget then
			cPos += (cTarget - cPos) * math.min(1, dt * 10)
			if math.abs(cTarget - cPos) < 0.003 then cPos = cTarget end
		end
		renderCoverflow()
	end)
	root.Destroying:Connect(function()
		conn:Disconnect()
		inputConn:Disconnect()
	end)

	-- ═══════════ REFRESH ═══════════
	local api = {Root = root}
	function api.Refresh()
		rebuild(true)
	end

	libraryView:GetPropertyChangedSignal("Visible"):Connect(function()
		if libraryView.Visible then api.Refresh() end
	end)

	rebuild(false)
	return api
end

return Module
]]></ProtectedString>
							<string name="ScriptGuid">{2E9C3164-ED09-482C-A548-6DB8815009F9}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">CaaSystemLibrary</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX65B6C9471C494941B214B1480A9DB933">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- CaaHomeSystem
-- Beranda bertema ungu "MUSIC SYSTEM / HUD AUDIO DIGITAL" (sesuai gambar referensi):
--   kiri   : kartu SEDANG DIPUTAR (judul + tombol Sukai Lagu), kartu PLAYLIST, kartu DITAMBAHKAN OLEH
--   tengah : piringan hitam (vinyl) + visualizer + progress + volume + tombol MUAT ULANG / LEWATI
--   kanan  : panel ANTREAN LAGU (thumbnail, judul, "oleh DJ nama", hapus & favorit)
-- Data & perintah tetap memakai state/fire milik controller Caa, jadi antrian, favorit,
-- skip, reload, dan volume berjalan seperti biasa. Interface modul tidak berubah
-- (Module.new(ctx) -> .Update(current, queue), .Refresh, .Root).

local TweenService = game:GetService("TweenService")
local RunService   = game:GetService("RunService")

local Module = {}

-- ═══════════ PALET (ungu) ═══════════
local BG_TOP     = Color3.fromRGB(13, 13, 13)
local BG_BOTTOM  = Color3.fromRGB(4, 4, 4)
local CARD       = Color3.fromRGB(12, 12, 12)
local CARD_ROW   = Color3.fromRGB(15, 15, 15)
local CARD_BTN   = Color3.fromRGB(16, 16, 16)
local TRACK_BG   = Color3.fromRGB(30, 30, 30)
local STROKE     = Color3.fromRGB(69, 69, 69)
local STROKE_HI  = Color3.fromRGB(120, 120, 120)
local ACCENT     = Color3.fromRGB(85, 85, 85)
local ACCENT_HI  = Color3.fromRGB(134, 134, 134)
local PINK       = Color3.fromRGB(132, 132, 132)
local LAV        = Color3.fromRGB(186, 186, 186)
local LAV_SOFT   = Color3.fromRGB(218, 218, 218)
local LAV_DIM    = Color3.fromRGB(137, 137, 137)
local WHITE      = Color3.fromRGB(255, 255, 255)
local RED        = Color3.fromRGB(107, 107, 107)
local DOT_ON     = Color3.fromRGB(115, 115, 115)
local GOLD       = Color3.fromRGB(213, 213, 213)

local F_BOLD = Enum.Font.DenkOne
local F_MED  = Enum.Font.DenkOne
local F_MONO = Enum.Font.DenkOne

-- ═══════════ ASET ═══════════
local FALLBACK_COVER = "rbxassetid://105553763321064"
local HEART_OUTLINE  = "rbxassetid://74169319275784"
local HEART_FILLED   = "rbxassetid://13321877099"
local TRASH_ICON     = "rbxassetid://14002617467"
local RELOAD_ICON    = "rbxassetid://93698862111936"
local SKIP_ICON      = "rbxassetid://88157743541229"

-- ═══════════ UKURAN ═══════════
local LEFT_W    = 0.235   -- lebar kolom kiri (proporsi)
local RIGHT_W   = 0.285   -- lebar kolom kanan (proporsi)
local CARD1_H   = 156     -- kartu SEDANG DIPUTAR
local CARD2_H   = 56      -- kartu PLAYLIST & DITAMBAHKAN OLEH
local STACK_GAP = 8
local BTN_H     = 40
local VOL_H     = 40
local PROG_H    = 30
local VIZ_H     = 44
local GAP       = 6
local VIZ_BARS  = 48
local ROW_H     = 64
local ROW_GAP   = 5
local QUEUE_MAX = 20
local SPIN_SPEED = 30     -- derajat/detik, putaran label piringan saat lagu jalan (0 = tidak berputar)

-- ═══════════ HELPER UI ═══════════
local function create(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then inst[k] = v end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end

local function corner(parent, r)
	return create("UICorner", {CornerRadius = UDim.new(0, r), Parent = parent})
end

local function circle(parent)
	return create("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = parent})
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color, Thickness = thickness or 1, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent,
	})
end

local function label(parent, props)
	local base = {
		BackgroundTransparency = 1, Font = F_MED, TextSize = 14,
		TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = parent,
	}
	for k, v in pairs(props) do base[k] = v end
	return create("TextLabel", base)
end

local function panel(parent, pos, size, anchor)
	local f = create("Frame", {
		Position = pos, Size = size, BackgroundColor3 = CARD,
		BorderSizePixel = 0, Parent = parent,
	})
	if anchor then f.AnchorPoint = anchor end
	corner(f, 12)
	stroke(f, STROKE, 1, 0.25)
	return f
end

-- tombol besar bergradien indigo (MUAT ULANG / LEWATI)
local function makeButton(parent, size, props, iconId, text)
	local btn = create("TextButton", {
		Size = size, BackgroundColor3 = WHITE, AutoButtonColor = false,
		Text = "", BorderSizePixel = 0, Parent = parent,
	})
	if props then
		for k, v in pairs(props) do btn[k] = v end
	end
	corner(btn, 10)
	create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(29, 29, 29), Color3.fromRGB(13, 13, 13)),
		Rotation = 90, Parent = btn,
	})
	local st = stroke(btn, Color3.fromRGB(91, 91, 91), 1, 0.15)
	local sc = create("UIScale", {Scale = 1, Parent = btn})

	local content = create("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = btn})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content,
	})
	create("ImageLabel", {
		LayoutOrder = 1, Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1,
		Image = iconId, ImageColor3 = LAV_SOFT, ScaleType = Enum.ScaleType.Fit, Parent = content,
	})
	label(content, {
		LayoutOrder = 2, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
		Text = text, Font = F_BOLD, TextSize = 13, TextTruncate = Enum.TextTruncate.None,
	})

	btn.MouseEnter:Connect(function()
		TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Scale = 1.02}):Play()
		TweenService:Create(st, TweenInfo.new(0.15), {Color = STROKE_HI, Transparency = 0}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(sc, TweenInfo.new(0.12), {Scale = 1}):Play()
		TweenService:Create(st, TweenInfo.new(0.15), {Color = Color3.fromRGB(91, 91, 91), Transparency = 0.15}):Play()
	end)
	return btn
end

local function fmtTime(seconds)
	seconds = math.max(0, tonumber(seconds) or 0)
	return string.format("%02d:%02d", math.floor(seconds / 60), math.floor(seconds % 60))
end

-- ═══════════ MODUL ═══════════
function Module.new(ctx)
	local homeView = ctx.homeView
	local state    = ctx.state
	local first    = ctx.first
	local trackId, trackName, trackImage = ctx.trackId, ctx.trackName, ctx.trackImage

	local self = {}
	local currentTrack, queueList = nil, {}

	local root = create("Frame", {
		Name = "CaaHomeSystem", BackgroundTransparency = 1,
		Position = UDim2.fromOffset(7, 7), Size = UDim2.new(1, -14, 1, -14), Parent = homeView,
	})

	-- ═══════════ LATAR ═══════════
	local backdrop = create("Frame", {
		Name = "Backdrop", Position = UDim2.fromOffset(-4, -4), Size = UDim2.new(1, 8, 1, 8),
		BackgroundColor3 = WHITE, BackgroundTransparency = 0.04, BorderSizePixel = 0, Parent = root,
	})
	corner(backdrop, 12)
	create("UIGradient", {Color = ColorSequence.new(BG_TOP, BG_BOTTOM), Rotation = 90, Parent = backdrop})

	-- cahaya ungu samar di kiri atas
	for i = 1, 5 do
		local d = 300 * (1 - (i - 1) * 0.14)
		local g = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(LEFT_W * 0.5, 0, 0.26, 0),
			Size = UDim2.fromOffset(d, d), BackgroundColor3 = ACCENT, BackgroundTransparency = 0.955,
			BorderSizePixel = 0, Parent = root,
		})
		circle(g)
	end

	-- ═══════════ KOLOM ═══════════
	local left = create("Frame", {
		Name = "HomeLeft", BackgroundTransparency = 1, Size = UDim2.new(LEFT_W, -8, 1, 0), Parent = root,
	})
	local center = create("Frame", {
		Name = "HomeCenter", BackgroundTransparency = 1,
		Position = UDim2.new(LEFT_W, 4, 0, 0), Size = UDim2.new(1 - LEFT_W - RIGHT_W, -12, 1, 0), Parent = root,
	})
	local right = panel(root, UDim2.new(1 - RIGHT_W, 4, 0, 0), UDim2.new(RIGHT_W, -4, 1, 0))
	right.Name = "HomeRight"

	-- ═══════════ KIRI: KARTU INFO ═══════════
	local stackH = CARD1_H + CARD2_H * 2 + STACK_GAP * 2
	local stack = create("Frame", {
		Name = "InfoStack", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, stackH), BackgroundTransparency = 1, Parent = left,
	})
	local nowCard = panel(stack, UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, CARD1_H))
	nowCard.Name = "NowCard"
	local plCard = panel(stack, UDim2.fromOffset(0, CARD1_H + STACK_GAP), UDim2.new(1, 0, 0, CARD2_H))
	plCard.Name = "PlaylistCard"
	local byCard = panel(stack, UDim2.fromOffset(0, CARD1_H + STACK_GAP * 2 + CARD2_H), UDim2.new(1, 0, 0, CARD2_H))
	byCard.Name = "QueuedByCard"

	-- pill status
	local pill = create("Frame", {
		Name = "StatusPill", Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(142, 24),
		BackgroundColor3 = Color3.fromRGB(45, 45, 45), BorderSizePixel = 0, Parent = nowCard,
	})
	corner(pill, 12)
	stroke(pill, Color3.fromRGB(92, 92, 92), 1, 0.45)
	local pillDot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = DOT_ON, BorderSizePixel = 0, Parent = pill,
	})
	circle(pillDot)
	local pillText = label(pill, {
		Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -28, 1, 0), Text = "SEDANG DIPUTAR",
		Font = F_MONO, TextSize = 10, TextColor3 = LAV, TextTruncate = Enum.TextTruncate.None,
	})

	-- judul lagu
	local songTitle = label(nowCard, {
		Name = "SongTitle", Position = UDim2.fromOffset(14, 48), Size = UDim2.new(1, -28, 0, 54),
		Text = "Menunggu lagu...", Font = F_BOLD, TextSize = 20,
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
	})

	-- tombol Sukai Lagu
	local likeBtn = create("TextButton", {
		Name = "LikeButton", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.new(1, -28, 0, 36), BackgroundColor3 = CARD_BTN, AutoButtonColor = false,
		Text = "", BorderSizePixel = 0, Parent = nowCard,
	})
	corner(likeBtn, 10)
	local likeStroke = stroke(likeBtn, STROKE_HI, 1, 0.35)
	local likeContent = create("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = likeBtn})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = likeContent,
	})
	local likeIcon = create("ImageLabel", {
		LayoutOrder = 1, Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
		Image = HEART_OUTLINE, ImageColor3 = LAV, ScaleType = Enum.ScaleType.Fit, Parent = likeContent,
	})
	local likeText = label(likeContent, {
		LayoutOrder = 2, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
		Text = "Sukai Lagu", Font = F_BOLD, TextSize = 13, TextColor3 = LAV, TextTruncate = Enum.TextTruncate.None,
	})
	likeBtn.MouseEnter:Connect(function()
		TweenService:Create(likeStroke, TweenInfo.new(0.15), {Transparency = 0}):Play()
	end)
	likeBtn.MouseLeave:Connect(function()
		TweenService:Create(likeStroke, TweenInfo.new(0.15), {Transparency = 0.35}):Play()
	end)

	-- kartu PLAYLIST & DITAMBAHKAN OLEH
	local function infoCard(card, title, rich)
		label(card, {
			Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -28, 0, 12), Text = title,
			Font = F_MONO, TextSize = 10, TextColor3 = LAV_DIM,
		})
		return label(card, {
			Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -28, 0, 20), Text = "-",
			Font = F_BOLD, TextSize = 15, RichText = rich == true,
		})
	end
	local playlistValue = infoCard(plCard, "PLAYLIST", false)
	local queuedValue   = infoCard(byCard, "DITAMBAHKAN OLEH", true)

	-- ═══════════ TENGAH: LAYOUT VERTIKAL ═══════════
	local progBottom = BTN_H + GAP + VOL_H + GAP
	local vizBottom  = progBottom + PROG_H + 4
	local discRes    = vizBottom + VIZ_H + 8

	local discArea = create("Frame", {
		Name = "DiscArea", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -discRes), Parent = center,
	})

	-- cahaya di sekeliling piringan
	local glowLayers = {}
	local glowScales = {1.12, 1.085, 1.055, 1.025}
	for i, s in ipairs(glowScales) do
		local g = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			SizeConstraint = Enum.SizeConstraint.RelativeYY, Size = UDim2.fromScale(0.94 * s, 0.94 * s),
			BackgroundColor3 = ACCENT, BackgroundTransparency = 0.93 - (i - 1) * 0.01,
			BorderSizePixel = 0, Parent = discArea,
		})
		circle(g)
		glowLayers[i] = g
	end

	-- piringan hitam
	local disc = create("Frame", {
		Name = "Disc", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		SizeConstraint = Enum.SizeConstraint.RelativeYY, Size = UDim2.fromScale(0.94, 0.94),
		BackgroundColor3 = Color3.fromRGB(3, 3, 3), BorderSizePixel = 0, Parent = discArea,
	})
	circle(disc)
	stroke(disc, STROKE_HI, 2, 0.1)

	-- alur (groove) piringan
	for _, r in ipairs({0.92, 0.84, 0.77, 0.69, 0.61, 0.54}) do
		local ring = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(r, r), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = disc,
		})
		circle(ring)
		stroke(ring, Color3.fromRGB(56, 56, 56), 1, 0.45)
	end

	-- label tengah (cover lagu, ikut berputar)
	local labelArt = create("ImageLabel", {
		Name = "LabelArt", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.45, 0.45), BackgroundColor3 = Color3.fromRGB(23, 23, 23),
		Image = FALLBACK_COVER, ScaleType = Enum.ScaleType.Crop, ZIndex = 2, Parent = disc,
	})
	circle(labelArt)
	stroke(labelArt, Color3.fromRGB(116, 116, 116), 2, 0)

	-- lubang tengah
	local hole = create("Frame", {
		Name = "Hole", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.05, 0.05), BackgroundColor3 = Color3.fromRGB(238, 238, 238),
		BorderSizePixel = 0, ZIndex = 3, Parent = disc,
	})
	circle(hole)
	stroke(hole, Color3.fromRGB(103, 103, 103), 2, 0)

	local function coverOf(track)
		local img = track and trackImage(track) or ""
		if img == nil or img == "" then return FALLBACK_COVER end
		return img
	end

	-- ═══════════ TENGAH: VISUALIZER ═══════════
	local viz = panel(center, UDim2.new(0, 0, 1, -vizBottom), UDim2.new(1, 0, 0, VIZ_H), Vector2.new(0, 1))
	viz.Name = "VisualizerPanel"
	local barsArea = create("Frame", {
		Name = "Visualizer", Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 1, -12),
		BackgroundTransparency = 1, ClipsDescendants = true, Parent = viz,
	})
	local vizBars = {}
	for i = 1, VIZ_BARS do
		local b = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new((i - 0.5) / VIZ_BARS, 0, 1, 0),
			Size = UDim2.new(0, 3, 0.08, 0), BackgroundColor3 = PINK, BorderSizePixel = 0, Parent = barsArea,
		})
		corner(b, 2)
		vizBars[i] = {
			frame = b, v = 0.08, shown = 0.08,
			phase = i * 0.28 + math.random() * 0.25,
			speed = 2.4 + math.random() * 0.5,
		}
	end
	local vizLevel, vizAvg, vizBeat = 0, 0, 0

	-- ═══════════ TENGAH: PROGRESS ═══════════
	local progRow = create("Frame", {
		Name = "Progress", AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 1, -progBottom), Size = UDim2.new(1, 0, 0, PROG_H), Parent = center,
	})
	local progTrack = create("Frame", {
		Name = "Track", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0, 8),
		Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = TRACK_BG, BorderSizePixel = 0, Parent = progRow,
	})
	corner(progTrack, 3)
	local progFill = create("Frame", {
		Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = progTrack,
	})
	corner(progFill, 3)
	create("UIGradient", {Color = ColorSequence.new(ACCENT, ACCENT_HI), Parent = progFill})
	local progKnob = create("Frame", {
		Name = "Knob", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.fromRGB(242, 242, 242),
		BorderSizePixel = 0, ZIndex = 3, Parent = progTrack,
	})
	circle(progKnob)
	stroke(progKnob, ACCENT_HI, 3, 0)
	local timeLeft = label(progRow, {
		Position = UDim2.fromOffset(0, 16), Size = UDim2.fromOffset(60, 14), Text = "00:00",
		Font = F_MONO, TextSize = 11, TextColor3 = Color3.fromRGB(153, 153, 153),
	})
	local timeRight = label(progRow, {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 16), Size = UDim2.fromOffset(60, 14),
		Text = "00:00", Font = F_MONO, TextSize = 11, TextColor3 = Color3.fromRGB(153, 153, 153),
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	-- ═══════════ TENGAH: VOLUME ═══════════
	local volBox = panel(center, UDim2.new(0, 0, 1, -(BTN_H + GAP)), UDim2.new(1, 0, 0, VOL_H), Vector2.new(0, 1))
	volBox.Name = "VolumePanel"
	local volBtn = create("TextButton", {
		Name = "Mute", Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(56, VOL_H),
		BackgroundTransparency = 1, Text = "VOLUME", Font = F_MONO, TextSize = 10, TextColor3 = LAV_DIM,
		TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, Parent = volBox,
	})
	local volValue = label(volBox, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(48, VOL_H),
		Text = "100%", Font = F_MONO, TextSize = 12, TextColor3 = LAV_SOFT, TextXAlignment = Enum.TextXAlignment.Right,
	})
	local volSlot = create("Frame", {
		Name = "SliderSlot", Position = UDim2.fromOffset(76, 0), Size = UDim2.new(1, -(76 + 66), 1, 0),
		BackgroundTransparency = 1, Parent = volBox,
	})
	local volBg = create("Frame", {
		Name = "SliderBg", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = TRACK_BG, BorderSizePixel = 0, Parent = volSlot,
	})
	corner(volBg, 3)
	local volFill = create("Frame", {
		Name = "SliderFill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = volBg,
	})
	corner(volFill, 3)
	create("UIGradient", {Color = ColorSequence.new(ACCENT, ACCENT_HI), Parent = volFill})
	local volKnob = create("Frame", {
		Name = "SliderKnob", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Color3.fromRGB(157, 157, 157),
		BorderSizePixel = 0, ZIndex = 3, Parent = volBg,
	})
	circle(volKnob)
	local volHit = create("TextButton", {
		Name = "SliderButton", Position = UDim2.new(0, 0, 0, -12), Size = UDim2.new(1, 0, 1, 24),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6, Parent = volBg,
	})
	if ctx.bindSlider then
		ctx.bindSlider(volBg, 0, 1, function(value)
			if ctx.setVolume then ctx.setVolume(value) end
		end)
	end

	-- ═══════════ TENGAH: TOMBOL ═══════════
	local btnRow = create("Frame", {
		Name = "Buttons", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, BTN_H), BackgroundTransparency = 1, Parent = center,
	})
	local reloadBtn = makeButton(btnRow, UDim2.new(0.5, -4, 1, 0), nil, RELOAD_ICON, "MUAT ULANG")
	reloadBtn.Name = "ReloadButton"
	local skipBtn = makeButton(btnRow, UDim2.new(0.5, -4, 1, 0), {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
	}, SKIP_ICON, "LEWATI")
	skipBtn.Name = "SkipButton"

	-- ═══════════ KANAN: ANTREAN LAGU ═══════════
	label(right, {
		Position = UDim2.fromOffset(14, 17), Size = UDim2.new(1, -70, 0, 18), Text = "ANTREAN LAGU",
		Font = F_BOLD, TextSize = 12,
	})
	local badge = create("Frame", {
		Name = "CountBadge", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 15),
		Size = UDim2.fromOffset(36, 22), BackgroundColor3 = Color3.fromRGB(67, 67, 67), BorderSizePixel = 0, Parent = right,
	})
	corner(badge, 11)
	local queueCount = label(badge, {
		Size = UDim2.fromScale(1, 1), Text = "0", Font = F_BOLD, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.None,
	})
	create("Frame", {
		Name = "HeaderDivider", Position = UDim2.fromOffset(14, 47), Size = UDim2.new(1, -28, 0, 1),
		BackgroundColor3 = Color3.fromRGB(46, 46, 46), BorderSizePixel = 0, Parent = right,
	})

	local queueScroll = create("ScrollingFrame", {
		Name = "QueueScroll", Position = UDim2.fromOffset(8, 56), Size = UDim2.new(1, -16, 1, -64),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = STROKE_HI,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, Active = true, Parent = right,
	})
	create("UIListLayout", {Padding = UDim.new(0, ROW_GAP), SortOrder = Enum.SortOrder.LayoutOrder, Parent = queueScroll})
	if ctx.configureScrollingFrame then pcall(ctx.configureScrollingFrame, queueScroll) end

	local emptyLabel = label(right, {
		Name = "Empty", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, -30, 0, 36), Text = "Antrean kosong", Font = F_MED, TextSize = 13,
		TextColor3 = LAV_DIM, TextXAlignment = Enum.TextXAlignment.Center, Visible = false,
	})

	-- ═══════════ AKSI ═══════════
	local function bindActivate(button, callback)
		if ctx.bindResponsiveActivate then
			ctx.bindResponsiveActivate(button, callback)
		else
			button.Activated:Connect(callback)
		end
	end

	bindActivate(reloadBtn, function() if ctx.onReload then ctx.onReload() end end)
	bindActivate(skipBtn, function() if ctx.onSkip then ctx.onSkip() end end)
	bindActivate(likeBtn, function()
		if currentTrack then ctx.toggleFavorite(currentTrack) end
	end)
	bindActivate(volBtn, function()
		if state.muted or (state.localVolume or 1) <= 0.0001 then
			if ctx.setVolume then ctx.setVolume(math.clamp((state.lastVolume or 0) > 0 and state.lastVolume or 1, 0.05, 1)) end
		else
			state.lastVolume = math.clamp(state.localVolume or 1, 0.05, 1)
			if ctx.setVolume then ctx.setVolume(0, true) end
		end
	end)

	-- ═══════════ ANTREAN ═══════════
	local lastIsDJ = state.isDJ == true

	local function rebuildQueue()
		for _, c in ipairs(queueScroll:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end

		local count = #queueList
		queueCount.Text = tostring(count)
		emptyLabel.Visible = count == 0
		queueScroll.Visible = count > 0

		for index, track in ipairs(queueList) do
			if index > QUEUE_MAX then break end

			local row = create("Frame", {
				Name = "Row", Size = UDim2.new(1, -6, 0, ROW_H), BackgroundColor3 = CARD_ROW,
				BorderSizePixel = 0, LayoutOrder = index, Parent = queueScroll,
			})
			corner(row, 10)
			stroke(row, STROKE, 1, 0.55)

			local thumb = create("ImageLabel", {
				Position = UDim2.fromOffset(9, 10), Size = UDim2.fromOffset(44, 44),
				BackgroundColor3 = Color3.fromRGB(19, 19, 19), Image = coverOf(track),
				ScaleType = Enum.ScaleType.Crop, Parent = row,
			})
			corner(thumb, 8)

			local showTrash = state.isDJ == true
			local rightPad = showTrash and 76 or 44

			label(row, {
				Position = UDim2.fromOffset(62, 8), Size = UDim2.new(1, -(62 + rightPad), 0, 30),
				Text = trackName(track), Font = F_BOLD, TextSize = 12,
				TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
			})
			local by = ctx.requesterDisplay and ctx.requesterDisplay(track) or ""
			label(row, {
				Position = UDim2.fromOffset(62, 41), Size = UDim2.new(1, -(62 + rightPad), 0, 16),
				Text = '<font color="#B79DFF">oleh</font> ' .. by, Font = F_MED, TextSize = 11, RichText = true,
			})

			-- favorit (hati)
			local isFav = ctx.isFavorite(track)
			local heart = create("ImageButton", {
				Name = "Heart", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, AutoButtonColor = false, Image = "", Parent = row,
			})
			create("ImageLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = isFav and UDim2.fromScale(0.68, 0.68) or UDim2.fromScale(0.86, 0.86),
				BackgroundTransparency = 1, Image = isFav and HEART_FILLED or HEART_OUTLINE,
				ImageColor3 = isFav and GOLD or Color3.fromRGB(164, 164, 164),
				ScaleType = Enum.ScaleType.Fit, Parent = heart,
			})
			bindActivate(heart, function() ctx.toggleFavorite(track) end)

			-- hapus dari antrean (khusus DJ)
			if showTrash then
				local rem = create("ImageButton", {
					Name = "Remove", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -40, 0.5, 0),
					Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, AutoButtonColor = false, Image = "", Parent = row,
				})
				create("ImageLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(0.72, 0.72), BackgroundTransparency = 1,
					Image = TRASH_ICON, ImageColor3 = RED, ScaleType = Enum.ScaleType.Fit, Parent = rem,
				})
				local busyUntil = 0
				bindActivate(rem, function()
					if not state.isDJ then return end
					local now = os.clock()
					if now < busyUntil then return end
					busyUntil = now + 0.45
					if ctx.fire then ctx.fire("removequeue", {index = index}) end
				end)
			end
		end
	end

	-- ═══════════ UPDATE DATA ═══════════
	local lastPillMode = nil
	local function setPill(mode)
		if mode == lastPillMode then return end
		lastPillMode = mode
		if mode == "playing" then
			pillText.Text = "SEDANG DIPUTAR"
			pillDot.BackgroundColor3 = DOT_ON
		elseif mode == "paused" then
			pillText.Text = "DIJEDA"
			pillDot.BackgroundColor3 = LAV_DIM
		else
			pillText.Text = "MENUNGGU LAGU"
			pillDot.BackgroundColor3 = LAV_DIM
		end
	end

	local function collectionOf(track)
		if not track then return "-" end
		local v
		if ctx.trackCollection then v = ctx.trackCollection(track) end
		if v == nil or tostring(v) == "" then
			v = first(track, {"collection", "Collection", "col"}, "")
		end
		v = tostring(v or "")
		if v == "" then return "AutoPlay" end
		return v
	end

	local function refreshLike()
		local fav = currentTrack ~= nil and ctx.isFavorite(currentTrack) or false
		likeIcon.Image = fav and HEART_FILLED or HEART_OUTLINE
		likeIcon.ImageColor3 = fav and GOLD or LAV
		likeText.Text = fav and "Disukai" or "Sukai Lagu"
		likeText.TextColor3 = fav and GOLD or LAV
	end

	local function refreshInfo()
		local m = currentTrack
		songTitle.Text = m and trackName(m) or "Menunggu lagu..."
		labelArt.Image = coverOf(m)
		playlistValue.Text = collectionOf(m)
		queuedValue.Text = m and (ctx.requesterDisplay and ctx.requesterDisplay(m) or "-") or "-"
		refreshLike()
		local playing = first(state.packet, {"playing", "Playing", "isPlaying", "IsPlaying"}, false) == true
		setPill(m and (playing and "playing" or "paused") or "idle")
	end

	function self.Update(current, queue)
		currentTrack = type(current) == "table" and current or nil
		queueList = type(queue) == "table" and queue or {}
		lastIsDJ = state.isDJ == true
		refreshInfo()
		rebuildQueue()
	end

	-- ═══════════ ANIMASI (progress, visualizer, volume, putaran piringan) ═══════════
	local shownVolume = -1
	local clock = 0
	RunService.RenderStepped:Connect(function(dt)
		if not homeView.Visible or not state.panelOpen then return end

		local packet = state.packet
		local packetPlaying = first(packet, {"playing", "Playing", "isPlaying", "IsPlaying"}, false) == true

		-- status pill ikut play / pause
		setPill(currentTrack and (packetPlaying and "playing" or "paused") or "idle")

		-- tombol hapus antrean muncul/hilang saat status DJ berubah
		local isDJNow = state.isDJ == true
		if isDJNow ~= lastIsDJ then
			lastIsDJ = isDJNow
			rebuildQueue()
		end

		-- progress
		local duration = tonumber(first(packet, {"duration", "Duration", "timeLength", "TimeLength"}, 0)) or 0
		local position = tonumber(first(packet, {"timePosition", "TimePosition", "position", "Position"}, 0)) or 0
		local serverTime = tonumber(first(packet, {"serverTime", "ServerTime"}, workspace:GetServerTimeNow())) or workspace:GetServerTimeNow()
		local speed = tonumber(first(packet, {"playbackSpeed", "PlaybackSpeed"}, 1)) or 1
		if packetPlaying then position += math.max(0, workspace:GetServerTimeNow() - serverTime) * speed end
		if duration > 0 then position = math.clamp(position, 0, duration) end
		local ratio = duration > 0 and math.clamp(position / duration, 0, 1) or 0
		progFill.Size = UDim2.fromScale(ratio, 1)
		progKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
		timeLeft.Text = fmtTime(position)
		timeRight.Text = fmtTime(duration)

		-- piringan berputar saat lagu jalan
		if packetPlaying and currentTrack and SPIN_SPEED ~= 0 then
			labelArt.Rotation = (labelArt.Rotation + dt * SPIN_SPEED) % 360
		end

		-- visualizer
		clock += dt
		local sound = ctx.getSound and ctx.getSound() or nil
		local active = packetPlaying
		local raw = 0
		if active then
			local loud = sound and sound.IsPlaying and sound.PlaybackLoudness or 0
			raw = math.clamp(loud / 450, 0, 1)
			if raw < 0.02 then
				raw = 0.35 + 0.25 * (math.noise(clock * 1.3, 7.1) + 0.5)
			end
		end
		vizLevel += (raw - vizLevel) * math.min(1, dt * 10)
		vizAvg += (raw - vizAvg) * math.min(1, dt * 1.5)
		vizBeat = math.max(0, vizBeat - dt * 3.5)
		if active and raw - vizAvg > 0.08 then vizBeat = 1 end

		for i, b in ipairs(vizBars) do
			local wob = 0.5 + 0.5 * math.sin(clock * b.speed + b.phase)
			local nz = math.clamp(math.noise(i * 0.12, clock * 1.8) + 0.5, 0, 1)
			local target
			if active then
				local kick = vizBeat * 0.3
				target = 0.08 + vizLevel * 0.85 * (0.25 + 0.75 * (0.6 * wob + 0.4 * nz)) + kick
			else
				target = 0.08 + 0.04 * (0.5 + 0.5 * math.sin(clock * 1.6 + b.phase))
			end
			target = math.clamp(target, 0.05, 1)
			local rate = target > b.v and 26 or 8
			b.v += (target - b.v) * math.min(1, dt * rate)
			if math.abs(b.v - b.shown) > 0.003 then
				b.shown = b.v
				b.frame.Size = UDim2.new(0, 3, b.v, 0)
			end
		end

		-- cahaya piringan ikut dentuman
		for i, g in ipairs(glowLayers) do
			g.BackgroundTransparency = math.clamp(0.93 - (i - 1) * 0.01 - vizLevel * 0.05 - vizBeat * 0.03, 0.8, 1)
		end

		-- volume (ikut nilai volume lokal controller)
		local vol = state.muted and 0 or (state.localVolume or 1)
		if vol ~= shownVolume then
			shownVolume = vol
			volFill.Size = UDim2.new(vol, 0, 1, 0)
			volKnob.Position = UDim2.new(vol, 0, 0.5, 0)
			volValue.Text = state.muted and "MUTED" or string.format("%d%%", math.floor(vol * 100 + 0.5))
		end
	end)

	self.Root = root
	self.Refresh = function() self.Update(currentTrack, queueList) end
	return self
end

return Module
]]></ProtectedString>
							<string name="ScriptGuid">{A15A6D67-C294-41AF-84FB-93A4D7CE62DF}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">CaaHomeSystem</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX98FCE956F27C492ABBF9E772746726A8">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- CaaDualDeck  •  tampilan "VIRTUAL DJ PRO"
-- Layout: DECK A | MIXER | DECK B  +  BROWSER (library / saved / muat via ID audio)
--   DECK A  = lagu yang sedang diputar (semua kontrol tersambung ke music system)
--   DECK B  = lagu berikutnya di antrian (PLAY = mainkan sekarang, EJECT = buang dari antrian)
--   MIXER   = EQ, FILTER, efek (ECH / FLG / REV / TREM / FILT), master, channel fader,
--             crossfader (geser ke B = pindah ke lagu berikutnya), MUTE, XF SMOOTH
-- Catatan: music system memakai SATU sound, jadi kontrol audio (EQ, efek, tempo, cue, loop)
-- hanya berlaku untuk Deck A. Kontrol Deck B yang tidak punya fungsi ditampilkan redup.

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Module = {}

-- ═══════════ PENGATURAN ═══════════
local HORN_SOUND_ID = ""            -- isi "rbxassetid://123456" kalau mau tombol HORN bersuara (lokal)
local FALLBACK_COVER = "rbxassetid://105553763321064"
local DEFAULT_BPM = 128             -- BPM awal sebelum di-TAP
local REL_MIN, REL_MAX = 0.5, 1.5   -- rentang fader tempo (relatif terhadap kecepatan asli lagu)
local EQ_MIN, EQ_MAX = -20, 10
local NB = 78                       -- jumlah batang waveform
local WAVE_RATE = 10                -- batang per detik lagu
local VU_N = 16
local DECK_H = 292

-- ═══════════ PALET ═══════════
local C = {
	win = Color3.fromRGB(13, 13, 13),
	card = Color3.fromRGB(20, 20, 20),
	field = Color3.fromRGB(35, 35, 35),
	stroke = Color3.fromRGB(51, 51, 51),
	btn = Color3.fromRGB(41, 41, 41),
	btnHi = Color3.fromRGB(51, 51, 51),
	text = Color3.fromRGB(238, 238, 238),
	dim = Color3.fromRGB(154, 154, 154),
	blue = Color3.fromRGB(238, 238, 238),
	orange = Color3.fromRGB(213, 213, 213),
	red = Color3.fromRGB(119, 119, 119),
	green = Color3.fromRGB(238, 238, 238),
	yellow = Color3.fromRGB(213, 213, 213),
	wave = Color3.fromRGB(124, 124, 124),
	black = Color3.fromRGB(10, 10, 10),
	cap = Color3.fromRGB(208, 208, 208),
	ledOff = Color3.fromRGB(32, 32, 32),
}
local FB, FM, FR = Enum.Font.DenkOne, Enum.Font.DenkOne, Enum.Font.DenkOne

-- posisi pointer dalam koordinat panel (diisi Caa3DTilt bila panel dirender di bidang 3D)
local function ptOf(input)
	local f = rawget(_G, "CaaMusicPt")
	if f then
		local ok, v = pcall(f, input)
		if ok and typeof(v) == "Vector2" then return v end
	end
	return Vector2.new(input.Position.X, input.Position.Y)
end

-- ═══════════ HELPER UI ═══════════
local function create(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then inst[k] = v end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end

local function corner(parent, r)
	return create("UICorner", {CornerRadius = UDim.new(0, r), Parent = parent})
end

local function circle(parent)
	return create("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = parent})
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or C.stroke, Thickness = thickness or 1, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent,
	})
end

local function label(parent, props)
	local base = {
		BackgroundTransparency = 1, Font = FM, TextSize = 10, TextColor3 = C.text,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		Text = "", Parent = parent,
	}
	for k, v in pairs(props) do base[k] = v end
	return create("TextLabel", base)
end

local function fmtTime(seconds)
	seconds = math.max(0, tonumber(seconds) or 0)
	return string.format("%d:%02d", math.floor(seconds / 60), math.floor(seconds % 60))
end

local function fmtTimeT(seconds)
	seconds = math.max(0, tonumber(seconds) or 0)
	return string.format("%d:%02d.%d", math.floor(seconds / 60), math.floor(seconds % 60), math.floor((seconds * 10) % 10))
end

local function seedOf(text)
	local h = 7
	for i = 1, #text do h = (h * 31 + string.byte(text, i)) % 2147483629 end
	return h
end

-- amplitudo waveform palsu tapi deterministik per lagu
local function ampAt(seed, k)
	if k < 0 then return 0.04 end
	local s = (seed % 997) * 0.37
	local a = math.abs(math.noise(k * 0.13 + s, 1.7, 3.1)) * 1.9
	local b = math.abs(math.noise(k * 0.41 + s, 5.3, 0.4)) * 1.2
	local c = math.abs(math.sin(k * 0.27 + s))
	return math.clamp(0.14 + 0.38 * a + 0.2 * b + 0.22 * c, 0.07, 1)
end

-- drag generik (mouse & touch)
local function bindDrag(hit, onBegin, onMove, onEnd)
	local active
	hit.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		active = input
		onBegin(ptOf(input))
		input.Changed:Connect(function()
			if active == input and (input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel) then
				active = nil
				onEnd()
			end
		end)
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not active then return end
		local okMouse = active.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
		local okTouch = active.UserInputType == Enum.UserInputType.Touch and input == active
		if okMouse or okTouch then onMove(ptOf(input)) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if active and (input == active or (active.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			active = nil
			onEnd()
		end
	end)
end

-- tombol datar bergaya Virtual DJ
local function mkButton(parent, text, pos, size, o)
	o = o or {}
	local base = o.color or C.text
	local btn = create("TextButton", {
		Position = pos, Size = size, BackgroundColor3 = C.btn, AutoButtonColor = false, BorderSizePixel = 0,
		Text = text, Font = o.font or FB, TextSize = o.ts or 11, TextColor3 = base, Parent = parent,
	})
	corner(btn, o.r or 5)
	local st = stroke(btn, C.stroke, 1)
	local b = {Instance = btn, on = false, enabled = true}
	local hover = false
	local accent = o.accent or C.green
	local function paint()
		if b.on then
			btn.BackgroundColor3 = C.btn:Lerp(accent, 0.22)
			btn.TextColor3 = accent
			st.Color = accent
		else
			btn.BackgroundColor3 = hover and b.enabled and C.btnHi or C.btn
			btn.TextColor3 = base
			st.Color = C.stroke
		end
		btn.TextTransparency = b.enabled and 0 or 0.6
		btn.BackgroundTransparency = b.enabled and 0 or 0.45
		st.Transparency = b.enabled and 0 or 0.6
	end
	function b.set(on)
		on = on == true
		if b.on ~= on then b.on = on paint() end
	end
	function b.setText(t) if btn.Text ~= t then btn.Text = t end end
	function b.setAccent(c) accent = c paint() end
	function b.disable()
		b.enabled = false
		btn.Active = false
		paint()
	end
	btn.MouseEnter:Connect(function() hover = true paint() end)
	btn.MouseLeave:Connect(function() hover = false paint() end)
	b.paint = paint
	return b
end

-- baris tombol rata (n tombol dengan celah g)
local function rowPos(i, n, g, y)
	return UDim2.new((i - 1) / n, (i - 1) * g / n, 0, y)
end
local function rowSize(n, g, h)
	return UDim2.new(1 / n, -g * (n - 1) / n, 0, h)
end

-- ═══════════ MODUL ═══════════
function Module.new(ctx)
	local state, first = ctx.state, ctx.first
	local trackName, trackImage = ctx.trackName, ctx.trackImage
	local fire = ctx.fire
	local parentGui = ctx.scroll

	local self = {}
	local trackA, trackB, queueList = nil, nil, {}
	local lastDrag = 0

	-- padding lama halaman DJ dikecilkan supaya tampilan muat penuh
	local pad = parentGui:FindFirstChildOfClass("UIPadding")
	if pad then
		pad.PaddingLeft = UDim.new(0, 6); pad.PaddingRight = UDim.new(0, 6)
		pad.PaddingTop = UDim.new(0, 6); pad.PaddingBottom = UDim.new(0, 6)
	end
	local old = parentGui:FindFirstChild("CaaDualDeckRow")
	if old then old:Destroy() end

	local row = create("Frame", {
		Name = "CaaDualDeckRow", BackgroundColor3 = C.win, LayoutOrder = 0,
		Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0, ZIndex = 5, Parent = parentGui,
	})
	corner(row, 10)
	stroke(row, Color3.fromRGB(51, 51, 51), 1)

	local function bindActivate(button, callback)
		if ctx.bindResponsiveActivate then
			ctx.bindResponsiveActivate(button, callback)
		else
			button.Activated:Connect(callback)
		end
	end
	local function onPress(b, callback)
		bindActivate(b.Instance, function()
			if b.enabled then callback() end
		end)
	end

	-- ═══════════ ANTRIAN PERINTAH (server membatasi ±0.08 dtk / perintah) ═══════════
	local pending = {}
	local sinceSend = 0
	local function send(action, payload, key)
		if not fire then return end
		if key then
			for _, item in ipairs(pending) do
				if item.key == key then item.payload = payload return end
			end
		end
		table.insert(pending, {action = action, payload = payload, key = key})
	end

	-- ═══════════ DATA DARI PAKET SERVER ═══════════
	local function pget(names, default) return first(state.packet, names, default) end
	local function effectsNow()
		local e = pget({"effects", "Effects"}, {})
		return type(e) == "table" and e or {}
	end
	local function isPlayingNow() return pget({"playing", "Playing", "isPlaying", "IsPlaying"}, false) == true end
	local function currentSpeed() return tonumber(pget({"playbackSpeed", "PlaybackSpeed"}, 1)) or 1 end
	local function keyOf(track) return track and trackName(track) or nil end

	local localSeek -- {pos, t} supaya posisi langsung terasa setelah seek (sebelum paket server tiba)
	local function positionNow()
		local playing = isPlayingNow()
		local speed = currentSpeed()
		local duration = tonumber(pget({"duration", "Duration", "timeLength", "TimeLength"}, 0)) or 0
		local position = tonumber(pget({"timePosition", "TimePosition", "position", "Position"}, 0)) or 0
		local nowT = workspace:GetServerTimeNow()
		local serverTime = tonumber(pget({"serverTime", "ServerTime"}, nowT)) or nowT
		if localSeek and serverTime < localSeek.t then
			position = localSeek.pos
			serverTime = localSeek.t
		end
		if playing then position += math.max(0, nowT - serverTime) * speed end
		if duration > 0 then position = math.clamp(position, 0, duration) end
		return position, duration, playing, speed
	end
	local function seekTo(pos)
		pos = math.max(0, pos)
		localSeek = {pos = pos, t = workspace:GetServerTimeNow()}
		send("seek", pos, "seek")
	end

	-- kecepatan asli tiap lagu (supaya "1.00x" = kecepatan aslinya)
	local nativeSpeed = {}
	local function nativeOf(track)
		local k = keyOf(track)
		if not k then return 1 end
		if nativeSpeed[k] == nil then
			local found
			for _, t in ipairs(state.catalog or {}) do
				if trackName(t) == k then
					found = tonumber(first(t, {"playbackSpeed", "PlaybackSpeed"}, nil))
					break
				end
			end
			nativeSpeed[k] = found or currentSpeed()
		end
		return nativeSpeed[k]
	end
	local function relNow()
		local n = trackA and nativeOf(trackA) or 1
		return currentSpeed() / math.max(n, 0.05)
	end
	local function setRel(rel)
		rel = math.clamp(rel, REL_MIN, REL_MAX)
		local n = trackA and nativeOf(trackA) or 1
		send("setspeed", math.clamp(rel * n, 0.1, 2), "speed")
	end

	-- memori per lagu (lokal)
	local hot, cuePt, baseBpm = {}, {}, {}
	local loop = {active = false, start = 0, stop = 0, beats = 0}
	local function baseBpmOf(track)
		local k = keyOf(track)
		return (k and baseBpm[k]) or DEFAULT_BPM
	end

	-- ═══════════ TITLE BAR ═══════════
	label(row, {
		Position = UDim2.fromOffset(12, 3), Size = UDim2.new(0.3, 0, 0, 18), Text = "VIRTUAL DJ PRO",
		Font = FB, TextSize = 14,
	})
	local closeBtn = mkButton(row, "x", UDim2.new(1, -36, 0, 3), UDim2.fromOffset(28, 18), {ts = 12, r = 4})
	onPress(closeBtn, function() if ctx.close then ctx.close() end end)
	local clock = label(row, {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -44, 0, 3), Size = UDim2.fromOffset(70, 18),
		Text = os.date("%H:%M:%S"), TextSize = 11, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Right,
	})
	local djBtn = mkButton(row, "MODE DJ  OFF", UDim2.new(0.5, 0, 0, 3), UDim2.fromOffset(116, 18), {ts = 10, r = 9, accent = C.yellow})
	djBtn.Instance.AnchorPoint = Vector2.new(0.5, 0)
	onPress(djBtn, function() send("toggledjmode") end)

	local DECK_Y = 26

	-- ═══════════ OVERLAY: MODE DJ OFF → UI gelap & diam ═══════════
	local offShade = create("Frame", {
		Name = "DJOffShade", Position = UDim2.fromOffset(0, DECK_Y), Size = UDim2.new(1, 0, 1, -DECK_Y),
		BackgroundColor3 = Color3.fromRGB(10, 10, 10), BackgroundTransparency = 0.06, BorderSizePixel = 0,
		Active = true, ZIndex = 100, Visible = true, Parent = row,
	})
	corner(offShade, 8)
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(20, 20, 20), Color3.fromRGB(5, 5, 5)),
		Transparency = NumberSequence.new(0.1, 0.04),
		Parent = offShade,
	})
	stroke(offShade, C.yellow, 1, 0.82)
	local offTitle = label(offShade, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.46, 0), Size = UDim2.new(1, -40, 0, 30),
		Text = "MODE DJ MASIH OFF", Font = FB, TextSize = 22, TextColor3 = C.yellow,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 101,
	})
	local offSub = label(offShade, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.46, 30), Size = UDim2.new(1, -40, 0, 18),
		Text = "Nyalakan MODE DJ di tombol tengah atas untuk memakai deck", Font = FM, TextSize = 13, TextColor3 = C.dim,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 101,
	})
	local offShown = nil
	local function setDjOffShade(djOn)
		if offShown == (not djOn) then return end
		offShown = not djOn
		offShade.Visible = not djOn
		if not djOn then
			offSub.Text = (state.isDJ == true) and "Tekan tombol MODE DJ di tengah atas untuk menyalakan"
				or "Hanya DJ yang bisa menyalakan MODE DJ"
		end
	end

	-- ═══════════ DECK ═══════════
	local function buildDeck(isA)
		local acc = isA and C.blue or C.orange
		local d = {isA = isA, acc = acc}

		local card = create("Frame", {
			Name = isA and "DeckA" or "DeckB", BackgroundColor3 = C.card, BorderSizePixel = 0,
			Position = UDim2.new(isA and 0 or 0.618, isA and 6 or 0, 0, DECK_Y), Size = UDim2.new(0.382, -6, 0, DECK_H), Parent = row,
		})
		corner(card, 8)
		stroke(card, acc, 1.3, 0.1)
		d.card = card

		-- header
		local badge = create("Frame", {Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = acc, BorderSizePixel = 0, Parent = card})
		corner(badge, 6)
		label(badge, {Size = UDim2.fromScale(1, 1), Text = isA and "A" or "B", Font = FB, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center})
		local mini = create("ImageLabel", {
			Position = UDim2.fromOffset(42, 6), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = C.black,
			Image = FALLBACK_COVER, ScaleType = Enum.ScaleType.Crop, BorderSizePixel = 0, Parent = card,
		})
		circle(mini)
		stroke(mini, C.stroke, 1)
		d.mini = mini
		d.title = label(card, {
			Position = UDim2.fromOffset(80, 5), Size = UDim2.new(1, -80 - 80, 0, 19),
			Text = isA and "TRACK 1 - READY" or "TRACK 2 - READY", Font = FB, TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd,
		})
		d.sub = label(card, {
			Position = UDim2.fromOffset(80, 24), Size = UDim2.new(1, -80 - 80, 0, 13),
			Text = "Unknown", TextSize = 10, TextColor3 = C.dim, RichText = true, TextTruncate = Enum.TextTruncate.AtEnd,
		})
		label(card, {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 3), Size = UDim2.fromOffset(70, 9),
			Text = "BPM", TextSize = 8, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Right,
		})
		d.bpm = label(card, {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 10), Size = UDim2.fromOffset(72, 18),
			Text = "128.0", Font = FB, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Right,
		})
		d.pct = label(card, {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 28), Size = UDim2.fromOffset(72, 11),
			Text = "+0.0%", Font = FB, TextSize = 10, TextColor3 = acc, TextXAlignment = Enum.TextXAlignment.Right,
		})

		-- waveform (playhead di tengah)
		local wf = create("Frame", {
			Position = UDim2.fromOffset(8, 46), Size = UDim2.new(1, -16, 0, 34), BackgroundColor3 = C.black,
			BorderSizePixel = 0, ClipsDescendants = true, Parent = card,
		})
		corner(wf, 4)
		stroke(wf, C.stroke, 1)
		d.bars = {}
		d.heights = {}
		for i = 1, NB do
			d.bars[i] = create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new((i - 1) / NB, 0, 0.5, 0), Size = UDim2.new(1 / NB, -1, 0.1, 0),
				BackgroundColor3 = (i <= NB / 2) and acc or C.wave, BorderSizePixel = 0, Parent = wf,
			})
			d.heights[i] = -1
		end
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3, Parent = wf,
		})
		d.tElapsed = label(card, {Position = UDim2.fromOffset(8, 82), Size = UDim2.fromOffset(80, 11), Text = "0:00.0", TextSize = 9})
		d.tTotal = label(card, {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 82), Size = UDim2.fromOffset(80, 11),
			Text = "0:00", TextSize = 9, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center,
		})
		d.tRemain = label(card, {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 82), Size = UDim2.fromOffset(80, 11),
			Text = "-0:00.0", TextSize = 9, TextXAlignment = Enum.TextXAlignment.Right,
		})
		d.waveKey, d.waveBase, d.waveSeed = nil, nil, 1

		-- platter
		local plat = create("Frame", {
			Position = UDim2.fromOffset(10, 100), Size = UDim2.fromOffset(112, 112), BackgroundColor3 = Color3.fromRGB(20, 20, 20), BorderSizePixel = 0, Parent = card,
		})
		circle(plat)
		stroke(plat, Color3.fromRGB(124, 124, 124), 2)
		for i = 0, 47 do
			local ang = math.rad(i * 7.5)
			create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, math.sin(ang) * 51, 0.5, -math.cos(ang) * 51),
				Size = UDim2.fromOffset(2, (i % 4 == 0) and 6 or 3), Rotation = i * 7.5,
				BackgroundColor3 = Color3.fromRGB(95, 95, 95), BorderSizePixel = 0, Parent = plat,
			})
		end
		local spin = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(90, 90),
			BackgroundColor3 = Color3.fromRGB(10, 10, 10), BorderSizePixel = 0, Parent = plat,
		})
		circle(spin)
		stroke(spin, Color3.fromRGB(42, 42, 42), 1)
		for _, s in ipairs({0.9, 0.76, 0.62}) do
			local g = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(s, s),
				BackgroundTransparency = 1, BorderSizePixel = 0, Parent = spin,
			})
			circle(g)
			stroke(g, Color3.fromRGB(35, 35, 35), 1)
		end
		local cover = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.52, 0.52),
			BackgroundColor3 = Color3.fromRGB(25, 25, 25), Image = FALLBACK_COVER, ScaleType = Enum.ScaleType.Crop, BorderSizePixel = 0, Parent = spin,
		})
		circle(cover)
		local spindle = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = C.text, BorderSizePixel = 0, ZIndex = 3, Parent = spin,
		})
		circle(spindle)
		local marker = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 3), Size = UDim2.fromOffset(5, 10),
			BackgroundColor3 = acc, BorderSizePixel = 0, ZIndex = 3, Parent = spin,
		})
		corner(marker, 2)
		d.spin, d.cover = spin, cover
		d.status = label(card, {Position = UDim2.fromOffset(12, 222), Size = UDim2.fromOffset(100, 14), Text = "READY", Font = FB, TextSize = 10, TextColor3 = C.dim})

		-- kolom kontrol
		local ctl = create("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(130, 100), Size = UDim2.new(1, -130 - 50, 0, 176), Parent = card})
		d.cue = mkButton(ctl, "CUE", rowPos(1, 3, 4, 0), rowSize(3, 4, 27), {ts = 12, accent = C.yellow})
		d.play = mkButton(ctl, "PLAY", rowPos(2, 3, 4, 0), rowSize(3, 4, 27), {ts = 12, accent = C.green})
		d.sync = mkButton(ctl, "SYNC", rowPos(3, 3, 4, 0), rowSize(3, 4, 27), {ts = 12, accent = acc})

		label(ctl, {Position = UDim2.fromOffset(0, 31), Size = UDim2.new(1, 0, 0, 10), Text = "HOT CUE", Font = FB, TextSize = 8})
		d.hc = {}
		for i = 1, 4 do
			d.hc[i] = mkButton(ctl, tostring(i), rowPos(i, 4, 4, 42), rowSize(4, 4, 22), {ts = 11, accent = acc})
		end

		label(ctl, {Position = UDim2.fromOffset(0, 68), Size = UDim2.new(0, 70, 0, 10), Text = "LOOP (BEAT)", Font = FB, TextSize = 8})
		d.loopIn = mkButton(ctl, "IN", UDim2.new(1, -86, 0, 67), UDim2.fromOffset(26, 12), {ts = 7, r = 3, accent = acc})
		d.loopOut = mkButton(ctl, "OUT", UDim2.new(1, -57, 0, 67), UDim2.fromOffset(26, 12), {ts = 7, r = 3, accent = acc})
		d.loopExit = mkButton(ctl, "EXIT", UDim2.new(1, -28, 0, 67), UDim2.fromOffset(28, 12), {ts = 7, r = 3, accent = acc})
		d.lb = {}
		local beats = {1, 2, 4, 8, 16, 32}
		for i, n in ipairs(beats) do
			d.lb[i] = mkButton(ctl, tostring(n), rowPos(i, 6, 3, 81), rowSize(6, 3, 22), {ts = 10, accent = acc})
		end

		label(ctl, {Position = UDim2.fromOffset(0, 108), Size = UDim2.new(1, 0, 0, 10), Text = "BEND / TAP BPM", Font = FB, TextSize = 8})
		d.bendL = mkButton(ctl, "<<", rowPos(1, 3, 4, 119), rowSize(3, 4, 24), {ts = 12, accent = acc})
		d.bendR = mkButton(ctl, ">>", rowPos(2, 3, 4, 119), rowSize(3, 4, 24), {ts = 12, accent = acc})
		d.tap = mkButton(ctl, "TAP", rowPos(3, 3, 4, 119), rowSize(3, 4, 24), {ts = 11, accent = acc})

		d.vocal = mkButton(ctl, "VOCAL", rowPos(1, 5, 3, 150), rowSize(5, 3, 26), {ts = 7, color = acc, accent = acc})
		d.instr = mkButton(ctl, "INSTR", rowPos(2, 5, 3, 150), rowSize(5, 3, 26), {ts = 7, color = acc, accent = acc})
		d.kick = mkButton(ctl, "KICK", rowPos(3, 5, 3, 150), rowSize(5, 3, 26), {ts = 7, color = acc, accent = acc})
		d.reset = mkButton(ctl, "RESET", rowPos(4, 5, 3, 150), rowSize(5, 3, 26), {ts = 7, color = acc, accent = acc})
		d.eject = mkButton(ctl, "EJECT", rowPos(5, 5, 3, 150), rowSize(5, 3, 26), {ts = 7, color = C.red, accent = C.red})

		-- kolom tempo
		local tmp = create("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 100), Size = UDim2.fromOffset(40, 176), Parent = card})
		label(tmp, {Size = UDim2.new(1, 0, 0, 9), Text = "TEMPO", Font = FB, TextSize = 8, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center})
		d.tempoLbl = label(tmp, {
			Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 12), Text = "1.00x", Font = FB, TextSize = 11, TextColor3 = acc,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		local ttrack = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 36), Size = UDim2.new(0, 5, 0, 94),
			BackgroundColor3 = C.black, BorderSizePixel = 0, Parent = tmp,
		})
		corner(ttrack, 2)
		stroke(ttrack, C.stroke, 1)
		for i = 0, 10 do
			local w = (i % 5 == 0) and 8 or 4
			create("Frame", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0, -3, i / 10, 0), Size = UDim2.fromOffset(w, 1),
				BackgroundColor3 = (i == 5) and acc or Color3.fromRGB(89, 89, 89), BorderSizePixel = 0, Parent = ttrack,
			})
			create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(1, 3, i / 10, 0), Size = UDim2.fromOffset(w, 1),
				BackgroundColor3 = (i == 5) and acc or Color3.fromRGB(89, 89, 89), BorderSizePixel = 0, Parent = ttrack,
			})
		end
		local tfill = create("Frame", {
			AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.5),
			BackgroundColor3 = acc, BorderSizePixel = 0, Parent = ttrack,
		})
		corner(tfill, 2)
		local tcap = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(30, 14),
			BackgroundColor3 = C.cap, BorderSizePixel = 0, ZIndex = 3, Parent = ttrack,
		})
		corner(tcap, 3)
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -6, 0, 2),
			BackgroundColor3 = acc, BorderSizePixel = 0, ZIndex = 4, Parent = tcap,
		})
		d.tcap, d.tfill, d.ttrack = tcap, tfill, ttrack
		d.rst = mkButton(tmp, "RST", UDim2.new(0.5, -18, 0, 140), UDim2.fromOffset(36, 22), {ts = 9, accent = acc})

		local hit = create("TextButton", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 28), Size = UDim2.fromOffset(40, 110),
			BackgroundTransparency = 1, Text = "", ZIndex = 6, Parent = tmp,
		})
		local lastY = 0
		local function fromY(y)
			local h = math.max(1, ttrack.AbsoluteSize.Y)
			local r = math.clamp(1 - (y - ttrack.AbsolutePosition.Y) / h, 0, 1)
			local rel = REL_MIN + r * (REL_MAX - REL_MIN)
			rel = math.floor(rel * 100 + 0.5) / 100
			if math.abs(rel - 1) < 0.02 then rel = 1 end
			lastDrag = os.clock()
			d.setTempoVisual(rel)
			setRel(rel)
		end
		bindDrag(hit, function(p) lastY = p.Y fromY(p.Y) end, function(p) lastY = p.Y fromY(p.Y) end, function() fromY(lastY) end)
		function d.setTempoVisual(rel)
			local r = math.clamp((rel - REL_MIN) / (REL_MAX - REL_MIN), 0, 1)
			tcap.Position = UDim2.fromScale(0.5, 1 - r)
			tfill.Size = UDim2.fromScale(1, r)
		end
		d.setTempoVisual(1)
		return d
	end

	local deckA = buildDeck(true)
	local deckB = buildDeck(false)

	-- ═══════════ MIXER ═══════════
	local mixer = create("Frame", {
		Name = "Mixer", BackgroundColor3 = C.card, BorderSizePixel = 0,
		Position = UDim2.new(0.382, 4, 0, DECK_Y), Size = UDim2.new(0.236, -8, 0, DECK_H), Parent = row,
	})
	corner(mixer, 8)
	stroke(mixer, C.stroke, 1.2, 0.1)

	label(mixer, {Position = UDim2.new(0, 8, 0, 4), Size = UDim2.fromOffset(40, 13), Text = "CH A", Font = FB, TextSize = 10, TextColor3 = C.blue})
	label(mixer, {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(60, 13), Text = "MASTER", Font = FB, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center})
	label(mixer, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.fromOffset(40, 13), Text = "CH B", Font = FB, TextSize = 10, TextColor3 = C.orange, TextXAlignment = Enum.TextXAlignment.Right})

	local function dimGroup(g, off)
		g.GroupTransparency = off and 0.6 or 0
	end

	-- knob putar
	local knobs = {}
	local function mkKnob(xScale, top, name, minV, maxV, defV, fmt, enabled, onChange)
		local cell = create("CanvasGroup", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(xScale, 0, 0, top),
			Size = UDim2.fromOffset(46, 44), Parent = mixer,
		})
		local body = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 1), Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Color3.fromRGB(28, 28, 28), BorderSizePixel = 0, Parent = cell,
		})
		circle(body)
		stroke(body, Color3.fromRGB(91, 91, 91), 1.5)
		local rot = create("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = body})
		local ind = create("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.fromOffset(2, 9), BackgroundColor3 = C.text, BorderSizePixel = 0, Parent = rot})
		corner(ind, 1)
		label(cell, {Position = UDim2.new(0, 0, 0, 33), Size = UDim2.new(1, 0, 0, 10), Text = name, Font = FB, TextSize = 9, TextXAlignment = Enum.TextXAlignment.Center})
		local k = {value = defV, min = minV, max = maxV, enabled = enabled}
		local function angleOf(v)
			if v >= defV then return 135 * (v - defV) / math.max(maxV - defV, 1e-6) end
			return -135 * (defV - v) / math.max(defV - minV, 1e-6)
		end
		function k.set(v)
			v = math.clamp(v, minV, maxV)
			k.value = v
			rot.Rotation = angleOf(v)
		end
		k.set(defV)
		dimGroup(cell, not enabled)
		if enabled then
			local hit = create("TextButton", {
				AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(44, 44),
				BackgroundTransparency = 1, Text = "", ZIndex = 6, Parent = cell,
			})
			local startY, startV, lastClick = 0, defV, 0
			bindDrag(hit, function(p)
				startY, startV = p.Y, k.value
				if os.clock() - lastClick < 0.3 then
					k.set(defV)
					onChange(defV)
				end
				lastClick = os.clock()
				lastDrag = os.clock()
			end, function(p)
				lastDrag = os.clock()
				k.set(startV + (startY - p.Y) / 120 * (maxV - minV))
				onChange(k.value)
			end, function()
				lastDrag = os.clock()
				onChange(k.value)
			end)
		end
		knobs[name .. (xScale < 0.5 and "_A" or "_B")] = k
		return k
	end

	local function sendEq(field, v)
		send("seteffect", {effect = "equalizer", enabled = true, [field] = v}, "fx:eq:" .. field)
	end
	local activePreset
	local function eqKnobTouched() activePreset = nil end
	local kHI = mkKnob(0.125, 20, "HI", EQ_MIN, EQ_MAX, 0, nil, true, function(v) eqKnobTouched() sendEq("highGain", v) end)
	local kMID = mkKnob(0.325, 20, "MID", EQ_MIN, EQ_MAX, 0, nil, true, function(v) eqKnobTouched() sendEq("midGain", v) end)
	local kLOW = mkKnob(0.125, 64, "LOW", EQ_MIN, EQ_MAX, 0, nil, true, function(v) eqKnobTouched() sendEq("lowGain", v) end)
	local kFIL = mkKnob(0.325, 64, "FILTER", -1, 1, 0, nil, true, function(v)
		send("seteffect", {effect = "filter", enabled = math.abs(v) > 0.04, cutoff = (v + 1) / 2}, "fx:filter")
	end)
	mkKnob(0.675, 20, "HI", EQ_MIN, EQ_MAX, 0, nil, false)
	mkKnob(0.875, 20, "MID", EQ_MIN, EQ_MAX, 0, nil, false)
	mkKnob(0.675, 64, "LOW", EQ_MIN, EQ_MAX, 0, nil, false)
	mkKnob(0.875, 64, "FILTER", -1, 1, 0, nil, false)

	-- tombol efek kecil per channel
	local fxBtns = {}
	local function mkMini(xScale, y, text, enabled, effect)
		local b = mkButton(mixer, text, UDim2.new(xScale, 0, 0, y), UDim2.new(0.135, 0, 0, 16), {ts = 8, r = 4, accent = C.green})
		if enabled then
			onPress(b, function()
				local e = effectsNow()[effect]
				local on = type(e) == "table" and e.enabled == true
				send("seteffect", {effect = effect, enabled = not on}, "fx:" .. effect)
			end)
			fxBtns[effect] = b
		else
			b.disable()
		end
		return b
	end
	mkMini(0.03, 110, "ECH", true, "echo")
	mkMini(0.165, 110, "FLG", true, "flanger")
	mkMini(0.30, 110, "REV", true, "reverb")
	mkMini(0.545, 110, "ECH", false)
	mkMini(0.68, 110, "FLG", false)
	mkMini(0.815, 110, "REV", false)

	-- VU (segmen LED)
	local function mkVU(xScale, top, height, w, enabled)
		local holder = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(xScale, 0, 0, top), Size = UDim2.fromOffset(w, height),
			BackgroundTransparency = 1, Parent = mixer,
		})
		holder.Visible = enabled ~= false
		local segs = {}
		for i = 1, VU_N do
			local col = (i <= 10) and C.green or ((i <= 13) and C.yellow or C.red)
			segs[i] = create("Frame", {
				AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1 - (i - 1) / VU_N, 0), Size = UDim2.new(1, 0, 1 / VU_N, -1),
				BackgroundColor3 = col, BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = holder,
			})
		end
		local level = 0
		return function(target, dt)
			level += (target - level) * math.min(1, dt * (target > level and 18 or 7))
			local n = math.floor(level * VU_N + 0.5)
			for i = 1, VU_N do segs[i].BackgroundTransparency = (i <= n) and 0 or 0.85 end
		end
	end

	-- fader vertikal
	local function mkVFader(xScale, top, height, capW, capH, accent, enabled, onChange)
		local holder = create("CanvasGroup", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(xScale, 0, 0, top),
			Size = UDim2.fromOffset(capW + 22, height), Parent = mixer,
		})
		local track = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, capH / 2), Size = UDim2.new(0, 4, 1, -capH),
			BackgroundColor3 = C.black, BorderSizePixel = 0, Parent = holder,
		})
		corner(track, 2)
		stroke(track, C.stroke, 1)
		for i = 0, 10 do
			local w = (i % 5 == 0) and 8 or 4
			create("Frame", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0, -3, i / 10, 0), Size = UDim2.fromOffset(w, 1),
				BackgroundColor3 = Color3.fromRGB(89, 89, 89), BorderSizePixel = 0, Parent = track,
			})
			create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(1, 3, i / 10, 0), Size = UDim2.fromOffset(w, 1),
				BackgroundColor3 = Color3.fromRGB(89, 89, 89), BorderSizePixel = 0, Parent = track,
			})
		end
		local cap = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(capW, capH),
			BackgroundColor3 = C.cap, BorderSizePixel = 0, ZIndex = 3, Parent = track,
		})
		corner(cap, 3)
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -6, 0, 2),
			BackgroundColor3 = accent, BorderSizePixel = 0, ZIndex = 4, Parent = cap,
		})
		local f = {}
		function f.set(v)
			v = math.clamp(v, 0, 1)
			f.value = v
			cap.Position = UDim2.fromScale(0.5, 1 - v)
		end
		f.set(1)
		dimGroup(holder, not enabled)
		if enabled then
			local hit = create("TextButton", {
				AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1, Text = "", ZIndex = 6, Parent = holder,
			})
			local lastY = 0
			local function fromY(y)
				local h = math.max(1, track.AbsoluteSize.Y)
				local v = math.clamp(1 - (y - track.AbsolutePosition.Y) / h, 0, 1)
				v = math.floor(v * 100 + 0.5) / 100
				lastDrag = os.clock()
				f.set(v)
				onChange(v)
			end
			bindDrag(hit, function(p) lastY = p.Y fromY(p.Y) end, function(p) lastY = p.Y fromY(p.Y) end, function() fromY(lastY) end)
		end
		return f
	end

	-- volume: master × channel A × crossfader (× mute)
	local vol = {master = 0.5, ch = 1, xf = 1, muted = false}
	local function effVol() return vol.muted and 0 or math.clamp(vol.master * vol.ch * vol.xf, 0, 10) end
	local function pushVolume() send("setvolume", effVol(), "vol") end

	local vuA = mkVU(0.06, 138, 96, 8, true)
	local vuB = mkVU(0.94, 138, 96, 8, true)
	local vuM = mkVU(0.42, 22, 142, 8, true)
	local fadA = mkVFader(0.215, 134, 104, 24, 12, C.blue, true, function(v) vol.ch = v pushVolume() end)
	mkVFader(0.785, 134, 104, 24, 12, C.orange, false)
	local fadM = mkVFader(0.5, 20, 148, 26, 14, C.text, true, function(v) vol.master = v pushVolume() end)
	fadM.set(vol.master)

	-- MUTE MAIN & XF SMOOTH
	local muteBtn = mkButton(mixer, "MUTE\nMAIN", UDim2.new(0.5, -34, 0, 172), UDim2.fromOffset(68, 24), {ts = 8, accent = C.red})
	muteBtn.Instance.LineHeight = 0.95
	onPress(muteBtn, function()
		vol.muted = not vol.muted
		muteBtn.set(vol.muted)
		pushVolume()
	end)
	local xfBtn = mkButton(mixer, "XF\nSMOOTH", UDim2.new(0.5, -34, 0, 200), UDim2.fromOffset(68, 24), {ts = 8, accent = C.yellow})
	xfBtn.Instance.LineHeight = 0.95

	-- HORN / TREM / FILT
	local hornBtn = mkButton(mixer, "HORN", UDim2.new(0.03, 0, 0, 242), UDim2.new(0.3, -2, 0, 16), {ts = 8, r = 4, accent = C.red})
	local tremBtn = mkButton(mixer, "TREM", UDim2.new(0.35, 0, 0, 242), UDim2.new(0.3, 0, 0, 16), {ts = 8, r = 4, accent = C.green})
	local filtBtn = mkButton(mixer, "FILT", UDim2.new(0.67, 2, 0, 242), UDim2.new(0.3, -2, 0, 16), {ts = 8, r = 4, accent = C.green})
	fxBtns.tremolo = tremBtn
	fxBtns.filter = filtBtn
	onPress(tremBtn, function()
		local e = effectsNow().tremolo
		send("seteffect", {effect = "tremolo", enabled = not (type(e) == "table" and e.enabled == true)}, "fx:tremolo")
	end)
	onPress(filtBtn, function()
		local e = effectsNow().filter
		local on = type(e) == "table" and e.enabled == true
		send("seteffect", {effect = "filter", enabled = not on, cutoff = (kFIL.value + 1) / 2}, "fx:filter")
	end)
	local hornSound
	onPress(hornBtn, function()
		if HORN_SOUND_ID == "" then
			hornBtn.setText("NO ID")
			task.delay(1.2, function() hornBtn.setText("HORN") end)
			return
		end
		if not hornSound then
			hornSound = create("Sound", {SoundId = HORN_SOUND_ID, Volume = 1, Parent = row})
		end
		hornSound:Play()
		hornBtn.set(true)
		task.delay(0.4, function() hornBtn.set(false) end)
	end)

	-- crossfader
	label(mixer, {Position = UDim2.new(0, 8, 0, 266), Size = UDim2.fromOffset(12, 20), Text = "A", Font = FB, TextSize = 11, TextColor3 = C.blue})
	label(mixer, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 266), Size = UDim2.fromOffset(12, 20), Text = "B", Font = FB, TextSize = 11, TextColor3 = C.orange, TextXAlignment = Enum.TextXAlignment.Right})
	local xTrack = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 26, 0, 276), Size = UDim2.new(1, -52, 0, 4),
		BackgroundColor3 = C.black, BorderSizePixel = 0, Parent = mixer,
	})
	corner(xTrack, 2)
	stroke(xTrack, C.stroke, 1)
	for i = 0, 10 do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(i / 10, 0, 0, -3), Size = UDim2.fromOffset(1, (i % 5 == 0) and 6 or 3),
			BackgroundColor3 = Color3.fromRGB(89, 89, 89), BorderSizePixel = 0, Parent = xTrack,
		})
	end
	local xCap = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(16, 20),
		BackgroundColor3 = C.cap, BorderSizePixel = 0, ZIndex = 3, Parent = xTrack,
	})
	corner(xCap, 3)
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, -6),
		BackgroundColor3 = Color3.fromRGB(31, 31, 31), BorderSizePixel = 0, ZIndex = 4, Parent = xCap,
	})
	local xfPos, xfAuto = 0, nil
	local function xfVisual() xCap.Position = UDim2.fromScale(xfPos, 0.5) end
	local function xfApply(p)
		xfPos = math.clamp(p, 0, 1)
		vol.xf = math.cos(xfPos * math.pi / 2)
		xfVisual()
		pushVolume()
	end
	local function xfFinish()
		if trackB then send("skip") end
		task.delay(0.4, function()
			xfPos = 0
			vol.xf = 1
			xfVisual()
			pushVolume()
		end)
	end
	local xHit = create("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 18, 0, 276), Size = UDim2.new(1, -36, 0, 30),
		BackgroundTransparency = 1, Text = "", ZIndex = 6, Parent = mixer,
	})
	local xLastX = 0
	local function xFromX(x)
		local w = math.max(1, xTrack.AbsoluteSize.X)
		xfAuto = nil
		xfBtn.set(false)
		lastDrag = os.clock()
		xfApply((x - xTrack.AbsolutePosition.X) / w)
	end
	bindDrag(xHit, function(p) xLastX = p.X xFromX(p.X) end, function(p) xLastX = p.X xFromX(p.X) end, function()
		if xfPos >= 0.97 then xfFinish() end
	end)
	onPress(xfBtn, function()
		if xfAuto then
			xfAuto = nil
			xfBtn.set(false)
			xfApply(0)
		else
			xfAuto = {t0 = os.clock(), dur = 4, from = xfPos}
			xfBtn.set(true)
		end
	end)

	-- ═══════════ BROWSER ═══════════
	local BROWSER_Y = DECK_Y + DECK_H + 6
	local browser = create("Frame", {
		Name = "Browser", BackgroundColor3 = C.card, BorderSizePixel = 0,
		Position = UDim2.new(0, 6, 0, BROWSER_Y), Size = UDim2.new(1, -12, 1, -BROWSER_Y - 6), Parent = row,
	})
	corner(browser, 8)
	stroke(browser, C.stroke, 1.2, 0.1)

	label(browser, {Position = UDim2.fromOffset(16, 7), Size = UDim2.fromOffset(66, 22), Text = "BROWSER", Font = FB, TextSize = 12})
	local tab = "LIBRARY"
	local tabLib = create("TextButton", {
		Position = UDim2.fromOffset(88, 7), Size = UDim2.fromOffset(76, 22), BackgroundColor3 = C.text, AutoButtonColor = false,
		Text = "LIBRARY", Font = FB, TextSize = 10, TextColor3 = C.black, BorderSizePixel = 0, Parent = browser,
	})
	corner(tabLib, 11)
	local tabSaved = create("TextButton", {
		Position = UDim2.fromOffset(168, 7), Size = UDim2.fromOffset(66, 22), BackgroundColor3 = C.btn, AutoButtonColor = false,
		Text = "SAVED", Font = FB, TextSize = 10, TextColor3 = C.text, BorderSizePixel = 0, Parent = browser,
	})
	corner(tabSaved, 11)

	local function mkBox(pos, size, placeholder)
		local box = create("TextBox", {
			Position = pos, Size = size, BackgroundColor3 = C.field, BorderSizePixel = 0, Text = "", PlaceholderText = placeholder,
			PlaceholderColor3 = C.dim, TextColor3 = C.text, Font = FM, TextSize = 11, ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = browser,
		})
		corner(box, 5)
		stroke(box, C.stroke, 1)
		create("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8), Parent = box})
		return box
	end
	local searchBox = mkBox(UDim2.fromOffset(246, 7), UDim2.new(0.28, 0, 0, 22), "Cari lagu...")
	local loadBox = mkBox(UDim2.new(0.28, 254, 0, 7), UDim2.new(0.25, 0, 0, 22), "Muat via ID audio")
	local loadA = mkButton(browser, "A", UDim2.new(0.53, 262, 0, 7), UDim2.fromOffset(40, 22), {ts = 11, color = C.blue, accent = C.blue})
	local loadB = mkButton(browser, "B", UDim2.new(0.53, 306, 0, 7), UDim2.fromOffset(40, 22), {ts = 11, color = C.orange, accent = C.orange})
	local countLbl = label(browser, {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 7), Size = UDim2.fromOffset(70, 22),
		Text = "0 lagu", TextSize = 10, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Right,
	})

	local COLS = {
		{name = "ARTIST", xs = 0, xo = 16, ws = 0.24, wo = -16},
		{name = "TITLE", xs = 0.26, xo = 0, ws = 0.30, wo = 0},
		{name = "GENRE", xs = 0.57, xo = 0, ws = 0.21, wo = 0},
		{name = "BPM", xs = 0.80, xo = 0, ws = 0.15, wo = 0},
	}
	for _, c in ipairs(COLS) do
		label(browser, {Position = UDim2.new(c.xs, c.xo, 0, 36), Size = UDim2.new(c.ws, c.wo, 0, 12), Text = c.name, Font = FB, TextSize = 8, TextColor3 = C.dim})
	end

	local list = create("ScrollingFrame", {
		Name = "TrackList", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(6, 52), Size = UDim2.new(1, -12, 1, -58),
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.stroke, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = browser,
	})
	create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 1), Parent = list})
	local emptyLbl = label(browser, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.62, 0), Size = UDim2.new(0.9, 0, 0, 16),
		Text = "Belum ada lagu. Masukkan ID audio lewat kolom \"Muat via ID audio\" di atas, lalu klik A atau B.",
		TextSize = 11, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center,
	})

	local function idOf(track)
		return tostring(first(track, {"id", "soundId", "SoundId"}, "")):match("(%d+)") or ""
	end
	local function splitName(name)
		local a, t = name:match("^(.-)%s+%-%s+(.+)$")
		if a and a ~= "" then return a, t end
		return "-", name
	end

	local selected, selectedRow
	local rows = {}
	local filtered = {}
	local lastSig = ""
	local rebuildAt = 0

	local function rebuildList()
		for _, r in ipairs(rows) do r:Destroy() end
		table.clear(rows)
		selected, selectedRow = nil, nil
		local q = string.lower(searchBox.Text)
		filtered = {}
		for _, tr in ipairs(state.catalog or {}) do
			local okRow = true
			if tab == "SAVED" then okRow = type(state.favorites) == "table" and state.favorites[idOf(tr)] == true end
			if okRow and q ~= "" then
				local hay = string.lower(trackName(tr) .. " " .. tostring(first(tr, {"collection", "Collection"}, "")))
				okRow = string.find(hay, q, 1, true) ~= nil
			end
			if okRow then table.insert(filtered, tr) end
		end
		countLbl.Text = tostring(#filtered) .. " lagu"
		emptyLbl.Visible = #filtered == 0
		if #filtered == 0 then
			emptyLbl.Text = (tab == "SAVED") and "Belum ada lagu tersimpan. Beri tanda suka pada lagu di Library." or
				((searchBox.Text ~= "") and "Tidak ada lagu yang cocok dengan pencarian." or
				"Belum ada lagu. Masukkan ID audio lewat kolom \"Muat via ID audio\" di atas, lalu klik A atau B.")
		end
		for i = 1, math.min(#filtered, 250) do
			local tr = filtered[i]
			local artist, title = splitName(trackName(tr))
			local k = trackName(tr)
			local bpmText = baseBpm[k] and string.format("%.0f", baseBpm[k]) or "-"
			local rowBtn = create("TextButton", {
				LayoutOrder = i, Size = UDim2.new(1, -6, 0, 20), BackgroundColor3 = C.card, BackgroundTransparency = 1,
				AutoButtonColor = false, Text = "", BorderSizePixel = 0, Parent = list,
			})
			corner(rowBtn, 4)
			local vals = {artist, title, tostring(first(tr, {"collection", "Collection"}, "-")), bpmText}
			for ci, c in ipairs(COLS) do
				label(rowBtn, {
					Position = UDim2.new(c.xs, c.xo, 0, 0), Size = UDim2.new(c.ws, c.wo, 1, 0), Text = vals[ci],
					TextSize = 10, TextColor3 = (ci == 2) and C.text or C.dim, TextTruncate = Enum.TextTruncate.AtEnd,
				})
			end
			local lastClick = 0
			rowBtn.Activated:Connect(function()
				if selectedRow and selectedRow.Parent then selectedRow.BackgroundTransparency = 1 end
				selected, selectedRow = tr, rowBtn
				rowBtn.BackgroundColor3 = C.btnHi
				rowBtn.BackgroundTransparency = 0
				if os.clock() - lastClick < 0.35 then
					send("playnow", tr)
				end
				lastClick = os.clock()
			end)
			rows[#rows + 1] = rowBtn
		end
	end

	local function setTab(name)
		tab = name
		tabLib.BackgroundColor3 = (name == "LIBRARY") and C.text or C.btn
		tabLib.TextColor3 = (name == "LIBRARY") and C.black or C.text
		tabSaved.BackgroundColor3 = (name == "SAVED") and C.text or C.btn
		tabSaved.TextColor3 = (name == "SAVED") and C.black or C.text
		rebuildList()
	end
	tabLib.Activated:Connect(function() setTab("LIBRARY") end)
	tabSaved.Activated:Connect(function() setTab("SAVED") end)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function() rebuildAt = os.clock() + 0.2 end)

	local function flashBox(box)
		local st = box:FindFirstChildOfClass("UIStroke")
		if not st then return end
		st.Color = C.red
		task.delay(0.6, function() st.Color = C.stroke end)
	end
	local function doLoad(toA)
		local typed = loadBox.Text:match("%d+")
		local payload
		if typed and #typed >= 5 then
			payload = typed
		elseif selected then
			payload = selected
		end
		if not payload then flashBox(loadBox) return end
		send(toA and "playnow" or "queuenext", payload)
		if typed and #typed >= 5 then loadBox.Text = "" end
	end
	onPress(loadA, function() doLoad(true) end)
	onPress(loadB, function() doLoad(false) end)

	-- ═══════════ AKSI DECK A ═══════════
	local function curKey() return keyOf(trackA) end
	local function ensureHot(k) hot[k] = hot[k] or {} return hot[k] end

	onPress(deckA.play, function() send(isPlayingNow() and "pause" or "resume") end)
	onPress(deckA.cue, function()
		local k = curKey()
		if not k then return end
		if isPlayingNow() then
			seekTo(cuePt[k] or 0)
			send("pause")
		else
			cuePt[k] = (positionNow())
		end
	end)
	onPress(deckA.sync, function()
		local rel = 1
		if trackB then rel = math.clamp(baseBpmOf(trackB) / baseBpmOf(trackA), REL_MIN, REL_MAX) end
		deckA.setTempoVisual(rel)
		lastDrag = os.clock()
		setRel(rel)
	end)
	onPress(deckA.rst, function()
		deckA.setTempoVisual(1)
		lastDrag = os.clock()
		setRel(1)
	end)
	for i = 1, 4 do
		local b = deckA.hc[i]
		onPress(b, function()
			local k = curKey()
			if not k then return end
			local h = ensureHot(k)
			if h[i] then
				seekTo(h[i])
				if not isPlayingNow() then send("resume") end
			else
				h[i] = (positionNow())
			end
		end)
		b.Instance.MouseButton2Click:Connect(function()
			local k = curKey()
			if k and hot[k] then hot[k][i] = nil end
		end)
	end
	local beats = {1, 2, 4, 8, 16, 32}
	for i, n in ipairs(beats) do
		onPress(deckA.lb[i], function()
			if not trackA then return end
			if loop.active and loop.beats == n then loop.active = false return end
			local p = positionNow()
			loop.start, loop.stop, loop.beats, loop.active = p, p + n * 60 / baseBpmOf(trackA), n, true
		end)
	end
	onPress(deckA.loopIn, function()
		if not trackA then return end
		loop.start = (positionNow())
		loop.beats = 0
		if loop.stop <= loop.start then loop.active = false end
	end)
	onPress(deckA.loopOut, function()
		if not trackA then return end
		local p = positionNow()
		if p > loop.start + 0.1 then
			loop.stop, loop.beats, loop.active = p, 0, true
		end
	end)
	onPress(deckA.loopExit, function() loop.active = false end)

	-- bend (tahan = tempo sementara ±8%)
	local bending, bendBase = nil, 1
	local function bendBegin(dir)
		if bending or not trackA then return end
		bending, bendBase = dir, currentSpeed()
		send("setspeed", math.clamp(bendBase * (1 + 0.08 * dir), 0.1, 2), "speed")
	end
	local function bendEnd()
		if not bending then return end
		bending = nil
		send("setspeed", bendBase, "speed")
	end
	local function bindBend(b, dir)
		b.Instance.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then bendBegin(dir) end
		end)
		b.Instance.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then bendEnd() end
		end)
		b.Instance.MouseLeave:Connect(bendEnd)
	end
	bindBend(deckA.bendL, -1)
	bindBend(deckA.bendR, 1)

	-- tap tempo
	local function makeTap(deck, trackGetter)
		local taps = {}
		onPress(deck.tap, function()
			local tr = trackGetter()
			local k = keyOf(tr)
			if not k then return end
			local now = os.clock()
			if #taps > 0 and now - taps[#taps] > 2 then taps = {} end
			table.insert(taps, now)
			if #taps > 8 then table.remove(taps, 1) end
			if #taps >= 2 then
				local avg = (taps[#taps] - taps[1]) / (#taps - 1)
				local heard = math.clamp(60 / avg, 60, 200)
				local rel = (tr == trackA) and relNow() or 1
				baseBpm[k] = heard / math.max(rel, 0.05)
				rebuildAt = os.clock() + 0.3
			end
		end)
	end
	makeTap(deckA, function() return trackA end)
	makeTap(deckB, function() return trackB end)

	-- preset EQ (VOCAL / INSTR / KICK)
	local PRESETS = {
		VOCAL = {low = -8, mid = 6, high = 0},
		INSTR = {low = 0, mid = -14, high = 0},
		KICK = {low = 8, mid = -5, high = -6},
	}
	local function applyPreset(name)
		local p
		if activePreset == name then
			activePreset = nil
			p = {low = 0, mid = 0, high = 0}
		else
			activePreset = name
			p = PRESETS[name]
		end
		kLOW.set(p.low) kMID.set(p.mid) kHI.set(p.high)
		lastDrag = os.clock()
		send("seteffect", {effect = "equalizer", enabled = true, lowGain = p.low, midGain = p.mid, highGain = p.high}, "fx:eq:preset")
	end
	onPress(deckA.vocal, function() applyPreset("VOCAL") end)
	onPress(deckA.instr, function() applyPreset("INSTR") end)
	onPress(deckA.kick, function() applyPreset("KICK") end)
	onPress(deckA.reset, function()
		activePreset = nil
		loop.active = false
		local k = curKey()
		if k then hot[k], cuePt[k] = nil, nil end
		kLOW.set(0) kMID.set(0) kHI.set(0) kFIL.set(0)
		vol.ch, vol.xf, vol.muted = 1, 1, false
		fadA.set(1)
		muteBtn.set(false)
		xfAuto = nil
		xfBtn.set(false)
		xfPos = 0
		xfVisual()
		lastDrag = os.clock()
		send("reseteffects")
		pushVolume()
		deckA.setTempoVisual(1)
		setRel(1)
	end)
	onPress(deckA.eject, function() send(state.isDJ and "skip" or "voteskip") end)

	-- ═══════════ AKSI DECK B (antrian berikutnya) ═══════════
	onPress(deckB.play, function() if trackB then send("skip") end end)
	onPress(deckB.eject, function() if trackB then send("removequeue", {index = 1}) end end)
	onPress(deckB.rst, function()
		deckB.setTempoVisual(1)
		lastDrag = os.clock()
		setRel(1)
	end)
	for _, b in ipairs({deckB.cue, deckB.sync, deckB.loopIn, deckB.loopOut, deckB.loopExit, deckB.bendL, deckB.bendR,
		deckB.vocal, deckB.instr, deckB.kick, deckB.reset}) do
		b.disable()
	end
	for _, b in ipairs(deckB.hc) do b.disable() end
	for _, b in ipairs(deckB.lb) do b.disable() end

	-- ═══════════ UPDATE DATA ═══════════
	local function coverOf(track)
		local img = track and trackImage(track) or ""
		if img == nil or img == "" then return FALLBACK_COVER end
		return img
	end

	local function setDeck(d, track, isA)
		if track then
			d.title.Text = trackName(track)
			local by = ctx.requesterDisplay and ctx.requesterDisplay(track) or ""
			d.sub.Text = tostring(by)
		else
			d.title.Text = isA and "TRACK 1 - READY" or "TRACK 2 - READY"
			d.sub.Text = "Unknown"
		end
		local img = coverOf(track)
		d.cover.Image = img
		d.mini.Image = img
		d.cover.ImageTransparency = track and 0 or 0.4
		d.mini.ImageTransparency = track and 0 or 0.4
	end

	local function drawWave(d, track, position)
		local key = track and trackName(track) or ""
		if d.waveKey ~= key then
			d.waveKey = key
			d.waveSeed = seedOf(key ~= "" and key or "kosong")
			d.waveBase = nil
		end
		local base = math.floor(position * WAVE_RATE)
		if d.waveBase == base then return end
		d.waveBase = base
		for i = 1, NB do
			local h = track and ampAt(d.waveSeed, base + i - NB // 2) or 0.05
			if d.heights[i] ~= h then
				d.heights[i] = h
				d.bars[i].Size = UDim2.new(1 / NB, -1, h * 0.86, 0)
			end
		end
	end

	function self.Update(current, queue)
		current = type(current) == "table" and current or nil
		queue = type(queue) == "table" and queue or {}
		local changed = keyOf(current) ~= keyOf(trackA)
		trackA = current
		trackB = queue[1]
		queueList = queue
		if changed then
			loop.active = false
			localSeek = nil
			if current then nativeOf(current) end
		end
		setDeck(deckA, trackA, true)
		setDeck(deckB, trackB, false)
		deckA.status.Text = trackA and "LOADED" or "READY"
		deckB.status.Text = trackB and ("NEXT  #1   " .. tostring(#queue) .. " lagu") or "READY"
		deckB.play.setText(trackB and "MIX" or "PLAY")
	end

	-- ═══════════ ANIMASI ═══════════
	local rotA = 0
	local clockT, lastClock, lastSync = 0, 0, 0
	local presetClear = 0

	RunService.Heartbeat:Connect(function(dt)
		-- kirim antrian perintah
		sinceSend += dt
		if sinceSend >= 0.11 and #pending > 0 then
			sinceSend = 0
			local item = table.remove(pending, 1)
			fire(item.action, item.payload)
		end
		-- crossfade otomatis
		if xfAuto then
			local p = (os.clock() - xfAuto.t0) / xfAuto.dur
			if p >= 1 then
				xfAuto = nil
				xfBtn.set(false)
				xfApply(1)
				xfFinish()
			else
				xfApply(xfAuto.from + (1 - xfAuto.from) * p)
			end
		end
		-- loop
		if loop.active and state.isDJ and trackA and loop.stop - loop.start > 0.1 then
			local p, _, playing = positionNow()
			if playing and p >= loop.stop and os.clock() - (loop.lastJump or 0) > 0.25 then
				loop.lastJump = os.clock()
				seekTo(loop.start)
			end
		end
	end)

	local function syncFromServer(volume)
		local eff = effectsNow()
		local eq = type(eff.equalizer) == "table" and eff.equalizer or {}
		if tonumber(eq.highGain) then kHI.set(tonumber(eq.highGain)) end
		if tonumber(eq.midGain) then kMID.set(tonumber(eq.midGain)) end
		if tonumber(eq.lowGain) then kLOW.set(tonumber(eq.lowGain)) end
		local sv = tonumber(volume) or 0.5
		if not vol.muted and math.abs(sv - effVol()) > 0.02 then
			vol.master = math.clamp(sv / math.max(vol.ch * vol.xf, 0.05), 0, 1)
			fadM.set(vol.master)
		end
		deckA.setTempoVisual(relNow())
		deckB.setTempoVisual(relNow())
	end

	RunService.RenderStepped:Connect(function(dt)
		if not state.panelOpen then return end
		if not (ctx.djView and ctx.djView.Visible) then return end

		-- MODE DJ OFF: UI digelapkan & dibekukan (tidak ada animasi / update)
		local djOnNow = pget({"djModeEnabled", "DJModeEnabled"}, false) == true
		djBtn.set(djOnNow)
		djBtn.setText(djOnNow and "MODE DJ  ON" or "MODE DJ  OFF")
		setDjOffShade(djOnNow)
		if not djOnNow then
			vuA(0, dt); vuM(0, dt); vuB(0, dt)
			return
		end

		clockT += dt
		local position, duration, playing, speed = positionNow()
		local volume = tonumber(pget({"volume", "Volume"}, 1)) or 1
		local rel = relNow()
		local live = trackA ~= nil and playing

		-- jam
		if os.clock() - lastClock > 0.5 then
			lastClock = os.clock()
			clock.Text = os.date("%H:%M:%S")
			-- daftar lagu ikut berubah bila katalog / favorit berubah
			local favCount = 0
			if type(state.favorites) == "table" then for _ in pairs(state.favorites) do favCount += 1 end end
			local sig = tostring(#(state.catalog or {})) .. ":" .. favCount
			if sig ~= lastSig then
				lastSig = sig
				rebuildAt = os.clock()
			end
		end
		if rebuildAt > 0 and os.clock() >= rebuildAt then
			rebuildAt = 0
			rebuildList()
		end

		-- MODE DJ
		local djOn = pget({"djModeEnabled", "DJModeEnabled"}, false) == true
		djBtn.set(djOn)
		djBtn.setText(djOn and "MODE DJ  ON" or "MODE DJ  OFF")

		-- deck A
		local keyA = keyOf(trackA)
		local bpmA = baseBpmOf(trackA) * rel
		deckA.bpm.Text = string.format("%.1f", bpmA)
		local pc = (rel - 1) * 100
		deckA.pct.Text = string.format("%s%.1f%%", pc >= 0 and "+" or "", pc)
		deckA.tempoLbl.Text = string.format("%.2fx", rel)
		deckB.tempoLbl.Text = string.format("%.2fx", rel)
		deckB.bpm.Text = string.format("%.1f", baseBpmOf(trackB))
		deckA.tElapsed.Text = trackA and fmtTimeT(position) or "0:00.0"
		deckA.tTotal.Text = trackA and fmtTime(duration) or "0:00"
		deckA.tRemain.Text = trackA and ("-" .. fmtTimeT(math.max(0, duration - position))) or "-0:00.0"
		deckB.tElapsed.Text = "0:00.0"
		deckB.tTotal.Text = "0:00"
		deckB.tRemain.Text = "-0:00.0"
		drawWave(deckA, trackA, position)
		drawWave(deckB, trackB, 0)

		if live then
			rotA = (rotA + dt * 200 * rel) % 360
			deckA.spin.Rotation = rotA
		end
		deckA.status.Text = trackA and (playing and "PLAYING" or "PAUSED") or "READY"
		deckA.status.TextColor3 = live and C.green or C.dim
		deckA.play.setText(playing and "PAUSE" or "PLAY")
		deckA.play.set(live)
		deckA.cue.set(trackA ~= nil and not playing and keyA ~= nil and cuePt[keyA] ~= nil)
		deckA.sync.set(trackA ~= nil and math.abs(rel - 1) < 0.005)

		local h = keyA and hot[keyA] or {}
		for i = 1, 4 do deckA.hc[i].set(h[i] ~= nil) end
		for i, n in ipairs(beats) do deckA.lb[i].set(loop.active and loop.beats == n) end
		deckA.loopIn.set(loop.active)
		deckA.loopOut.set(loop.active and loop.beats == 0)
		deckA.vocal.set(activePreset == "VOCAL")
		deckA.instr.set(activePreset == "INSTR")
		deckA.kick.set(activePreset == "KICK")
		deckB.tap.set(false)
		deckB.status.TextColor3 = trackB and C.orange or C.dim

		-- sinkron dari server bila tidak sedang digeser
		if os.clock() - lastDrag > 0.8 and #pending == 0 then
			syncFromServer(volume)
		end

		-- status tombol efek
		local eff = effectsNow()
		for name, b in pairs(fxBtns) do
			local e = eff[name]
			b.set(type(e) == "table" and e.enabled == true)
		end

		-- VU
		local sound = ctx.getSound and ctx.getSound() or nil
		local raw = 0
		if live then
			local loud = (sound and sound.IsPlaying) and sound.PlaybackLoudness or 0
			raw = math.clamp(loud / 450, 0, 1)
			if raw < 0.02 then raw = 0.3 + 0.2 * (math.noise(clockT * 1.3, 3.7) + 0.5) end
		end
		local lvl = raw * math.clamp(volume, 0.1, 1)
		vuA(lvl * (0.88 + 0.12 * (math.noise(clockT * 7, 1.1) + 0.5)), dt)
		vuM(lvl * (0.92 + 0.08 * (math.noise(clockT * 7, 9.3) + 0.5)), dt)
		vuB(0, dt)
	end)

	self.Row = row
	self.Update(nil, {})
	setTab("LIBRARY")
	return self
end

return Module
]]></ProtectedString>
