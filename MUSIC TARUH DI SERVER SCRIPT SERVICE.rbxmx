			lower = lower,
			isFavorite = isFavorite,
			toggleFavorite = toggleFavorite,
			bindResponsiveActivate = bindResponsiveActivate,
			getCurrentTrackId = function()
				local id = currentTrack and trackId(currentTrack)
				if id and id ~= "" then return id end
				return nil
			end,
		})
	end)
	if okSys and sysLibrary then
		local baseUpdateCards = updateCollectionCards
		updateCollectionCards = function(...)
			baseUpdateCards(...)
			sysLibrary.Refresh()
		end
	else
		warn("[CaaMusic] Library gaya System gagal dimuat, memakai tampilan lama:", sysLibrary)
		local oldPanel = libraryView:FindFirstChild("LibraryPanel")
		if oldPanel then oldPanel.Visible = true end
	end
end
