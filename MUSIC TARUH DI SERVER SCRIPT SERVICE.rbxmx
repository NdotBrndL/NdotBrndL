	state = state,
	first = first,
	player = player,
	trackName = trackName,
	trackCollection = trackCollection,
	trackImage = trackImage,
	asset = asset,
	lower = lower,
	applyFavoriteVisual = applyFavoriteVisual,
	isFavorite = isFavorite,
	toggleFavorite = toggleFavorite,
	notify = notify,
})

-- Dual Deck di bagian atas halaman DJ CONTROLS (Deck A = sedang diputar, Deck B = berikutnya)
do
	local okDeck, deckSystem = pcall(function()
		-- Hapus/sembunyikan semua tampilan DJ lama (hub, controls, efek, manage); hanya Dual Deck yang tampil
		for _, pg in ipairs(djView:GetChildren()) do
			if pg:IsA("GuiObject") and pg.Name:sub(1, 5) == "Page_" then
				pg.Visible = false
				pg.Active = false
				pg:GetPropertyChangedSignal("Visible"):Connect(function()
					if pg.Visible then pg.Visible = false end
				end)
			end
		end
		return require(script:WaitForChild("CaaDualDeck")).new({
			close = function() closePanel() end,
			state = state,
			first = first,
			djView = djView,
			page = djView,
			scroll = djView,
			bindSlider = bindSlider,
			trackName = trackName,
			trackImage = trackImage,
			requesterDisplay = requesterDisplay,
			bindResponsiveActivate = bindResponsiveActivate,
			fire = fire,
			getSound = function() return musicSound end,
		})
	end)
	if okDeck and deckSystem then
		state.CaaDualDeck = deckSystem
		pcall(deckSystem.Update, currentTrack, first(state.packet, {"queue", "Queue"}, {}))
	else
		warn("[CaaMusic] Dual Deck gagal dimuat:", deckSystem)
	end
end

-- Overlay gelap di Home & Library saat MODE DJ menyala
local djModeOverlays = {}
local function updateDjModeOverlay(enabled)
	for _, view in ipairs({homeView, libraryView}) do
		local ov = djModeOverlays[view]
		if not ov then
			ov = Instance.new("Frame")
			ov.Name = "DJModeOverlay"
			ov.Size = UDim2.fromScale(1, 1)
			ov.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
			ov.BackgroundTransparency = 0.06
			ov.BorderSizePixel = 0
			ov.Active = true
			ov.ZIndex = 200
			ov.Visible = false
			ov.Parent = view
			local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 14); c.Parent = ov
			local t = Instance.new("TextLabel")
			t.Name = "Title"
			t.AnchorPoint = Vector2.new(0.5, 0.5)
			t.Position = UDim2.fromScale(0.5, 0.46)
			t.Size = UDim2.new(1, -40, 0, 34)
			t.BackgroundTransparency = 1
			t.Font = Enum.Font.DenkOne
			t.TextSize = 26
			t.TextColor3 = Color3.fromRGB(213, 213, 213)
			t.Text = "MODE DJ SEDANG DINYALAKAN"
			t.ZIndex = 201
			t.Parent = ov
			local sub = Instance.new("TextLabel")
			sub.Name = "Sub"
			sub.AnchorPoint = Vector2.new(0.5, 0.5)
			sub.Position = UDim2.fromScale(0.5, 0.46)
			sub.Size = UDim2.new(1, -40, 0, 18)
			sub.BackgroundTransparency = 1
			sub.Font = Enum.Font.DenkOne
			sub.TextSize = 14
			sub.TextColor3 = Color3.fromRGB(154, 154, 154)
			sub.Text = "Kontrol musik hanya lewat tab DJ"
			sub.ZIndex = 201
			sub.Parent = ov
			sub.Position = UDim2.new(0.5, 0, 0.46, 34)
			djModeOverlays[view] = ov
		end
		ov.Visible = enabled == true
	end
end
state.updateDjModeOverlay = updateDjModeOverlay

local function applyPacket(packet)
	if type(packet) ~= "table" then return end
	state.packet = packet
	local collections = first(packet, {"collections", "Collections"}, nil)
	if type(collections) == "table" then state.collections = collections end
	if updateLibrarySummary then updateLibrarySummary() end
	local favorites = first(packet, {"favorites", "Favorites"}, nil)
	if type(favorites) == "table" then
		local normalized = {}
		for key, value in pairs(favorites) do
			local rawKey = tostring(key)
			if value == true then
				local id = rawKey:match("^(%d+)$")
				if id then
					normalized[id] = true
				elseif rawKey:sub(1, #COLLECTION_FAVORITE_PREFIX) == COLLECTION_FAVORITE_PREFIX then
					normalized[rawKey] = true
				end
			end
		end
		local now = os.clock()
		for id, pending in pairs(state.favoritePending) do
			if normalized[id] == pending.value then
				state.favoritePending[id] = nil
				state.favoriteBusy[id] = nil
			elseif now < pending.expiresAt then
				normalized[id] = pending.value or nil
			else
				state.favoritePending[id] = nil
				state.favoriteBusy[id] = nil
			end
		end
		state.favorites = normalized
	end
	state.isDJ = first(packet, {"isDJ", "IsDJ", "dj", "DJ"}, false) == true
	djController:SetAccess(state.isDJ)
	if not state.isDJ and currentTab == "DJ" then currentTab = "Home" end
	showTab(currentTab)
	pcall(updateDjModeOverlay, first(packet, {"djModeEnabled", "DJModeEnabled"}, false) == true)

	currentTrack = first(packet, {"current", "Current", "currentTrack", "CurrentTrack", "nowPlaying", "NowPlaying"}, nil)
	if currentTrack then
		local newTrackId = trackId(currentTrack)
		if newTrackId ~= "" and newTrackId ~= state.lastNotifiedTrackId then
			state.lastNotifiedTrackId = newTrackId
			notify("success", "NOW PLAYING", trackName(currentTrack), currentTrack, 4.2)
		end
		songTitle.Text = trackName(currentTrack)
		local img = trackImage(currentTrack)
		albumImage.Image = img
		albumImage.Visible = img ~= ""
		if albumIcon then albumIcon.Visible = img == "" end
		playlistValue.Text = trackCollection(currentTrack)
		queuedValue.Text = requesterDisplay(currentTrack)
		applyFavoriteVisual(nowLike, isFavorite(currentTrack))
	else
		songTitle.Text = "No track playing"
		albumImage.Image = ""
		albumImage.Visible = false
		if albumIcon then albumIcon.Visible = true end
		playlistValue.Text = "AUTOPLAY"
		queuedValue.Text = "-"
		applyFavoriteVisual(nowLike, false)
	end
	local queue = first(packet, {"queue", "Queue"}, {})
	renderQueue(queue)
	updateCollectionCards()
	if trackContainer.Visible then renderTracks() end
	djController:Apply(packet)
	setLocalVolume(state.localVolume)
	local packetVote = first(packet, {"vote", "Vote"}, nil)
	if type(packetVote) == "table" then renderVoteUI(packetVote) end

	local packetNotice = first(packet, {"notice", "Notice", "notification", "Notification"}, nil)
	if type(packetNotice) == "table" then
		local kind = lower(first(packetNotice, {"kind", "Kind", "type", "Type"}, "success")) == "error" and "error" or "success"
		local message = tostring(first(packetNotice, {"message", "Message", "text", "Text"}, ""))
		local lowered = lower(message)
		local title = kind == "error" and "REQUEST FAILED" or "SUCCESS"
		if lowered:find("dj mode enabled", 1, true) then
			title = "DJ MODE ON"
		elseif lowered:find("dj mode disabled", 1, true) then
			title = "DJ MODE OFF"
		elseif lowered:find("session library", 1, true) then
			title = kind == "error" and "LIBRARY FAILED" or "ADDED TO LIBRARY"
		elseif lowered:find("already exists", 1, true) then
			title = "ALREADY EXISTS"
		elseif lowered:find("session dj", 1, true) then
			title = "DJ ADDED"
		elseif lowered:find("username", 1, true) then
			title = "DJ UPDATE FAILED"
		elseif lowered:find("queue", 1, true) then
			title = kind == "error" and "QUEUE FAILED" or "ADDED TO QUEUE"
		elseif lowered:find("cooldown", 1, true) then
			title = "VOTE COOLDOWN"
		elseif lowered:find("dj", 1, true) or lowered:find("akses", 1, true) then
			title = "ACCESS DENIED"
		elseif lowered:find("valid", 1, true) then
			title = "INVALID TRACK"
		end
		local noticeTrack = kind == "success" and state.pendingNoticeTrack or nil
		local displayMessage = noticeTrack and trackName(noticeTrack) or message
		notify(kind, title, displayMessage, noticeTrack, kind == "error" and 3.8 or 3.2)
		state.pendingNoticeTrack = nil
	end

end


local voteUI = nil
local voteAvatarToken = 0
renderVoteUI = function(vote)
	state.votePacket = type(vote) == "table" and vote or nil
	if not voteUI then return end

	local active = type(vote) == "table" and first(vote, {"active", "Active"}, false) == true
	local voteId = active and tostring(first(vote, {"id", "Id", "voteId", "VoteId"}, "")) or ""
	if not active or (voteId ~= "" and state.dismissedVoteId == voteId) then
		voteUI.container.Visible = false
		return
	end

	local count = tonumber(first(vote, {"count", "Count"}, 0)) or 0
	local required = math.max(1, tonumber(first(vote, {"required", "Required"}, 1)) or 1)
	local startedBy = tostring(first(vote, {"startedBy", "StartedBy"}, "Player"))
	local startedByUserId = tonumber(first(vote, {"startedByUserId", "StartedByUserId"}, 0)) or 0
	local hasVoted = first(vote, {"hasVoted", "HasVoted"}, false) == true

	voteUI.currentId = voteId
	voteUI.endsAt = tonumber(first(vote, {"endsAtServer", "EndsAtServer"}, workspace:GetServerTimeNow())) or workspace:GetServerTimeNow()
	voteUI.container.Visible = true
	voteUI.initiator.Text = startedBy
	voteUI.description.Text = "started a vote to skip"
	voteUI.count.Text = string.format("%d/%d votes", count, required)
	voteUI.fill.Size = UDim2.fromScale(math.clamp(count / required, 0, 1), 1)
	voteUI.yes.Active = not hasVoted
	voteUI.yes.AutoButtonColor = not hasVoted
	if voteUI.yesLabel then voteUI.yesLabel.Text = hasVoted and "Voted" or "Yes" end

	voteAvatarToken += 1
	local token = voteAvatarToken
	if startedByUserId > 0 then
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(startedByUserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			end)
			if ok and voteUI and token == voteAvatarToken and voteUI.currentId == voteId then
				voteUI.avatar.Image = image
			end
		end)
	else
		voteUI.avatar.Image = ""
	end
end

task.spawn(function()
	local voteGui = playerGui and (playerGui:FindFirstChild("CaaVoteGui") or playerGui:WaitForChild("CaaVoteGui", 20))
	if not voteGui or not voteGui:IsA("ScreenGui") then

		return
	end
	local container = voteGui:FindFirstChild("VoteSkipContainer")
	if not container then

		return
	end
	local buttons = container:FindFirstChild("ButtonsSection")
	local progress = container:FindFirstChild("ProgressSection")
	local timerSection = container:FindFirstChild("TimerSection")
	local avatarContainer = container:FindFirstChild("AvatarContainer")
	if not (buttons and progress and timerSection and avatarContainer) then

		return
	end

	voteGui.Enabled = true
	voteGui.ResetOnSpawn = false
	container.Visible = false
	local scale = container:FindFirstChildOfClass("UIScale")
	voteUI = {
		gui = voteGui,
		container = container,
		scale = scale,
		initiator = child(container, "InitiatorName"),
		description = child(container, "Description"),
		yes = child(buttons, "YesButton"),
		no = child(buttons, "NoButton"),
		count = child(progress, "CountText"),
		fill = child(child(progress, "ProgressBg"), "ProgressFill"),
		timer = child(timerSection, "Timer"),
		avatar = child(avatarContainer, "Avatar"),
	}
	voteUI.yesLabel = voteUI.yes:FindFirstChild("Label")

	bindResponsiveActivate(voteUI.yes, function()
		local vote = state.votePacket
		if type(vote) ~= "table" or first(vote, {"active", "Active"}, false) ~= true then return end
		if first(vote, {"hasVoted", "HasVoted"}, false) == true then return end
		fire("voteskip")
	end)
	bindResponsiveActivate(voteUI.no, function()
		state.dismissedVoteId = voteUI.currentId
		voteUI.container.Visible = false
	end)

	local function updateVoteScale()
		if not voteUI or not voteUI.scale then return end
		local camera = workspace.CurrentCamera
		if not camera then return end
		local viewport = camera.ViewportSize
		local compactScale = math.min(viewport.X / 500, viewport.Y / 620)
		voteUI.scale.Scale = math.clamp(compactScale, 0.68, 0.88)
	end
	updateVoteScale()
	if workspace.CurrentCamera then
		connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), updateVoteScale)
	end
	renderVoteUI(state.votePacket)
end)

connect(stateRemote.OnClientEvent, applyPacket)

-- BUG FIX 2: Client-side audio recovery watchdog.
-- The server-side Sound object can silently stop on the client (e.g. after
-- streaming, replication hiccups, or SoundService resets) while the server
-- still believes it is playing.  This watchdog periodically checks whether
-- the server packet says music is playing but the local Sound is not, and
-- attempts to re-sync the SoundId and resume playback at the correct
-- position.
local audioRecoveryToken = 0
local audioRecoveryPendingSince = nil
task.spawn(function()
	while true do
		task.wait(3)
		if not musicSound or not musicSound.Parent then continue end
		local packet = state.packet
		local packetPlaying = first(packet, {"playing", "Playing", "isPlaying", "IsPlaying"}, false) == true
		local current = first(packet, {"current", "Current", "currentTrack", "CurrentTrack"}, nil)
		if not packetPlaying or not current then
			audioRecoveryPendingSince = nil
			continue
		end

		-- If the local sound is still loading, give it time before intervening.
		if not musicSound.IsLoaded then
			audioRecoveryPendingSince = nil
			continue
		end

		if musicSound.Playing then
			audioRecoveryPendingSince = nil
			continue
		end

		-- Wajib mismatch bertahan 2 tick (~6 detik) sebelum bertindak, karena
		-- Pause() direplikasi lebih cepat daripada full state packet — sekali
		-- packetPlaying stale bisa nge-unpause lagu yang baru dipause DJ.
		if not audioRecoveryPendingSince then
			audioRecoveryPendingSince = os.clock()
			continue
		end
		if os.clock() - audioRecoveryPendingSince < 3 then
			continue
		end
		audioRecoveryPendingSince = nil

		do
			audioRecoveryToken += 1
			local token = audioRecoveryToken

			-- Resolve the correct sound ID for the current part.
			local soundIds = first(current, {"soundIds", "SoundIds"}, {})
			local currentPart = tonumber(first(current, {"currentPart", "CurrentPart"}, 1)) or 1
			local id = trackId(current)
			if type(soundIds) == "table" and #soundIds > 0 then
				local partId = tostring(soundIds[currentPart] or soundIds[1] or "")
				local matched = partId:match("(%d+)")
				if matched then id = matched end
			end

			if id ~= "" then
				local speed = tonumber(first(packet, {"playbackSpeed", "PlaybackSpeed"}, 1)) or 1
				musicSound.SoundId = "rbxassetid://" .. id
				musicSound.PlaybackSpeed = speed

				-- Estimate the correct playback position from the server packet.
				local serverTime = tonumber(first(packet, {"serverTime", "ServerTime"}, workspace:GetServerTimeNow())) or workspace:GetServerTimeNow()
				local position = tonumber(first(packet, {"timePosition", "TimePosition"}, 0)) or 0
				position += math.max(0, workspace:GetServerTimeNow() - serverTime) * speed

				musicSound:Play()
				task.wait(0.15)
				if token == audioRecoveryToken and musicSound.Parent and musicSound.IsLoaded then
					musicSound.TimePosition = math.max(0, position)
				end
			end
		end
	end
end)

-- BUG FIX 3: Chunked catalog assembly with timeout and retry.
-- The server sends the catalog in chunks of 150 tracks.  If any chunk is
-- lost in transit the client never reaches the totalChunks threshold and
-- the library appears incomplete (the "missing IDs" bug).  This improved
-- handler tracks the expected chunk count, resets on a new transfer, and
-- runs a watchdog that re-requests the catalog if chunks are not all
-- received within a reasonable timeout.
local catalogChunks = {}
local catalogChunkTotal = 0
local catalogChunkStartTime = 0
local catalogRetryCount = 0

connect(preloadRemote.OnClientEvent, function(data)
	if type(data) ~= "table" then return end
	if data.chunkIndex and data.totalChunks then
		-- Detect a new chunked transfer (different total or first chunk after completion).
		if catalogChunkTotal ~= data.totalChunks then
			catalogChunkTotal = data.totalChunks
			catalogChunkStartTime = os.clock()
			catalogChunks = {}
			catalogRetryCount = 0
		end

		catalogChunks[data.chunkIndex] = data.tracks or {}
		if data.collections then state.collections = data.collections end

		local received = 0
		for _ in pairs(catalogChunks) do received += 1 end

		if received >= data.totalChunks then
			state.catalog = {}
			for i = 1, data.totalChunks do
				for _, track in ipairs(catalogChunks[i] or {}) do
					table.insert(state.catalog, track)
				end
			end
			catalogChunks = {}
			catalogChunkTotal = 0
			catalogChunkStartTime = 0
			if updateLibrarySummary then updateLibrarySummary() end
			updateCollectionCards()
			if trackContainer.Visible then renderTracks() end
		end
	elseif data[1] then
		state.catalog = data
		catalogChunkTotal = 0
		catalogChunkStartTime = 0
		if updateLibrarySummary then updateLibrarySummary() end
		updateCollectionCards()
		if trackContainer.Visible then renderTracks() end
	end
end)

-- Watchdog: if chunks are incomplete after 10 seconds, re-request the catalog.
task.spawn(function()
	while true do
		task.wait(2)
		if catalogChunkTotal > 0 and catalogChunkStartTime > 0 then
			local received = 0
			for _ in pairs(catalogChunks) do received += 1 end
			if received < catalogChunkTotal and os.clock() - catalogChunkStartTime > 10 then
				catalogRetryCount += 1
				if catalogRetryCount <= 3 then
					-- Reset and re-request the full catalog from the server.
					catalogChunkStartTime = os.clock()
					catalogChunks = {}
					requestStateRemote:FireServer()
				else
					-- Give up after 3 retries to avoid infinite loops.
					catalogChunkTotal = 0
					catalogChunks = {}
					catalogRetryCount = 0
					notify("error", "LIBRARY LOAD FAILED", "Coba buka ulang menu musik", nil, 4)
				end
			end
		end
	end
end)
connect(voteRemote.OnClientEvent, function(vote)
	renderVoteUI(vote)
end)



local bars = {}
for _, bar in ipairs(visualizer:GetChildren()) do
	if bar:IsA("Frame") and bar.Name:match("^EqBar") then table.insert(bars, bar) end
end
table.sort(bars, function(a, b) return (tonumber(a.Name:match("%d+")) or 0) < (tonumber(b.Name:match("%d+")) or 0) end)

local visualizerState = {
	clock = 0,
	elapsed = 0,
	heights = {},
}
for index in ipairs(bars) do
	visualizerState.heights[index] = 0.05
end

connect(RunService.RenderStepped, function(dt)
	visualizerState.elapsed += dt
	if visualizerState.elapsed < 1 / 30 then return end
	local stepDt = visualizerState.elapsed
	visualizerState.elapsed = 0

	local packet = state.packet
	local packetPlaying = first(packet, {"playing", "Playing", "isPlaying", "IsPlaying"}, false) == true
	local panelAnimating = state.panelOpen and #bars > 0
	local active = packetPlaying and panelAnimating

	if active then
		visualizerState.clock += stepDt
		for index, bar in ipairs(bars) do
			local current = visualizerState.heights[index] or 0.045
			local normalized = #bars > 1 and (index - 1) / (#bars - 1) or 0
			local phaseOffset = (index * 2.399963) % 6.283185
			local slowWave = (math.sin(visualizerState.clock * 1.18 + phaseOffset) + 1) * 0.5
			local driftWave = (math.sin(visualizerState.clock * 0.57 - normalized * 8.4) + 1) * 0.5
			local rippleWave = (math.sin(visualizerState.clock * 1.72 + normalized * 5.8) + 1) * 0.5
			local centerLift = 1 - math.abs(normalized * 2 - 1)
			local target = math.clamp(0.11 + slowWave * 0.36 + driftWave * 0.20 + rippleWave * 0.14 + centerLift * 0.12, 0.09, 0.96)
			current += (target - current) * (1 - math.exp(-stepDt * 8.5))
			visualizerState.heights[index] = current
			bar.Size = UDim2.new(bar.Size.X.Scale, bar.Size.X.Offset, current, 0)
		end
	else
		for index, bar in ipairs(bars) do
			local current = visualizerState.heights[index] or 0.045
			if current > 0.05 then
				current += (0.045 - current) * (1 - math.exp(-stepDt * 7))
				visualizerState.heights[index] = current
				bar.Size = UDim2.new(bar.Size.X.Scale, bar.Size.X.Offset, current, 0)
			end
		end
	end

	local duration = tonumber(first(packet, {"duration", "Duration", "timeLength", "TimeLength"}, 0)) or 0
	local position = tonumber(first(packet, {"timePosition", "TimePosition", "position", "Position"}, 0)) or 0
	local serverTime = tonumber(first(packet, {"serverTime", "ServerTime"}, workspace:GetServerTimeNow())) or workspace:GetServerTimeNow()
	local speed = tonumber(first(packet, {"playbackSpeed", "PlaybackSpeed"}, 1)) or 1
	if packetPlaying then position += math.max(0, workspace:GetServerTimeNow() - serverTime) * speed end
	if duration > 0 then position = math.clamp(position, 0, duration) end
	local ratio = duration > 0 and math.clamp(position / duration, 0, 1) or 0
	progressFill.Size = UDim2.fromScale(ratio, 1)
	timeLeft.Text = formatTime(position)
	timeRight.Text = formatTime(duration)

	if voteUI and voteUI.container.Visible then
		local remaining = math.max(0, voteUI.endsAt - workspace:GetServerTimeNow())
		voteUI.timer.Text = tostring(math.ceil(remaining)) .. "s"
		if remaining <= 0 then voteUI.container.Visible = false end
	end
end)

for _, descendant in ipairs(gui:GetDescendants()) do
	if descendant:IsA("GuiButton") then
		bindInteractive(descendant)
	elseif descendant:IsA("GuiObject") and descendant:FindFirstChild("Hover") then
		bindHoverSurface(descendant)
	end
end
connect(gui.DescendantAdded, function(descendant)
	task.defer(function()
		if not descendant.Parent then return end
		if descendant:IsA("GuiButton") then
			bindInteractive(descendant)
		elseif descendant:IsA("GuiObject") and descendant:FindFirstChild("Hover") then
			bindHoverSurface(descendant)
		end
	end)
end)

