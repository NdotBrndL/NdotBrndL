local function requireModule(name)
    local child = script:FindFirstChild(name)
    if not child or not child:IsA("ModuleScript") then
		error("[SS DJ] Missing module: " .. tostring(name), 0)
    end
    local ok, result = pcall(require, child)
    if not ok or type(result) ~= "table" or type(result.new) ~= "function" then
		error("[SS DJ] Invalid module API: " .. tostring(name), 0)
    end
    return result
end

local InputModule = requireModule("IFEACFSEFIEFB")
local ControlsModule = requireModule("QOIWUEFJQWPA")
local EffectsModule = requireModule("VBNMZCXQWEIR")
local ManagementModule = requireModule("LKJHGFDSAQPO")

local Module = {}

function Module.new(ctx)
    assert(type(ctx) == "table", "DJ controller context is required")

    local input = InputModule.new(ctx)
    local controls = ControlsModule.new(ctx, input)
    local effects = EffectsModule.new(ctx, input, controls)
    local management = ManagementModule.new(ctx, input, controls)

    local controller = {}

    function controller:SetAccess(allowed)
        controls:SetAccess(allowed)
    end

    function controller:Apply(packet)
        controls:Apply(packet)
        effects:Apply(packet)
        management:Apply(packet)
    end

    controller:SetAccess(ctx.state and ctx.state.isDJ == true)
    return controller
end

return Module
]]></ProtectedString>
							<string name="ScriptGuid">{B8D8EC9E-C9EE-4246-9D6B-7A65DD23809E}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">CaaMusicDJController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">16049574146</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
						<Item class="ModuleScript" referent="RBX41FA357C1FF542AFA22DD27F68305F76">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[local Module = {}

function Module.new(ctx)
    assert(type(ctx) == "table", "DJ input context is required")

    local connect = ctx.connect
    local bindResponsiveActivate = ctx.bindResponsiveActivate
    local configureScrollingFrame = ctx.configureScrollingFrame
    local cancelTransientInput = ctx.cancelTransientInput or function() end

    local api = {}

    function api:PrepareButton(button)
        if not button or not button:IsA("GuiButton") then return nil end
        button.Active = true
        button.Selectable = false
        pcall(function()
            button.Interactable = true
        end)



        for _, object in ipairs(button:GetDescendants()) do
            if object:IsA("GuiObject") and not object:IsA("GuiButton") then
                object.Active = false
                object.Selectable = false
            end
        end
        return button
    end

    function api:Bind(button, callback)
        if not self:PrepareButton(button) or type(callback) ~= "function" then return nil end
        if type(bindResponsiveActivate) == "function" then
            bindResponsiveActivate(button, function()
                cancelTransientInput()
                callback()
            end)
            return button
        end
        return connect(button.Activated, function()
            cancelTransientInput()
            callback()
        end)
    end

    function api:PrepareScroll(scroll)
        if not scroll or not scroll:IsA("ScrollingFrame") then return nil end
        if type(configureScrollingFrame) == "function" then
            configureScrollingFrame(scroll)
        else
            scroll.ScrollBarThickness = 0
            scroll.Active = true
            scroll.ScrollingEnabled = true
        end
        scroll.ScrollBarThickness = 0
        scroll.Active = true
        scroll.ScrollingEnabled = true
        scroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
        return scroll
    end

    function api:PreparePage(page)
        if not page or not page:IsA("GuiObject") then return end
        for _, object in ipairs(page:GetDescendants()) do
            if object:IsA("ScrollingFrame") then
                self:PrepareScroll(object)
            end
        end
    end

    function api:ShowOnly(pages, target)
        for _, page in ipairs(pages) do
            local active = page == target
            page.Visible = active
            page.Active = active
        end
        if target then
            self:PreparePage(target)
            task.defer(function()
                if target.Parent and target.Visible then
                    self:PreparePage(target)
                end
            end)
        end
    end

    return api
end

return Module
]]></ProtectedString>
								<string name="ScriptGuid">{3813D728-31BF-40F7-9932-A55DD87C255E}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">IFEACFSEFIEFB</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">0</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX53271567B8254E06A9C28E3E3DED50D6">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local Module = {}

function Module.new(ctx, input)
    assert(type(ctx) == "table", "DJ controls context is required")
    assert(type(input) == "table", "DJ input module is required")

    local child = ctx.child
    local djView = ctx.djView
    local fire = ctx.fire
    local bindSlider = ctx.bindSlider
    local first = ctx.first

    local pageHub = child(djView, "Page_hub")
    local pageControls = child(djView, "Page_controls")
    local pageEffects = child(djView, "Page_effects")
    local pageManageSong = child(djView, "Page_manageSong")
    local pageManageDJs = child(djView, "Page_manageDJs")
    local pages = {pageHub, pageControls, pageEffects, pageManageSong, pageManageDJs}

    local api = {
        pages = {
            hub = pageHub,
            controls = pageControls,
            effects = pageEffects,
            manageSong = pageManageSong,
            manageDJs = pageManageDJs,
        },
    }

    local function showPage(page)
        input:ShowOnly(pages, page)
    end
    api.ShowPage = showPage

    showPage(pageHub)
    input:Bind(child(pageHub, "DJCONTROLSCard"), function() showPage(pageControls) end)
    input:Bind(child(pageHub, "SOUNDEFFECTSCard"), function() showPage(pageEffects) end)
    input:Bind(child(pageControls, "Back"), function() showPage(pageHub) end)
    input:Bind(child(pageEffects, "Back"), function() showPage(pageHub) end)
    input:Bind(child(pageManageSong, "Back"), function() showPage(pageControls) end)
    input:Bind(child(pageManageDJs, "Back"), function() showPage(pageControls) end)

    local controlScroll = input:PrepareScroll(child(child(pageControls, "Content"), "Scroll"))
    local addSongButton = controlScroll and controlScroll:FindFirstChild("AddSongButton", true)
    local manageDJButton = controlScroll and controlScroll:FindFirstChild("ManageDJButton", true)
    local manageRow = addSongButton and addSongButton.Parent

    if manageRow and manageRow:IsA("GuiObject") then manageRow.Visible = true end
    if addSongButton then
        addSongButton.Visible = true
        input:Bind(addSongButton, function() showPage(pageManageSong) end)
    end
    if manageDJButton then
        manageDJButton.Visible = true
        input:Bind(manageDJButton, function() showPage(pageManageDJs) end)
    end

    local djModeCard = controlScroll and controlScroll:FindFirstChild("DJModeCard", true)
    local transportCard = controlScroll and controlScroll:FindFirstChild("TransportCard", true)
    local speedCard = controlScroll and controlScroll:FindFirstChild("SpeedCard", true)
    local volumeCard = controlScroll and controlScroll:FindFirstChild("MasterVolumeCard", true)

    if djModeCard then
        local toggle = djModeCard:FindFirstChild("ToggleButton", true)
        if toggle then input:Bind(toggle, function() fire("toggledjmode") end) end
    end

    if transportCard then
        local pads = transportCard:FindFirstChild("Pads")
        if pads then
            input:Bind(child(pads, "pausePad"), function() fire("pause") end)
            input:Bind(child(pads, "playPad"), function() fire("resume") end)
            input:Bind(child(pads, "replayPad"), function() fire("playagain") end)
        end
    end

    local function setSliderVisual(bg, ratio)
        if not bg then return end
        ratio = math.clamp(tonumber(ratio) or 0, 0, 1)
        local fill = bg:FindFirstChild("SliderFill")
        local knob = bg:FindFirstChild("SliderKnob")
        if fill then fill.Size = UDim2.new(ratio, 0, fill.Size.Y.Scale, fill.Size.Y.Offset) end
        if knob then
            knob.Position = UDim2.new(ratio, -math.floor(knob.Size.X.Offset / 2), knob.Position.Y.Scale, knob.Position.Y.Offset)
        end
    end
    api.SetSliderVisual = setSliderVisual

    local function setToggleVisual(container, enabled)
        if not container then return end
        local knob = container:FindFirstChild("ToggleKnob") or container:FindFirstChild("Knob")
        TweenService:Create(container, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            BackgroundColor3 = enabled and Color3.fromRGB(124, 124, 124) or Color3.fromRGB(51, 51, 51),
            BackgroundTransparency = enabled and 0.15 or 0,
        }):Play()
        if knob then
            local halfY = math.floor(knob.Size.Y.Offset / 2)
            TweenService:Create(knob, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Position = enabled
                    and UDim2.new(1, -(knob.Size.X.Offset + 4), 0.5, -halfY)
                    or UDim2.new(0, 4, 0.5, -halfY),
                BackgroundColor3 = enabled and Color3.fromRGB(238, 238, 238) or Color3.fromRGB(154, 154, 154),
            }):Play()
        end
    end
    api.SetToggleVisual = setToggleVisual

    local function updateSegmentedVisual(segmented, selectedValue, parser)
        if not segmented then return end
        for _, button in ipairs(segmented:GetChildren()) do
            if button:IsA("TextButton") then
                local value = parser(button.Text)
                local selected = value ~= nil and math.abs(value - selectedValue) < 0.015
                TweenService:Create(button, TweenInfo.new(0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(10, 10, 10),
                    BackgroundTransparency = selected and 0.04 or 0.16,
                    TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(238, 238, 238),
                }):Play()
            end
        end
    end

    if speedCard then
        local readout = speedCard:FindFirstChild("Readout")
        local segmented = speedCard:FindFirstChild("Segmented")
        local speedBg = speedCard:FindFirstChild("SliderBg", true)
        if segmented then
            for _, button in ipairs(segmented:GetChildren()) do
                if button:IsA("TextButton") then
                    input:Bind(button, function()
                        local value = tonumber(button.Text:match("[%d%.]+"))
                        if value then fire("setspeed", value) end
                    end)
                end
            end
        end
        if speedBg then
            bindSlider(speedBg, 0.1, 2, function(value, ratio)
                setSliderVisual(speedBg, ratio)
                if readout then readout.Text = string.format("%.2fx", value) end
            end, function(value)
                fire("setspeed", value)
            end)
        end
        if readout and readout:IsA("TextBox") then
            readout.TextEditable = false
            readout.Active = false
            readout.Selectable = false
            readout.ClearTextOnFocus = false
        end
    end

    if volumeCard then
        local readout = volumeCard:FindFirstChild("Readout")
        local segmented = volumeCard:FindFirstChild("Segmented")
        local volumeBg = volumeCard:FindFirstChild("SliderBg", true)
        if segmented then
            for _, button in ipairs(segmented:GetChildren()) do
                if button:IsA("TextButton") then
                    input:Bind(button, function()
                        local percent = tonumber(button.Text:match("%d+"))
                        if percent then fire("setvolume", percent / 100) end
                    end)
                end
            end
        end
        if volumeBg then
            bindSlider(volumeBg, 0, 5, function(value, ratio)
                setSliderVisual(volumeBg, ratio)
                if readout then readout.Text = string.format("%d%%", math.floor(value * 100 + 0.5)) end
            end, function(value)
                fire("setvolume", value)
            end)
        end
    end

    function api:SetAccess(allowed)
        allowed = allowed == true
        if addSongButton then addSongButton.Visible = allowed end
        if manageDJButton then manageDJButton.Visible = allowed end
        if manageRow and manageRow:IsA("GuiObject") then manageRow.Visible = allowed end
        if not allowed then showPage(pageHub) end
    end

    function api:Apply(packet)
        packet = type(packet) == "table" and packet or {}
        local enabled = first(packet, {"djModeEnabled", "DJModeEnabled"}, false) == true
        if djModeCard then
            local status = djModeCard:FindFirstChild("V", true)
            local led = djModeCard:FindFirstChild("LED", true)
            local container = djModeCard:FindFirstChild("ToggleContainer", true)
            if status then status.Text = enabled and "ONLINE" or "OFFLINE" end
            if led then led.BackgroundColor3 = enabled and Color3.fromRGB(238, 238, 238) or Color3.fromRGB(238, 238, 238) end
            setToggleVisual(container, enabled)
        end

        local speed = tonumber(first(packet, {"playbackSpeed", "PlaybackSpeed"}, 1)) or 1
        if speedCard then
            local readout = speedCard:FindFirstChild("Readout")
            local bg = speedCard:FindFirstChild("SliderBg", true)
            if readout then readout.Text = string.format("%.2fx", speed) end
            if bg then setSliderVisual(bg, (speed - 0.1) / 1.9) end
            updateSegmentedVisual(speedCard:FindFirstChild("Segmented"), speed, function(text)
                return tonumber(text:match("[%d%.]+"))
            end)
        end

        local volume = tonumber(first(packet, {"volume", "Volume"}, 1)) or 1
        if volumeCard then
            local readout = volumeCard:FindFirstChild("Readout")
            local bg = volumeCard:FindFirstChild("SliderBg", true)
            if readout then readout.Text = string.format("%d%%", math.floor(volume * 100 + 0.5)) end
            if bg then setSliderVisual(bg, volume / 5) end
            updateSegmentedVisual(volumeCard:FindFirstChild("Segmented"), volume, function(text)
                local percent = tonumber(text:match("%d+"))
                return percent and percent / 100 or nil
            end)
        end

        input:PrepareScroll(controlScroll)
    end

    return api
end

return Module
]]></ProtectedString>
								<string name="ScriptGuid">{89EC3B69-6F6C-46AA-AF73-4537DD16AE93}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">QOIWUEFJQWPA</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">0</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX5708D2735E2F412BAD3C3791BC08D2AF">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- posisi pointer dalam koordinat panel (diisi Caa3DTilt saat panel dirender di bidang 3D)
local function ptOf(input)
	local f = rawget(_G, "CaaMusicPt")
	if f then
		local ok, v = pcall(f, input)
		if ok and typeof(v) == "Vector2" then return v end
	end
	return Vector2.new(input.Position.X, input.Position.Y)
end

local Module = {}

function Module.new(ctx, input, controls)
    assert(type(ctx) == "table", "DJ effects context is required")
    assert(type(input) == "table", "DJ input module is required")
    assert(type(controls) == "table", "DJ controls module is required")

    local connect = ctx.connect
    local fire = ctx.fire
    local bindSlider = ctx.bindSlider
    local registerTransientInputCancel = ctx.registerTransientInputCancel or function() end
    local first = ctx.first
    local pageEffects = controls.pages.effects
    local effectsBox = pageEffects:FindFirstChild("Box", true)

    local effectValues = {}
    local effectToggleContainers = {}
    local horizontalEffectControls = {}
    local verticalEffectControls = {}

    local setSliderVisual = controls.SetSliderVisual
    local setToggleVisual = controls.SetToggleVisual

    local function bindEffectToggle(section, effectName)
        if not section then return end
        local container = section:FindFirstChild("ToggleContainer", true) or section:FindFirstChild("EQToggle", true)
        local button = container and (container:FindFirstChild("ToggleButton") or container:FindFirstChild("Btn"))
        if not button then return end
        effectToggleContainers[effectName] = container
        input:Bind(button, function()
            local current = effectValues[effectName] or {}
            fire("seteffect", {effect = effectName, enabled = not (current.enabled == true)})
        end)
    end

    local function bindEffectHorizontal(rowName, effectName, field, minimum, maximum, formatter)
        if not effectsBox then return end
        local row = effectsBox:FindFirstChild(rowName, true)
        local bg = row and row:FindFirstChild("SliderBg")
        if not bg then return end
        local label = row:FindFirstChild("Value")
        horizontalEffectControls[effectName .. "." .. field] = {
            bg = bg,
            label = label,
            min = minimum,
            max = maximum,
            formatter = formatter,
        }
        bindSlider(bg, minimum, maximum, function(value, ratio)
            setSliderVisual(bg, ratio)
            if label then label.Text = formatter(value) end
        end, function(value)
            fire("seteffect", {effect = effectName, [field] = value})
        end)
    end

    local function setVerticalVisual(track, ratio)
        ratio = math.clamp(tonumber(ratio) or 0, 0, 1)
        local y = 1 - ratio
        local cap = track:FindFirstChild("Cap")
        local fill = track:FindFirstChild("Fill")
        if cap then
            cap.Position = UDim2.new(cap.Position.X.Scale, cap.Position.X.Offset, y, -math.floor(cap.Size.Y.Offset / 2))
        end
        if fill then
            local top = math.min(y, 0.5)
            fill.Position = UDim2.new(fill.Position.X.Scale, fill.Position.X.Offset, top, 0)
            fill.Size = UDim2.new(fill.Size.X.Scale, fill.Size.X.Offset, math.abs(0.5 - y), 0)
        end
    end

    local function bindVerticalSlider(track, minimum, maximum, onChange, onCommit)
        local hit = track and track:FindFirstChild("Hit")
        if not hit then return end
        hit.Active = true
        local dragging = false
        local activeInput
        local activeStateConnection
        local lastValue = minimum

        local function cancelSlider(commit)
            local shouldCommit = dragging and commit == true
            dragging = false
            activeInput = nil
            if activeStateConnection then
                activeStateConnection:Disconnect()
                activeStateConnection = nil
            end
            if shouldCommit and onCommit then onCommit(lastValue) end
        end
        registerTransientInputCancel(function() cancelSlider(false) end)

        local function fromY(y)
            local height = math.max(1, track.AbsoluteSize.Y)
            local ratio = 1 - math.clamp((y - track.AbsolutePosition.Y) / height, 0, 1)
            local value = minimum + (maximum - minimum) * ratio
            lastValue = value
            onChange(value, ratio)
        end

        connect(hit.InputBegan, function(inputObject)
            if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1
                and inputObject.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            cancelSlider(false)
            dragging = true
            activeInput = inputObject
            fromY(ptOf(inputObject).Y)
            activeStateConnection = inputObject.Changed:Connect(function()
                local inputState = inputObject.UserInputState
                if inputState == Enum.UserInputState.End then
                    cancelSlider(true)
                elseif inputState == Enum.UserInputState.Cancel then
                    cancelSlider(false)
                end
            end)
        end)

        connect(UserInputService.InputChanged, function(inputObject)
            if not dragging or not activeInput then return end
            local matchesMouse = activeInput.UserInputType == Enum.UserInputType.MouseButton1
                and inputObject.UserInputType == Enum.UserInputType.MouseMovement
            local matchesTouch = activeInput.UserInputType == Enum.UserInputType.Touch and inputObject == activeInput
            if matchesMouse or matchesTouch then fromY(ptOf(inputObject).Y) end
        end)

        connect(UserInputService.InputEnded, function(inputObject)
            if inputObject == activeInput
                or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
                    and inputObject.UserInputType == Enum.UserInputType.MouseButton1) then
                cancelSlider(true)
            end
        end)
    end

    local function bindEffectVertical(trackName, labelName, effectName, field)
        if not effectsBox then return end
        local track = effectsBox:FindFirstChild(trackName, true)
        local label = effectsBox:FindFirstChild(labelName, true)
        if not track then return end
        verticalEffectControls[effectName .. "." .. field] = {
            track = track,
            label = label,
            min = -20,
            max = 20,
        }
        bindVerticalSlider(track, -20, 20, function(value, ratio)
            setVerticalVisual(track, ratio)
            if label then label.Text = string.format("%+.1f", value) end
        end, function(value)
            fire("seteffect", {effect = effectName, [field] = value})
        end)
    end

    if effectsBox then
        bindEffectToggle(effectsBox:FindFirstChild("EqualizerCard", true), "equalizer")
        bindEffectToggle(effectsBox:FindFirstChild("CompressorSection", true), "compressor")
        bindEffectToggle(effectsBox:FindFirstChild("ReverbSection", true), "reverb")
        bindEffectVertical("EQ_LowGainTrack", "EQ_LowGainValue", "equalizer", "lowGain")
        bindEffectVertical("EQ_MidGainTrack", "EQ_MidGainValue", "equalizer", "midGain")
        bindEffectVertical("EQ_HighGainTrack", "EQ_HighGainValue", "equalizer", "highGain")
        bindEffectHorizontal("Comp_ThresholdRow", "compressor", "threshold", -80, 0, function(v) return string.format("%.1fdB", v) end)
        bindEffectHorizontal("Comp_RatioRow", "compressor", "ratio", 1, 50, function(v) return string.format("%.1f:1", v) end)
        bindEffectHorizontal("Comp_AttackRow", "compressor", "attack", 0.001, 1, function(v) return string.format("%.3fs", v) end)
        bindEffectHorizontal("Comp_ReleaseRow", "compressor", "release", 0.01, 1, function(v) return string.format("%.2fs", v) end)
        bindEffectHorizontal("Rev_DecayTimeRow", "reverb", "decayTime", 0.1, 20, function(v) return string.format("%.1fs", v) end)
        bindEffectHorizontal("Rev_DensityRow", "reverb", "density", 0, 1, function(v) return string.format("%.2f", v) end)
        bindEffectHorizontal("Rev_WetLevelRow", "reverb", "wetLevel", -80, 10, function(v) return string.format("%.1fdB", v) end)
    end

    local resetEffects = pageEffects:FindFirstChild("ResetButton")
    if resetEffects then input:Bind(resetEffects, function() fire("reseteffects") end) end

    local api = {}

    function api:Apply(packet)
        packet = type(packet) == "table" and packet or {}
        effectValues = first(packet, {"effects", "Effects"}, effectValues) or effectValues

        for effectName, container in pairs(effectToggleContainers) do
            local data = effectValues[effectName] or {}
            setToggleVisual(container, data.enabled == true)
        end

        for key, control in pairs(horizontalEffectControls) do
            local effectName, field = key:match("^([^.]+)%.(.+)$")
            local value = effectName and effectValues[effectName] and tonumber(effectValues[effectName][field])
            if value then
                local ratio = (value - control.min) / (control.max - control.min)
                setSliderVisual(control.bg, ratio)
                if control.label then control.label.Text = control.formatter(value) end
            end
        end

        for key, control in pairs(verticalEffectControls) do
            local effectName, field = key:match("^([^.]+)%.(.+)$")
            local value = effectName and effectValues[effectName] and tonumber(effectValues[effectName][field])
            if value then
                local ratio = (value - control.min) / (control.max - control.min)
                setVerticalVisual(control.track, ratio)
                if control.label then control.label.Text = string.format("%+.1f", value) end
            end
        end
    end

    return api
end

return Module
]]></ProtectedString>
								<string name="ScriptGuid">{4304E30A-51C2-413F-A44A-2A1C3FB78028}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">VBNMZCXQWEIR</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">0</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX11CABDD3AA044840AD80EDD74C504A53">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local Module = {}

function Module.new(ctx, input, controls)
    assert(type(ctx) == "table", "DJ management context is required")
    assert(type(input) == "table", "DJ input module is required")
    assert(type(controls) == "table", "DJ controls module is required")

    local connect = ctx.connect
    local fire = ctx.fire
    local state = ctx.state
    local first = ctx.first
    local player = ctx.player
    local trackName = ctx.trackName
    local trackCollection = ctx.trackCollection
    local trackImage = ctx.trackImage
    local asset = ctx.asset
    local lower = ctx.lower
    local applyFavoriteVisual = ctx.applyFavoriteVisual
    local isFavorite = ctx.isFavorite
    local toggleFavorite = ctx.toggleFavorite
    local notify = ctx.notify

    local pageManageSong = controls.pages.manageSong
    local pageManageDJs = controls.pages.manageDJs

    input:PreparePage(pageManageSong)
    input:PreparePage(pageManageDJs)

    local renderCustomSongs


    local formCard = pageManageSong:FindFirstChild("FormCard", true)
    local idsBox
    local titleBox
    local speedBox
    local collectionBox
    local imageBox
    local collectionDropdown

    if formCard then
        idsBox = formCard:FindFirstChild("AddSongIds", true)
        titleBox = formCard:FindFirstChild("AddSongTitle", true)
        speedBox = formCard:FindFirstChild("AddSongSpeed", true)
        collectionBox = formCard:FindFirstChild("AddSongCollection", true)
        imageBox = formCard:FindFirstChild("AddSongImage", true)
        local openCollection = formCard:FindFirstChild("OpenBtn", true)
        collectionDropdown = formCard:FindFirstChild("CollectionDropdown", true)
        local submit = formCard:FindFirstChild("AddSongSubmit", true)

        input:PrepareScroll(collectionDropdown)

        if openCollection and collectionDropdown then
            input:Bind(openCollection, function()
                collectionDropdown.Visible = not collectionDropdown.Visible
                if collectionDropdown.Visible then input:PrepareScroll(collectionDropdown) end
            end)
        end

        if collectionDropdown and collectionBox then
            for _, option in ipairs(collectionDropdown:GetChildren()) do
                if option:IsA("TextButton") then
                    input:Bind(option, function()
                        local label = option:FindFirstChild("T")
                        if label then collectionBox.Text = label.Text end
                        collectionDropdown.Visible = false
                    end)
                end
            end
        end

        local presets = formCard:FindFirstChild("ImagePresetScroll", true)
        input:PrepareScroll(presets)
        if presets and imageBox then
            for _, preset in ipairs(presets:GetChildren()) do
                if preset:IsA("ImageButton") then
                    input:Bind(preset, function()
                        imageBox.Text = tostring(preset.Image):match("(%d+)") or ""
                    end)
                end
            end
        end

        if submit then
            input:Bind(submit, function()
                local ids = {}
                for id in tostring(idsBox and idsBox.Text or ""):gmatch("%d+") do
                    table.insert(ids, id)
                end
                if #ids == 0 then
                    notify("error", "INVALID INPUT", "Sound ID is required", nil, 3.2)
                    return
                end
                local newTrack = {
                    id = ids[1],
                    soundIds = ids,
                    name = titleBox and titleBox.Text ~= "" and titleBox.Text or ("Music " .. ids[1]),
                    playbackSpeed = tonumber(speedBox and speedBox.Text) or 1,
                    collection = collectionBox and collectionBox.Text or "DJ",
                    imageId = imageBox and imageBox.Text or "",
                }
                state.pendingNoticeTrack = newTrack
                fire("addlibrary", newTrack)
            end)
        end
    end


    local djForm = pageManageDJs:FindFirstChild("DJFormCard", true)
    if djForm then
        local inner = djForm:FindFirstChild("Content")
        if inner then inner.Visible = true end
        local usernameInput = djForm:FindFirstChild("DJUsernameInput", true)
        local add = djForm:FindFirstChild("AddDJButton", true)
        local found = djForm:FindFirstChild("FoundCard", true)
        local lookupSerial = 0

        if usernameInput and found then
            connect(usernameInput:GetPropertyChangedSignal("Text"), function()
                lookupSerial += 1
                local serial = lookupSerial
                local username = usernameInput.Text:gsub("%s+", "")
                local empty = found:FindFirstChild("Empty")
                local avatar = found:FindFirstChild("Avatar")
                local nameLabel = found:FindFirstChild("Name")
                local userLabel = found:FindFirstChild("User")

                if username == "" then
                    if empty then empty.Visible = true; empty.Text = "Type a username to preview" end
                    if avatar then avatar.Visible = false end
                    if nameLabel then nameLabel.Visible = false end
                    if userLabel then userLabel.Visible = false end
                    return
                end

                task.delay(0.45, function()
                    if serial ~= lookupSerial then return end
                    local ok, userId = pcall(Players.GetUserIdFromNameAsync, Players, username)
                    if serial ~= lookupSerial then return end
                    if not ok then
                        if empty then empty.Visible = true; empty.Text = "Username not found" end
                        return
                    end
                    local image = ""
                    pcall(function()
                        image = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                    end)
                    if empty then empty.Visible = false end
                    if avatar then avatar.Visible = true; avatar.Image = image end
                    if nameLabel then nameLabel.Visible = true; nameLabel.Text = username end
                    if userLabel then userLabel.Visible = true; userLabel.Text = "@" .. username end
                end)
            end)
        end

        if add and usernameInput then
            input:Bind(add, function()
                if usernameInput.Text ~= "" then
                    fire("adddj", {username = usernameInput.Text})
                end
            end)
        end
    end


    local customSongScroll = input:PrepareScroll(pageManageSong:FindFirstChild("CustomSongScroll", true))
    local emptySongs = pageManageSong:FindFirstChild("EmptySongs", true)
    local addedSearch = pageManageSong:FindFirstChild("AddedSearch", true)
    local addedSearchClear = pageManageSong:FindFirstChild("AddedSearchClear", true)
    local addedBadgeNumber = pageManageSong:FindFirstChild("AddedBadge", true)
    addedBadgeNumber = addedBadgeNumber and addedBadgeNumber:FindFirstChild("N")

    local previewCard = pageManageSong:FindFirstChild("PreviewCard", true)
    local previewContent = previewCard and previewCard:FindFirstChild("Content")
    local previewCover = previewContent and previewContent:FindFirstChild("Cover")
    local previewCoverImage = previewCover and previewCover:FindFirstChild("Top")
    local previewTitle = previewContent and previewContent:FindFirstChild("Title")
    local previewBadges = previewContent and previewContent:FindFirstChild("Badges")
    local previewCollection = previewBadges and previewBadges:FindFirstChild("ColBadge")
    previewCollection = previewCollection and previewCollection:FindFirstChild("T")
    local previewSpeed = previewBadges and previewBadges:FindFirstChild("SpeedBadge")
    previewSpeed = previewSpeed and previewSpeed:FindFirstChild("T")
    local previewParts = previewBadges and previewBadges:FindFirstChild("PartBadge")
    previewParts = previewParts and previewParts:FindFirstChild("T")

    local function updateSongPreview()
        local ids = {}
        for id in tostring(idsBox and idsBox.Text or ""):gmatch("%d+") do
            table.insert(ids, id)
        end
        local title = titleBox and titleBox.Text or ""
        local collection = collectionBox and collectionBox.Text or ""
        local speed = tonumber(speedBox and speedBox.Text) or 1
        local image = asset(imageBox and imageBox.Text or "")

        if previewTitle then previewTitle.Text = title ~= "" and title or "Music Preview" end
        if previewCollection then previewCollection.Text = collection ~= "" and collection or "DJ" end
        if previewSpeed then previewSpeed.Text = string.format("%.2fx", math.clamp(speed, 0.1, 2)) end
        if previewParts then previewParts.Text = string.format("%d %s", math.max(1, #ids), #ids == 1 and "part" or "parts") end
        if previewCoverImage then
            previewCoverImage.Image = image
            previewCoverImage.Visible = image ~= ""
        end
    end

    for _, textInput in ipairs({idsBox, titleBox, speedBox, collectionBox, imageBox}) do
        if textInput and textInput:IsA("TextBox") then
            connect(textInput:GetPropertyChangedSignal("Text"), updateSongPreview)
        end
    end
    updateSongPreview()

    local function updateManageSongCollections()
        if not collectionDropdown then return end
        local options = {}
        for _, option in ipairs(collectionDropdown:GetChildren()) do
            if option:IsA("TextButton") then table.insert(options, option) end
        end
        table.sort(options, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        for index, option in ipairs(options) do
            local collection = state.collections[index]
            local label = option:FindFirstChild("T")
            if collection then
                local name = tostring(collection.name or collection.Name or ("Playlist " .. index))
                option.Visible = true
                option:SetAttribute("CollectionName", name)
                if label then label.Text = name end
            else
                option.Visible = false
                option:SetAttribute("CollectionName", nil)
            end
        end
        input:PrepareScroll(collectionDropdown)
    end

    local customSongRows = {}
    local function clearCustomSongRows()
        for _, row in ipairs(customSongRows) do
            if row.Parent then row:Destroy() end
        end
        table.clear(customSongRows)
    end

    local function createCustomSongRow(track, index)
        if not customSongScroll then return nil end
        local row = Instance.new("TextButton")
        row.Name = "IFEACFSEFIEFB"
        row.Size = UDim2.new(1, -4, 0, 54)
        row.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        row.BackgroundTransparency = 0.16
        row.BorderSizePixel = 0
        row.Text = ""
        row.AutoButtonColor = false
        row.LayoutOrder = index
        row.Parent = customSongScroll

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 7)
        corner.Parent = row
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(124, 124, 124)
        stroke.Transparency = 0.58
        stroke.Thickness = 1
        stroke.Parent = row

        local thumb = Instance.new("Frame")
        thumb.Name = "QOWIEURQW"
        thumb.AnchorPoint = Vector2.new(0, 0.5)
        thumb.Position = UDim2.new(0, 7, 0.5, 0)
        thumb.Size = UDim2.fromOffset(40, 40)
        thumb.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
        thumb.BorderSizePixel = 0
        thumb.ClipsDescendants = true
        thumb.Parent = row
        local thumbCorner = Instance.new("UICorner")
        thumbCorner.CornerRadius = UDim.new(0, 6)
        thumbCorner.Parent = thumb

        local image = trackImage(track)
        local cover = Instance.new("ImageLabel")
        cover.Size = UDim2.fromScale(1, 1)
        cover.BackgroundTransparency = 1
        cover.Image = image
        cover.Visible = image ~= ""
        cover.ScaleType = Enum.ScaleType.Crop
        cover.Parent = thumb

        local fallback = Instance.new("TextLabel")
        fallback.Size = UDim2.fromScale(1, 1)
        fallback.BackgroundTransparency = 1
        fallback.Font = Enum.Font.DenkOne
        fallback.Text = "M"
        fallback.TextColor3 = Color3.fromRGB(238, 238, 238)
        fallback.TextSize = 17
        fallback.Visible = image == ""
        fallback.Parent = thumb

        local title = Instance.new("TextLabel")
        title.Position = UDim2.fromOffset(56, 7)
        title.Size = UDim2.new(1, -126, 0, 21)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.DenkOne
        title.Text = trackName(track)
        title.TextColor3 = Color3.fromRGB(238, 238, 238)
        title.TextSize = 13
        title.TextTruncate = Enum.TextTruncate.AtEnd
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = row

        local meta = Instance.new("TextLabel")
        meta.Position = UDim2.fromOffset(56, 29)
        meta.Size = UDim2.new(1, -126, 0, 17)
        meta.BackgroundTransparency = 1
        meta.Font = Enum.Font.DenkOne
        meta.Text = string.format("%s  ·  %.2fx", trackCollection(track), tonumber(first(track, {"playbackSpeed", "PlaybackSpeed"}, 1)) or 1)
        meta.TextColor3 = Color3.fromRGB(154, 154, 154)
        meta.TextSize = 10
        meta.TextTruncate = Enum.TextTruncate.AtEnd
        meta.TextXAlignment = Enum.TextXAlignment.Left
        meta.Parent = row

        local favorite = Instance.new("ImageButton")
        favorite.Name = "JQOWIEURQ"
        favorite.AnchorPoint = Vector2.new(1, 0.5)
        favorite.Position = UDim2.new(1, -42, 0.5, 0)
        favorite.Size = UDim2.fromOffset(25, 25)
        favorite.BackgroundTransparency = 1
        favorite.AutoButtonColor = false
        favorite.Parent = row
        applyFavoriteVisual(favorite, isFavorite(track))

        local removeSong = Instance.new("ImageButton")
        removeSong.Name = "MNBVCXZLKJHG"
        removeSong.AnchorPoint = Vector2.new(1, 0.5)
        removeSong.Position = UDim2.new(1, -8, 0.5, 0)
        removeSong.Size = UDim2.fromOffset(25, 25)
        removeSong.BackgroundTransparency = 1
        removeSong.BorderSizePixel = 0
        removeSong.AutoButtonColor = false
        removeSong.Image = "rbxassetid://14002617467"
        removeSong.ImageColor3 = Color3.fromRGB(106, 106, 106)
        removeSong.ImageTransparency = 1
        removeSong.ScaleType = Enum.ScaleType.Fit
        removeSong.Parent = row

        local removeGlyph = Instance.new("ImageLabel")
        removeGlyph.Name = "POIUYTREWQAS"
        removeGlyph.AnchorPoint = Vector2.new(0.5, 0.5)
        removeGlyph.Position = UDim2.fromScale(0.5, 0.5)
        removeGlyph.Size = UDim2.fromScale(0.72, 0.72)
        removeGlyph.BackgroundTransparency = 1
        removeGlyph.BorderSizePixel = 0
        removeGlyph.Image = "rbxassetid://14002617467"
        removeGlyph.ImageColor3 = Color3.fromRGB(106, 106, 106)
        removeGlyph.ScaleType = Enum.ScaleType.Fit
        removeGlyph.Active = false
        removeGlyph.Selectable = false
        removeGlyph.ZIndex = removeSong.ZIndex + 1
        removeGlyph.Parent = removeSong

        connect(removeSong.InputBegan, function(inputObject)
            if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                or inputObject.UserInputType == Enum.UserInputType.Touch then
                state.suppressQueueUntil = os.clock() + 0.45
            end
        end)
        input:Bind(removeSong, function()
            state.suppressQueueUntil = os.clock() + 0.45
            state.pendingNoticeTrack = track
            fire("removelibrary", {
                id = tostring(first(track, {"id", "soundId", "SoundId"}, "")),
                name = trackName(track),
            })
        end)

        connect(favorite.InputBegan, function(inputObject)
            if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                or inputObject.UserInputType == Enum.UserInputType.Touch then
                state.suppressQueueUntil = os.clock() + 0.35
            end
        end)
        input:Bind(favorite, function()
            state.suppressQueueUntil = os.clock() + 0.35
            toggleFavorite(track)
        end)
        input:Bind(row, function()
            if os.clock() < state.suppressQueueUntil then return end
            state.pendingNoticeTrack = track
            fire("queue", track)
        end)
        return row
    end

    renderCustomSongs = function(packet)
        if not customSongScroll then return end
        local songs = first(packet or state.packet, {"customSongs", "CustomSongs"}, {})
        if type(songs) ~= "table" then songs = {} end
        local query = lower(addedSearch and addedSearch.Text or "")
        clearCustomSongRows()
        local shown = 0
        for _, track in ipairs(songs) do
            if query == ""
                or lower(trackName(track)):find(query, 1, true)
                or lower(trackCollection(track)):find(query, 1, true) then
                shown += 1
                local row = createCustomSongRow(track, shown)
                if row then table.insert(customSongRows, row) end
            end
        end
        customSongScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        input:PrepareScroll(customSongScroll)
        if emptySongs then emptySongs.Visible = shown == 0 end
        if addedBadgeNumber then addedBadgeNumber.Text = tostring(#songs) end
        if addedSearchClear then addedSearchClear.Visible = query ~= "" end
    end

    if addedSearch then
        connect(addedSearch:GetPropertyChangedSignal("Text"), function()
            renderCustomSongs(state.packet)
        end)
    end
    if addedSearchClear then
        addedSearchClear.Text = "X"
        input:Bind(addedSearchClear, function()
            if addedSearch then addedSearch.Text = "" end
        end)
    end


    local rosterScroll = input:PrepareScroll(pageManageDJs:FindFirstChild("RosterScroll", true))
    local residentGrid = rosterScroll and rosterScroll:FindFirstChild("ResGrid")
    local guestGrid = rosterScroll and rosterScroll:FindFirstChild("GueGrid")
    local residentHeader = rosterScroll and rosterScroll:FindFirstChild("ResHeader")
    local guestHeader = rosterScroll and rosterScroll:FindFirstChild("GueHeader")
    local djBadge = pageManageDJs:FindFirstChild("DJBadge")
    local residentBadge = djBadge and djBadge:FindFirstChild("Res")
    local guestBadge = djBadge and djBadge:FindFirstChild("Gue")
    local rosterCards = {}
    local rosterThumbnailCache = {}
    local rosterNameCache = {}
    local lastRosterSignature = nil
    local lastResidentRoster = {}
    local lastGuestRoster = {}

    local function clearRosterCards()
        for _, card in ipairs(rosterCards) do
            if card.Parent then card:Destroy() end
        end
        table.clear(rosterCards)
    end

    local function createRosterCard(parent, userId, username, resident)
        if not parent then return nil end
        local card = Instance.new("Frame")
        card.Name = resident and "QWERTYUIOPAS" or "ZXCVBNMLKJHG"
        card.Size = UDim2.fromOffset(150, 128)
        card.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        card.BackgroundTransparency = 0.10
        card.BorderSizePixel = 0
        card.Parent = parent
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 9)
        corner.Parent = card
        local stroke = Instance.new("UIStroke")
        stroke.Color = resident and Color3.fromRGB(238, 238, 238) or Color3.fromRGB(124, 124, 124)
        stroke.Transparency = resident and 0.28 or 0.55
        stroke.Thickness = 1
        stroke.Parent = card

        local avatar = Instance.new("ImageLabel")
        avatar.Name = "Avatar"
        avatar.AnchorPoint = Vector2.new(0.5, 0)
        avatar.Position = UDim2.new(0.5, 0, 0, 10)
        avatar.Size = UDim2.fromOffset(58, 58)
        avatar.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
        avatar.BorderSizePixel = 0
        avatar.Parent = card
        local avatarCorner = Instance.new("UICorner")
        avatarCorner.CornerRadius = UDim.new(1, 0)
        avatarCorner.Parent = avatar

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Position = UDim2.new(0, 8, 0, 75)
        nameLabel.Size = UDim2.new(1, -16, 0, 20)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.DenkOne
        nameLabel.Text = username
        nameLabel.TextColor3 = Color3.fromRGB(238, 238, 238)
        nameLabel.TextSize = 12
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        nameLabel.Parent = card

        local roleLabel = Instance.new("TextLabel")
        roleLabel.Position = UDim2.new(0, 8, 0, 98)
        roleLabel.Size = UDim2.new(1, -16, 0, 18)
        roleLabel.BackgroundTransparency = 1
        roleLabel.Font = Enum.Font.DenkOne
        roleLabel.Text = resident and "RESIDENT DJ" or "SESSION DJ"
        roleLabel.TextColor3 = resident and Color3.fromRGB(238, 238, 238) or Color3.fromRGB(154, 154, 154)
        roleLabel.TextSize = 9
        roleLabel.Parent = card

        if not resident then
            local removeButton = Instance.new("ImageButton")
            removeButton.Name = "POIUYTREWQAS"
            removeButton.AnchorPoint = Vector2.new(1, 0)
            removeButton.Position = UDim2.new(1, -8, 0, 8)
            removeButton.Size = UDim2.fromOffset(24, 24)
            removeButton.BackgroundColor3 = Color3.fromRGB(19, 19, 19)
            removeButton.BackgroundTransparency = 0.18
            removeButton.BorderSizePixel = 0
            removeButton.AutoButtonColor = false
            removeButton.Image = "rbxassetid://14002617467"
            removeButton.ImageColor3 = Color3.fromRGB(106, 106, 106)
            removeButton.ScaleType = Enum.ScaleType.Fit
            removeButton.Parent = card

            local removeCorner = Instance.new("UICorner")
            removeCorner.CornerRadius = UDim.new(0, 6)
            removeCorner.Parent = removeButton

            input:Bind(removeButton, function()
                fire("removedj", {userId = tonumber(userId), username = username})
            end)
        end

        if tonumber(userId) and tonumber(userId) > 0 then
            local numericUserId = tonumber(userId)
            local cachedImage = rosterThumbnailCache[numericUserId]
            if cachedImage then
                avatar.Image = cachedImage
            end
            local cachedName = rosterNameCache[numericUserId]
            if cachedName and tostring(username):match("^User %d+$") then
                nameLabel.Text = cachedName
            end

            if not cachedImage or (tostring(username):match("^User %d+$") and not cachedName) then
                task.spawn(function()
                    if not cachedImage then
                        local okImage, image = pcall(function()
                            return Players:GetUserThumbnailAsync(numericUserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                        end)
                        if okImage and type(image) == "string" and image ~= "" then
                            rosterThumbnailCache[numericUserId] = image
                            if card.Parent then avatar.Image = image end
                        end
                    end

                    if tostring(username):match("^User %d+$") and not cachedName then
                        local okName, resolvedName = pcall(function()
                            return Players:GetNameFromUserIdAsync(numericUserId)
                        end)
                        if okName and type(resolvedName) == "string" and resolvedName ~= "" then
                            rosterNameCache[numericUserId] = resolvedName
                            if card.Parent then nameLabel.Text = resolvedName end
                        end
                    end
                end)
            end
        end
        return card
    end

    local function normalizeRoster(source, role)
        local normalized = {}
        local seen = {}
        if type(source) ~= "table" then return normalized end

        for _, data in ipairs(source) do
            if type(data) == "table" then
                local userId = tonumber(data.userId or data.UserId) or 0
                local username = tostring(data.username or data.Username or ("User " .. tostring(userId)))
                local key = userId > 0 and tostring(userId) or string.lower(username)
                if key ~= "" and not seen[key] then
                    seen[key] = true
                    normalized[#normalized + 1] = {
                        userId = userId,
                        username = username,
                        role = role,
                    }
                end
            end
        end
        table.sort(normalized, function(left, right)
            if left.userId == right.userId then
                return string.lower(left.username) < string.lower(right.username)
            end
            if left.userId == 0 then return false end
            if right.userId == 0 then return true end
            return left.userId < right.userId
        end)
        return normalized
    end

    local function cloneRoster(source)
        local output = table.create(#source)
        for index, data in ipairs(source) do
            output[index] = {
                userId = data.userId,
                username = data.username,
                role = data.role,
            }
        end
        return output
    end

    local function rosterSignature(residents, guests)
        local parts = table.create(#residents + #guests + 2)
        parts[#parts + 1] = "R"
        for _, data in ipairs(residents) do
            parts[#parts + 1] = tostring(data.userId) .. ":" .. string.lower(data.username)
        end
        parts[#parts + 1] = "G"
        for _, data in ipairs(guests) do
            parts[#parts + 1] = tostring(data.userId) .. ":" .. string.lower(data.username)
        end
        return table.concat(parts, "|")
    end

    local function updateRosterCount(residentCount, guestCount)
        local resN = residentHeader and residentHeader:FindFirstChild("N")
        local gueN = guestHeader and guestHeader:FindFirstChild("N")
        if resN then resN.Text = tostring(residentCount) end
        if gueN then gueN.Text = tostring(guestCount) end
        if residentBadge then residentBadge.Text = tostring(residentCount) .. " RESIDENTS" end
        if guestBadge then guestBadge.Text = tostring(guestCount) .. " GUESTS" end
    end

    local function renderDJRoster(packet)
        if not rosterScroll then return end

        local sourcePacket = packet or state.packet or {}
        local residentSource = first(sourcePacket, {"residentDJs", "ResidentDJs"}, nil)
        local guestSource = first(sourcePacket, {"sessionDJs", "SessionDJs"}, nil)

        local residents
        if type(residentSource) == "table" then
            residents = normalizeRoster(residentSource, "resident")
            lastResidentRoster = cloneRoster(residents)
        else
            residents = cloneRoster(lastResidentRoster)
        end

        local guests
        if type(guestSource) == "table" then
            guests = normalizeRoster(guestSource, "guest")
            lastGuestRoster = cloneRoster(guests)
        else
            guests = cloneRoster(lastGuestRoster)
        end




        if #residents == 0 and state.isDJ then
            residents[1] = {
                userId = player.UserId,
                username = player.Name,
                role = "resident",
            }
        end

        local signature = rosterSignature(residents, guests)
        updateRosterCount(#residents, #guests)
        if signature == lastRosterSignature then
            input:PrepareScroll(rosterScroll)
            return
        end
        lastRosterSignature = signature

        clearRosterCards()
        for _, data in ipairs(residents) do
            local card = createRosterCard(residentGrid, data.userId, data.username, true)
            if card then rosterCards[#rosterCards + 1] = card end
        end
        for _, data in ipairs(guests) do
            local card = createRosterCard(guestGrid, data.userId, data.username, false)
            if card then rosterCards[#rosterCards + 1] = card end
        end

        if residentGrid then residentGrid.AutomaticSize = Enum.AutomaticSize.Y end
        if guestGrid then guestGrid.AutomaticSize = Enum.AutomaticSize.Y end
        rosterScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        input:PrepareScroll(rosterScroll)
    end

    local api = {}

    function api:Apply(packet)
        updateManageSongCollections()
        renderCustomSongs(packet)
        renderDJRoster(packet)
        input:PreparePage(pageManageSong)
        input:PreparePage(pageManageDJs)
    end

    return api
end

return Module
]]></ProtectedString>
								<string name="ScriptGuid">{CA4B1D28-C5DD-4338-BC9F-E43A3D121E8C}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">LKJHGFDSAQPO</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">0</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
						</Item>
